local function getRegionNames()
    local list = {"الكل"}
    local mobsContainer = Workspace:FindFirstChild("Mobs")
    if mobsContainer then
        for _, child in ipairs(mobsContainer:GetChildren()) do
            table.insert(list, child.Name)
        end
    end
    return list
end

local function updateRegionUI()
    local names = getRegionNames()
    if regionIndex > #names then regionIndex = 1 end
    if regionIndex < 1 then regionIndex = #names end
    selectedRegionName = names[regionIndex]
    vR.Text = selectedRegionName
    isWaitingForSpawn = true
end

mR.MouseButton1Click:Connect(function()
    regionIndex = regionIndex - 1
    updateRegionUI()
end)

pR.MouseButton1Click:Connect(function()
    regionIndex = regionIndex + 1
    updateRegionUI()
end)

