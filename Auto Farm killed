-- ========================
-- SMART Region Sort v2
-- ترتيب: أرقام فردية (1-9) → أرقام مزدوجة (10+) → نصوص بدون رقم
-- داخل كل فئة: ترتيب رقمي صحيح
-- ========================
local function parseRegionKey(name)
    -- استخرج أول رقم كامل من الاسم
    local numStr = name:match("(%d+%.?%d*)")
    if numStr then
        local n = tonumber(numStr)
        -- فئة 1: رقم فردي (1-9) → أولوية 1
        -- فئة 2: رقم مزدوج (10+) → أولوية 2
        local category = (n < 10) and 1 or 2
        return category, n, name
    end
    -- فئة 3: نص بدون رقم → أولوية 3، ترتيب أبجدي
    return 3, 0, name
end

local function smartRegionSort(a, b)
    local catA, numA, nameA = parseRegionKey(a)
    local catB, numB, nameB = parseRegionKey(b)

    if catA ~= catB then
        return catA < catB   -- فئة 1 قبل 2 قبل 3
    end
    if numA ~= numB then
        return numA < numB   -- ترتيب رقمي صحيح داخل نفس الفئة
    end
    return nameA < nameB     -- أبجدي كـ fallback
end

local function getSortedRegionNames()
    local list = {"الكل"}
    local mobsContainer = Workspace:FindFirstChild("Mobs")
    if mobsContainer then
        local raw = {}
        for _, child in ipairs(mobsContainer:GetChildren()) do
            table.insert(raw, child.Name)
        end
        table.sort(raw, smartRegionSort)
        for _, name in ipairs(raw) do
            table.insert(list, name)
        end
    end
    return list
end

local function updateRegionUI()
    local names = getSortedRegionNames()
    local total = #names
    if regionIndex > total then regionIndex = 1 end
    if regionIndex < 1    then regionIndex = total end
    selectedRegionName    = names[regionIndex]
    vR.Text               = selectedRegionName
    RegionIndexLabel.Text = regionIndex .. " / " .. total
    isWaitingForSpawn     = true
end

