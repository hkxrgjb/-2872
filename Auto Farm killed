local ByteNet   = RS:FindFirstChild("ByteNetReliable") or RS:WaitForChild("ByteNetReliable", 3)
local SWORD_BUF = buffer.fromstring("!\r\000YWI_k9-Sword1")

local function getRootPart()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
end

local maxSlotsCache = {}

local function getAliveMobs(folder)
    local t = {}
    for _, desc in ipairs(folder:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Health > 0 then
            local mobModel = desc.Parent
            if mobModel and mobModel:IsA("Model") then
                local hrp = mobModel:FindFirstChild("HumanoidRootPart") or mobModel.PrimaryPart
                if hrp then
                    table.insert(t, { hum = desc, hrp = hrp, model = mobModel })
                end
            end
        end
    end
    return t
end

local function getMaxMobSlots(folder)
    local currentCount = #folder:GetChildren()
    if not maxSlotsCache[folder.Name] or currentCount > maxSlotsCache[folder.Name] then
        maxSlotsCache[folder.Name] = currentCount
    end
    return math.max(1, maxSlotsCache[folder.Name])
end

local function enableFloat()
    local root = getRootPart()
    if not root then return end
    root.Anchored = false
    
    local bv = root:FindFirstChild("FarmVelocity")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = root
    end
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = false
        hum.PlatformStand = true
    end
end

local function disableFloat()
    local root = getRootPart()
    if root then
        root.Anchored = false
        local bv = root:FindFirstChild("FarmVelocity")
        if bv then bv:Destroy() end
    end
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
    end
end

local function disarmAndFreezeMob(mobData)
    pcall(function()
        if mobData.model and mobData.hrp and mobData.hrp.Parent then
            for _, child in ipairs(mobData.model:GetChildren()) do
                local nameLower = child.Name:lower()
                if child:IsA("Tool") or child:IsA("Accoutrement") or nameLower:find("sword") or nameLower:find("weapon") then
                    child:Destroy()
                elseif child:IsA("Script") or child:IsA("LocalScript") then
                    child.Disabled = true
                end
            end

            if mobData.hum then
                mobData.hum.PlatformStand = true
                mobData.hum.WalkSpeed = 0
                mobData.hum.JumpPower = 0
                mobData.hum.AutoRotate = false

                local animator = mobData.hum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        track:Stop()
                    end
                end
            end

            mobData.hrp.Size = Vector3.new(10, 10, 10)
            mobData.hrp.CanCollide = false
            mobData.hrp.CanTouch = true

            for _, part in ipairs(mobData.model:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    if part ~= mobData.hrp then
                        part.CanTouch = false
                    end
                elseif part:IsA("Script") or part:IsA("LocalScript") then
                    part.Disabled = true
                end
            end
        end
    end)
end

-- ========================
-- FARM LOOP
-- ========================

local isRunning  = false
local farmTask   = nil
local attackTask = nil

local function stopFarm()
    isRunning = false
    canAttackNow = false
    isWaitingForSpawn = true
    if farmTask   then task.cancel(farmTask)   farmTask   = nil end
    if attackTask then task.cancel(attackTask) attackTask = nil end
    
    disableFloat()

    local root = getRootPart()
    if savedCFrame and root and root.Parent then
        root.CFrame = savedCFrame
        savedCFrame = nil
    end

    ToggleBtn.Text             = "الفارم والتجميع: معطل ❌"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(220,50,50)
    InfoLabel.Text             = "المنطقة: --  |  الأعداء: --"
end

CloseBtn.MouseButton1Click:Connect(function()
    stopFarm()
    ScreenGui:Destroy()
end)

ToggleBtn.MouseButton1Click:Connect(function()
    if isRunning then stopFarm() return end

    local root = getRootPart()
    if root then savedCFrame = root.CFrame end

    isRunning = true
    isWaitingForSpawn = true
    ToggleBtn.Text             = "الفارم والتجميع: شغال ✅"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50,200,50)
    
    enableFloat()

    attackTask = task.spawn(function()
        while isRunning do
            if canAttackNow then
                pcall(function()
                    if ByteNet then
                        ByteNet:FireServer(SWORD_BUF)
                    end
                end)
            end
            task.wait(attackInterval)
        end
    end)

    farmTask = task.spawn(function()
        local emptyTimer = 0
        local lastRegionName = nil
        local lockedPos = nil

        while isRunning do
            local currentRoot = getRootPart()
            local mobsContainer = Workspace:FindFirstChild("Mobs")
            if not mobsContainer or not currentRoot or not currentRoot.Parent then
                task.wait(0.1)
                continue
            end

            local allRegions = mobsContainer:GetChildren()
            if #allRegions == 0 then
                task.wait(0.1)
                continue
            end

            local targetRegion = nil
            if selectedRegionName == "الكل" then
                if autoIndex > #allRegions then autoIndex = 1 end
                targetRegion = allRegions[autoIndex]
            else
                targetRegion = mobsContainer:FindFirstChild(selectedRegionName)
            end

            if not targetRegion then
                task.wait(0.1)
                continue
            end

            -- [نظام القفل الثابت]: حفظ إحداثيات المنطقة مرة واحدة فقط عند الانتقال إليها وعدم تحديثها نهائياً
            if targetRegion.Name ~= lastRegionName then
                lastRegionName = targetRegion.Name
                lockedPos = nil
                
                for _, desc in ipairs(targetRegion:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        lockedPos = desc.Position
                        break
                    end
                end
                
                if not lockedPos then
                    local alive = getAliveMobs(targetRegion)
                    if #alive > 0 then
                        lockedPos = alive[1].hrp.Position
                    end
                end
            end

            if not lockedPos then
                local alive = getAliveMobs(targetRegion)
                if #alive > 0 then
                    lockedPos = alive[1].hrp.Position
                else
                    InfoLabel.Text = targetRegion.Name .. "  |  ⚠️ بانتظار ظهور أول عدو لتثبيت الإحداثيات"
                    task.wait(0.1)
                    continue
                end
            end

            local alive    = getAliveMobs(targetRegion)
            local maxSlots = getMaxMobSlots(targetRegion)

            if #alive == 0 then
                isWaitingForSpawn = true
            end

            if isWaitingForSpawn and #alive >= maxSlots and #alive > 0 then
                isWaitingForSpawn = false
            end

            canAttackNow = not (enableHighWait and isWaitingForSpawn)

            -- تحديد الارتفاع الثابت وعدم تعديل مكان اللاعب نهائياً طالما في نفس المنطقة
            local targetHeightOffset = canAttackNow and currentHeight or (currentHeight + 35)
            local fixedCF = CFrame.new(lockedPos + Vector3.new(0, targetHeightOffset, 0)) * CFrame.Angles(-math.rad(89.9), 0, 0)

            currentRoot.CFrame = fixedCF
            currentRoot.AssemblyLinearVelocity = Vector3.zero
            currentRoot.AssemblyAngularVelocity = Vector3.zero

            if canAttackNow then
                if #alive > 0 then
                    for _, mobData in ipairs(alive) do
                        disarmAndFreezeMob(mobData)
                        
                        -- جلب الأعداء نحو موقعك الثابت حصرياً بناءً على مسافة الجلب
                        local targetBringCF = currentRoot.CFrame * CFrame.new(0, 0, -bringDistance)
                        mobData.model:PivotTo(targetBringCF)
                        mobData.hrp.CFrame = targetBringCF
                        mobData.hrp.AssemblyLinearVelocity = Vector3.zero
                        mobData.hrp.AssemblyAngularVelocity = Vector3.zero
                    end

                    InfoLabel.Text = targetRegion.Name .. "  |  ثابت تماماً وجلب " .. #alive .. " عدو ⚔️"
                    emptyTimer = 0
                else
                    InfoLabel.Text = targetRegion.Name .. "  |  (بانتظار رسبونة الوحوش - ثابت)"
                end
            else
                InfoLabel.Text = targetRegion.Name .. "  |  صعود ثابت للانتظار (" .. #alive .. "/" .. maxSlots .. ") ☁️"
            end

            if selectedRegionName == "الكل" then
                if #alive == 0 then
                    emptyTimer = emptyTimer + 0.1
                    if emptyTimer >= 3.0 then
                        autoIndex = autoIndex + 1
                        isWaitingForSpawn = true
                        emptyTimer = 0
                    end
                end
            end

            task.wait(0.05)
        end
    end)
end)
