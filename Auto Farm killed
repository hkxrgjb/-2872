-- ========================
-- Advanced Position Search System
-- ========================

local regionPositionsCache = {}

local function getAliveMobs(folder)
    local t = {}
    for _, desc in ipairs(folder:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Health > 0 then
            local mobModel = desc.Parent
            if mobModel and mobModel:IsA("Model") then
                local hrp = mobModel:FindFirstChild("HumanoidRootPart") or mobModel.PrimaryPart
                if hrp then
                    table.insert(t, { hum = desc, hrp = hrp })
                end
            end
        end
    end
    return t
end

-- كاشف الإحداثيات المتطور والبحث الشامل
local function getRegionPosition(folder)
    local regionName = folder.Name

    -- 1. الذاكرة المؤقتة (إذا تم اكتشاف الموقع سابقاً)
    if regionPositionsCache[regionName] then
        return regionPositionsCache[regionName]
    end

    -- 2. إذا كان هنالك وحوش حية داخل المجلد
    local alive = getAliveMobs(folder)
    if #alive > 0 then
        local sumPos = Vector3.new(0, 0, 0)
        for _, data in ipairs(alive) do
            sumPos = sumPos + data.hrp.Position
        end
        local pos = sumPos / #alive
        regionPositionsCache[regionName] = pos
        return pos
    end

    -- 3. البحث داخل مجلد المنطقة عن أي أجزاء أو أهداف
    for _, desc in ipairs(folder:GetDescendants()) do
        if desc:IsA("BasePart") then
            regionPositionsCache[regionName] = desc.Position
            return desc.Position
        elseif desc:IsA("Attachment") then
            regionPositionsCache[regionName] = desc.WorldPosition
            return desc.WorldPosition
        end
    end

    if folder:IsA("Model") then
        local pivot = folder:GetPivot().Position
        if pivot ~= Vector3.zero then
            regionPositionsCache[regionName] = pivot
            return pivot
        end
    end

    -- 4. البحث في أرجاء الخريطة كاملة (Workspace) عن أجزاء تحمل نفس اسم المنطقة
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == regionName then
            if obj:IsA("BasePart") then
                regionPositionsCache[regionName] = obj.Position
                return obj.Position
            elseif obj:IsA("Model") then
                local p = obj:GetPivot().Position
                if p ~= Vector3.zero then
                    regionPositionsCache[regionName] = p
                    return p
                end
            end
        end
    end

    -- 5. فحص الخصائص المخبأة (Attributes)
    local attrPos = folder:GetAttribute("Position") or folder:GetAttribute("Pos") or folder:GetAttribute("CFrame")
    if attrPos then
        local pos = (typeof(attrPos) == "CFrame") and attrPos.Position or attrPos
        if typeof(pos) == "Vector3" then
            regionPositionsCache[regionName] = pos
            return pos
        end
    end

    return nil
end

local function enableFloat()
    if not RootPart then return end
    RootPart.Anchored = false
    
    local bv = RootPart:FindFirstChild("FarmVelocity")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = RootPart
    end
    
    local hum = Character and Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = false
        hum.PlatformStand = true
    end
end

local function disableFloat()
    if RootPart then
        RootPart.Anchored = false
        local bv = RootPart:FindFirstChild("FarmVelocity")
        if bv then bv:Destroy() end
    end
    
    local hum = Character and Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
    end
end

-- ========================
-- Farm Loop
-- ========================

local isRunning  = false
local farmTask   = nil
local attackTask = nil

local function stopFarm()
    isRunning = false
    if farmTask   then task.cancel(farmTask)   farmTask   = nil end
    if attackTask then task.cancel(attackTask) attackTask = nil end
    disableFloat()
    ToggleBtn.Text             = "الفارم: معطل ❌"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(220,50,50)
    InfoLabel.Text             = "المنطقة: --  |  الأعداء: --"
end

CloseBtn.MouseButton1Click:Connect(function()
    stopFarm()
    ScreenGui:Destroy()
end)

ToggleBtn.MouseButton1Click:Connect(function()
    if isRunning then stopFarm() return end

    isRunning = true
    ToggleBtn.Text             = "الفارم: شغال ✅"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50,200,50)
    
    enableFloat()

    attackTask = task.spawn(function()
        while isRunning do
            pcall(function()
                ByteNet:FireServer(SWORD_BUF)
            end)
            task.wait(attackInterval)
        end
    end)

    farmTask = task.spawn(function()
        local autoIndex = 1
        local emptyTimer = 0

        while isRunning do
            local mobsContainer = Workspace:FindFirstChild("Mobs")
            if not mobsContainer or not RootPart or not RootPart.Parent then
                task.wait(0.1)
                continue
            end

            local allRegions = mobsContainer:GetChildren()
            if #allRegions == 0 then
                task.wait(0.1)
                continue
            end

            local targetRegion = nil
            if selectedRegionName == "الكل" then
                if autoIndex > #allRegions then autoIndex = 1 end
                targetRegion = allRegions[autoIndex]
            else
                targetRegion = mobsContainer:FindFirstChild(selectedRegionName)
            end

            if not targetRegion then
                task.wait(0.1)
                continue
            end

            local regionPos = getRegionPosition(targetRegion)
            local alive     = getAliveMobs(targetRegion)

            -- عملية النقل الإجباري إذا توفرت الإحداثيات
            if regionPos and RootPart and RootPart.Parent then
                local playerPos = regionPos + Vector3.new(0, currentHeight, 0)
                RootPart.CFrame = CFrame.new(playerPos) * CFrame.Angles(-math.rad(89.9), 0, 0)
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero

                task.spawn(function()
                    pcall(function()
                        LocalPlayer:RequestStreamAroundAsync(regionPos, 1)
                    end)
                end)

                if #alive > 0 then
                    InfoLabel.Text = targetRegion.Name .. "  |  " .. #alive .. " عدو"
                    emptyTimer = 0
                else
                    InfoLabel.Text = targetRegion.Name .. "  |  (في الموقع - بانتظار الوحوش)"
                end
            else
                -- تنبيه واضح إن كانت المنطقة مجرد مجلد اسمي بدون أي مجسمات مرسبة إطلاقاً
                InfoLabel.Text = targetRegion.Name .. "  |  ⚠️ يتطلب ظهور وحش لمرة واحدة لحفظ الموقع"
            end

            -- التنقل التلقائي في وضع الكل
            if selectedRegionName == "الكل" then
                if #alive == 0 then
                    emptyTimer = emptyTimer + 0.1
                    if emptyTimer >= 3.0 then -- الانتظار 3 ثواني فوق المنطقة الفارغة قبل التبديل
                        autoIndex = autoIndex + 1
                        emptyTimer = 0
                    end
                end
            end

            task.wait(0.05)
        end
    end)
end)
