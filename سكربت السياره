local DELETE_UNDERGROUND_DEPTH = 800

local function restoreTempSeats(list)
    for _, d in ipairs(list or {}) do
        if d.seat and d.seat.Parent == seatHolder then
            pcall(function()
                d.seat.Parent = d.par
            end)
        end
    end
end

local function forceExitSeat(hm, root)
    if not hm then
        return
    end

    local seat = hm.SeatPart

    if seat then
        for _, obj in ipairs(seat:GetChildren()) do
            if obj.Name == "SeatWeld" then
                pcall(function()
                    obj:Destroy()
                end)
            end
        end
    end

    if root then
        for _, obj in ipairs(root:GetChildren()) do
            if obj.Name == "SeatWeld" then
                pcall(function()
                    obj:Destroy()
                end)
            end
        end
    end

    task.wait(0.05)

    if hm.SeatPart then
        pcall(function()
            hm.Sit = false
        end)

        task.wait(0.05)
    end
end

local function transferCarUsingQueueMechanism(car, targetCF, includeItems)
    if not car or not car.Parent or not targetCF then
        return false, "Invalid car/target"
    end

    local ch = LP.Character
    local hm = ch and ch:FindFirstChildOfClass("Humanoid")
    local root = ch and ch:FindFirstChild("HumanoidRootPart")

    if not hm then
        return false, "No Humanoid"
    end

    local st = car:FindFirstChild("DriveSeat") or car:FindFirstChildWhichIsA("VehicleSeat")

    if not st or not st.Parent then
        return false, "No valid seat"
    end

    local originalSeatParent = st.Parent
    local hiddenSeats = {}
    local success, lastErr = false, nil

    for _ = 1, 3 do
        hiddenSeats = {}

        local ok, err = pcall(function()
            for _, v in ipairs(car:GetDescendants()) do
                if v:IsA("VehicleSeat") and v ~= st and v.Parent ~= seatHolder then
                    table.insert(hiddenSeats, {seat = v, par = v.Parent})
                    v.Parent = seatHolder
                end
            end

            if not st.Parent then
                error("Seat disappeared")
            end

            st:Sit(hm)

            local waitSit = 0
            local sitLimit = S.turboTransfer and 0.7 or 1.4

            while waitSit < sitLimit do
                task.wait(0.03)
                waitSit += 0.03

                if hm.SeatPart == st then
                    break
                end
            end

            if hm.SeatPart ~= st then
                error("Failed to sit")
            end

            local moved = prepareAndTeleport(car, targetCF, {}, includeItems)

            if not moved then
                error("Car transfer failed")
            end

            if st and st.Parent then
                st.Parent = seatHolder
                table.insert(hiddenSeats, {seat = st, par = originalSeatParent})
            end

            root = ch and ch:FindFirstChild("HumanoidRootPart")
            forceExitSeat(hm, root)

            local exitWait = 0
            local exitLimit = S.turboTransfer and 0.35 or 0.8

            while exitWait < exitLimit do
                task.wait(0.03)
                exitWait += 0.03

                if not hm.SeatPart then
                    break
                end
            end

            if hm.SeatPart then
                pcall(function()
                    hm.Sit = false
                end)

                task.wait(0.05)
            end

            return true
        end)

        if ok then
            success = true
            break
        end

        lastErr = err
        restoreTempSeats(hiddenSeats)
        task.wait(0.12)
    end

    restoreTempSeats(hiddenSeats)

    return success, lastErr
end

local function smartDeleteCar(car, speedLbl, onDone)
    if not car or not car.Parent then
        if onDone then
            onDone(false)
        end

        return
    end

    if speedLbl and speedLbl.Parent then
        speedLbl.Text = "0 ⬇"
    end

    local pivot = car:GetPivot()

    local undergroundCF = CFrame.new(
        pivot.Position.X,
        pivot.Position.Y - DELETE_UNDERGROUND_DEPTH,
        pivot.Position.Z
    ) * pivot.Rotation

    local includeItems = not Cfg.DeleteCarOnly
    local moved, err = transferCarUsingQueueMechanism(car, undergroundCF, includeItems)

    if not moved and err then
        warn("Smart delete failed: " .. tostring(err))
    end

    if speedLbl and speedLbl.Parent then
        speedLbl.Text = moved and "✓ ⬇" or "✕"
    end

    if onDone then
        onDone(moved)
    end
end

local function smartDeleteSelectedCars(speedLbl, onFinish)
    if #S.selCars == 0 or S.deleteRunning then
        return
    end

    S.deleteRunning = true
    stopLivePreview()

    local toDelete = {table.unpack(S.selCars)}
    resetSelectionState()

    local idx = 0

    local function doNext()
        idx += 1

        if idx > #toDelete then
            S.deleteRunning = false

            if onFinish then
                onFinish()
            end

            return
        end

        local car = toDelete[idx]

        if not car or not car.Parent then
            doNext()
            return
        end

        smartDeleteCar(car, speedLbl, function()
            task.wait(getDeleteDelay())
            doNext()
        end)
    end

    doNext()
end

