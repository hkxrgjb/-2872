local function getNearbyCars(centerCar)
    local pos = centerCar:GetPivot().Position

    local seen, res = {}, {}

    for _, p in ipairs(workspace:GetPartBoundsInRadius(pos, 250)) do
        local car = findCar(p)

        if car and car:FindFirstChild("DriveSeat") and not seen[car] then
            seen[car] = true
            res[#res + 1] = car
        end
    end

    return res
end

trackGlobal(UIS.InputBegan:Connect(function(inp, gp)
    if gp then
        return
    end

    if S.isDragging then
        return
    end

    if not S.selectMode and not S.selectAll then
        return
    end

    if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local cam = workspace.CurrentCamera
    local ray = cam:ScreenPointToRay(inp.Position.X, inp.Position.Y)

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {
        LP.Character,
        ghostFolder,
        selectionFolder,
        espFolder,
        seatHolder,
        globalSeatFolder,
    }

    local res = workspace:Raycast(ray.Origin, ray.Direction * 600, rp)

    if not res then
        return
    end

    local carModel = findCar(res.Instance)

    if not carModel then
        return
    end

    if S.selectAll then
        local nearby = getNearbyCars(carModel)

        local allSel = true

        for _, c in ipairs(nearby) do
            if not S.selSeats[c] then
                allSel = false
                break
            end
        end

        if allSel then
            for _, c in ipairs(nearby) do
                for i, x in ipairs(S.selCars) do
                    if x == c then
                        table.remove(S.selCars, i)
                        break
                    end
                end

                selUnhighlight(c)
                S.selSeats[c] = nil
            end
        else
            for _, c in ipairs(nearby) do
                if not S.selSeats[c] then
                    S.selCars[#S.selCars + 1] = c

                    selHighlight(c)
                    S.selSeats[c] = getSeat(c)
                end
            end
        end

        refreshGhostPreview()

        return
    end

    if not S.selectMode then
        return
    end

    local ds = getSeat(carModel)

    if not ds then
        return
    end

    local found = false

    for i, c in ipairs(S.selCars) do
        if c == carModel then
            table.remove(S.selCars, i)

            selUnhighlight(carModel)
            S.selSeats[carModel] = nil

            found = true

            break
        end
    end

    if not found then
        S.selCars[#S.selCars + 1] = carModel

        selHighlight(carModel)
        S.selSeats[carModel] = ds
    end

    refreshGhostPreview()
end))

