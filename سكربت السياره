local function findCar(inst)
    local c = inst

    while c do
        if c:IsA("Model") and c:FindFirstChild("DriveSeat") then
            return c
        end

        c = c.Parent
    end

    return nil
end

local function isOtherCar(part, mine)
    local c = findCar(part)
    return c ~= nil and c ~= mine
end

local function isUtilityHit(hit)
    if not hit then
        return false
    end

    if hit:GetAttribute("CarHubSelection") then
        return true
    end

    if hit.Name == "SelectionPart" or hit.Name == "CarHubSelectionPart" then
        return true
    end

    if hit.Parent then
        if selectionFolder and hit:IsDescendantOf(selectionFolder) then
            return true
        end

        if ghostFolder and hit:IsDescendantOf(ghostFolder) then
            return true
        end

        if espFolder and hit:IsDescendantOf(espFolder) then
            return true
        end

        if seatHolder and hit:IsDescendantOf(seatHolder) then
            return true
        end

        if globalSeatFolder and hit:IsDescendantOf(globalSeatFolder) then
            return true
        end
    end

    return false
end

local function getGroundY(pos, ignoreCar)
    local baseFilter = {}

    for _, f in ipairs({ghostFolder, espFolder, seatHolder, globalSeatFolder, selectionFolder}) do
        if f then
            table.insert(baseFilter, f)
        end
    end

    if LP.Character then
        table.insert(baseFilter, LP.Character)
    end

    if ignoreCar and ignoreCar.Parent then
        table.insert(baseFilter, ignoreCar)
    end

    for _, c in ipairs(S.selCars) do
        if c and c.Parent then
            table.insert(baseFilter, c)
        end
    end

    if S.car and S.car.Parent then
        table.insert(baseFilter, S.car)
    end

    local extraFilter = {}

    for _ = 1, 8 do
        local filter = {}

        for _, v in ipairs(baseFilter) do
            table.insert(filter, v)
        end

        for _, v in ipairs(extraFilter) do
            table.insert(filter, v)
        end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = filter

        local result = workspace:Raycast(
            pos + Vector3.new(0, 80, 0),
            Vector3.new(0, -150, 0),
            rayParams
        )

        if not result then
            return 0
        end

        local hit = result.Instance

        if not hit then
            return result.Position.Y
        end

        if isUtilityHit(hit) then
            table.insert(extraFilter, hit)
            continue
        end

        local hitCar = findCar(hit)

        if hitCar then
            table.insert(extraFilter, hitCar)
            continue
        end

        if hit:IsA("BasePart") and not hit.Anchored then
            table.insert(extraFilter, hit)
            continue
        end

        return result.Position.Y
    end

    return 0
end

local function getCarPivotToLowestOffset(car)
    if not car or not car.Parent then
        return 5
    end

    local pivotY = car:GetPivot().Position.Y
    local lowestY = math.huge

    for _, p in ipairs(car:GetDescendants()) do
        if p:IsA("BasePart") then
            local bottom = p.Position.Y - p.Size.Y * 0.5

            if bottom < lowestY then
                lowestY = bottom
            end
        end
    end

    if lowestY == math.huge then
        return 5
    end

    return pivotY - lowestY
end

local function getBoundsNoMotor(car)
    local drivenParts = {}

    for _, obj in ipairs(car:GetDescendants()) do
        if obj:IsA("Motor6D") then
            if obj.Part0 then
                drivenParts[obj.Part0] = true

                for _, d in ipairs(obj.Part0:GetDescendants()) do
                    if d:IsA("BasePart") then
                        drivenParts[d] = true
                    end
                end
            end

            if obj.Part1 then
                drivenParts[obj.Part1] = true

                for _, d in ipairs(obj.Part1:GetDescendants()) do
                    if d:IsA("BasePart") then
                        drivenParts[d] = true
                    end
                end
            end
        elseif obj:IsA("HingeConstraint") or obj:IsA("SpringConstraint") or obj:IsA("PrismaticConstraint") then
            if obj.Attachment0 and obj.Attachment0.Parent and obj.Attachment0.Parent:IsA("BasePart") then
                drivenParts[obj.Attachment0.Parent] = true
            end

            if obj.Attachment1 and obj.Attachment1.Parent and obj.Attachment1.Parent:IsA("BasePart") then
                drivenParts[obj.Attachment1.Parent] = true
            end
        end
    end

    local ref = car.PrimaryPart

    if not (ref and ref:IsA("BasePart")) then
        for _, v in ipairs(car:GetDescendants()) do
            if v:IsA("BasePart") and not drivenParts[v] then
                ref = v
                break
            end
        end
    end

    if not ref then
        return nil, nil
    end

    local cf = ref.CFrame
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)

    for _, p in ipairs(car:GetDescendants()) do
        if p:IsA("BasePart") and not drivenParts[p] then
            local rc = cf:ToObjectSpace(p.CFrame)
            local h = p.Size * 0.5

            for sx = -1, 1, 2 do
                for sy = -1, 1, 2 do
                    for sz = -1, 1, 2 do
                        local pt = (rc * CFrame.new(sx * h.X, sy * h.Y, sz * h.Z)).Position

                        mn = Vector3.new(
                            math.min(mn.X, pt.X),
                            math.min(mn.Y, pt.Y),
                            math.min(mn.Z, pt.Z)
                        )

                        mx = Vector3.new(
                            math.max(mx.X, pt.X),
                            math.max(mx.Y, pt.Y),
                            math.max(mx.Z, pt.Z)
                        )
                    end
                end
            end
        end
    end

    if mn.X == math.huge or mx.X == -math.huge then
        return nil, nil
    end

    mn = mn - Vector3.new(PAD.L, PAD.Bo, PAD.F)
    mx = mx + Vector3.new(PAD.R, PAD.T, PAD.Ba)

    local sz = mx - mn

    if sz.X <= 0 or sz.Y <= 0 or sz.Z <= 0 then
        return nil, nil
    end

    return CFrame.new(cf:PointToWorldSpace((mn + mx) * 0.5)) * cf.Rotation, sz
end

local function getItems(car, prim)
    if not prim then
        return {}
    end

    local dcf, dsz = getBoundsNoMotor(car)

    if not dcf then
        return {}
    end

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude

    local exclude = {
        car,
        ghostFolder,
        espFolder,
        seatHolder,
        globalSeatFolder,
        selectionFolder,
    }

    if LP.Character then
        table.insert(exclude, LP.Character)
    end

    op.FilterDescendantsInstances = exclude

    local items = {}

    for _, p in ipairs(workspace:GetPartBoundsInBox(dcf, dsz, op)) do
        if p:IsA("BasePart")
            and not p.Anchored
            and not isOtherCar(p, car)
            and not p:IsDescendantOf(selectionFolder)
            and not p:GetAttribute("CarHubSelection")
        then
            items[#items + 1] = {
                part = p,
                off = prim.CFrame:Inverse() * p.CFrame,
                anchored = p.Anchored,
            }

            p.Anchored = true
        end
    end

    return items
end

local function closeDoorLeft(car)
    pcall(function()
        local paintParts = car:FindFirstChild("PaintParts")
        if not paintParts then return end

        local doorLeft = paintParts:FindFirstChild("DoorLeft")
        if not doorLeft then return end

        local hinge = doorLeft:FindFirstChild("ButtonRemote_Hinge")
        if not hinge then return end

        local rs = game:GetService("ReplicatedStorage")
        local interaction = rs:FindFirstChild("Interaction")
        local remote = interaction and interaction:FindFirstChild("RemoteProxy")

        if remote then
            remote:FireServer(hinge)
        end
    end)

    pcall(function()
        for _, desc in ipairs(car:GetDescendants()) do
            if desc.Name == "ButtonRemote_Hinge" then
                local rs = game:GetService("ReplicatedStorage")
                local interaction = rs:FindFirstChild("Interaction")
                local remote = interaction and interaction:FindFirstChild("RemoteProxy")

                if remote then
                    remote:FireServer(desc)
                end
            end
        end
    end)
end

local function prepareAndTeleport(car, targetCF, otherCars, includeItems)
    if includeItems == nil then
        includeItems = true
    end

    local primary = car.PrimaryPart
        or car:FindFirstChild("DriveSeat")
        or car:FindFirstChildWhichIsA("VehicleSeat")

    if not primary then
        return false
    end

    closeDoorLeft(car)

    local itemData = includeItems and getItems(car, primary) or {}

    for _, data in ipairs(itemData) do
        if data.part and data.part.Parent then
            data.part.CanCollide = false
        end
    end

    local welds = {}

    for _, data in ipairs(itemData) do
        if data.part and data.part.Parent then
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = data.part
            weld.Part1 = primary
            weld.Parent = data.part
            welds[#welds + 1] = weld
        end
    end

    local partsData = {}

    for _, p in ipairs(car:GetDescendants()) do
        if p:IsA("BasePart") then
            table.insert(partsData, {
                part = p,
                anchored = p.Anchored,
                cancollide = p.CanCollide,
            })

            p.Anchored = true
            p.CanCollide = false
        end
    end

    local otherStates = {}

    for _, c in ipairs(otherCars or {}) do
        if c ~= car and c and c.Parent then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    table.insert(otherStates, {
                        part = p,
                        anchored = p.Anchored,
                    })

                    p.Anchored = true
                end
            end
        end
    end

    car:PivotTo(targetCF)

    for _, weld in ipairs(welds) do
        pcall(function()
            weld:Destroy()
        end)
    end

    if primary and primary.Parent then
        for _, data in ipairs(itemData) do
            if data.part and data.part.Parent then
                data.part.CFrame = primary.CFrame * data.off
                data.part.AssemblyLinearVelocity = Vector3.zero
                data.part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    for _, d in ipairs(partsData) do
        if d.part and d.part.Parent then
            d.part.Anchored = d.anchored
            d.part.CanCollide = d.cancollide
            d.part.AssemblyLinearVelocity = Vector3.zero
            d.part.AssemblyAngularVelocity = Vector3.zero
        end
    end

    for _, data in ipairs(itemData) do
        if data.part and data.part.Parent then
            data.part.Anchored = data.anchored
            data.part.CanCollide = true
        end
    end

    for _, d in ipairs(otherStates) do
        if d.part and d.part.Parent then
            d.part.Anchored = d.anchored
        end
    end

    return true
end

----------------------------------------------------------------
-- Slot calculation — side mode removed
----------------------------------------------------------------
local function computeSlotCF(index, car, overrideLocation)
    local baseLoc = overrideLocation or S.autoLocation

    if not baseLoc then
        return nil
    end

    local col = index % Cfg.CarsPerRow
    local row = math.floor(index / Cfg.CarsPerRow)

    local basePos = baseLoc.Position
    local fwd = baseLoc.LookVector
    local rgt = baseLoc.RightVector

    local posXZ = basePos
        + rgt * (col * Cfg.SlotWidth)
        + fwd * (-row * Cfg.RowSpacing * Cfg.RowDir)

    local groundY = getGroundY(posXZ, car)
    local heightOff = car and getCarPivotToLowestOffset(car) or 5
    local finalY = groundY + heightOff + Cfg.ManualLiftOffset
    local finalPos = Vector3.new(posXZ.X, finalY, posXZ.Z)

    if Cfg.CarFacing == -1 then
        return CFrame.lookAt(finalPos, finalPos - fwd)
    else
        return CFrame.lookAt(finalPos, finalPos + fwd)
    end
end

local function getSlotCF(car)
    if not S.autoLocation then
        return nil
    end

    if not S.carSlots[car] then
        local maxSlot = -1

        for _, slot in pairs(S.carSlots) do
            if slot > maxSlot then
                maxSlot = slot
            end
        end

        S.carSlots[car] = maxSlot + 1
    end

    return computeSlotCF(S.carSlots[car], car)
end

local function getPreviewSlotCF(car, tempIndex, overrideLocation)
    return computeSlotCF(tempIndex, car, overrideLocation)
end

local function getEffectiveQueueDelay()
    if S.turboTransfer then
        return math.max(0.01, Cfg.TurboDelay or 0.01)
    end

    return math.max(0.03, Cfg.QueueDelay)
end

local function getDeleteDelay()
    if S.turboTransfer then
        return 0.01
    end

    local d = 15 / math.clamp(Cfg.DeleteSpeed, 10, 500)
    return math.clamp(d, 0.03, 5)
end

