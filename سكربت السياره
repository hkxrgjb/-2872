local function createGhostClone(car, idx)
    local originalPrimary = nil

    if car.PrimaryPart and car.PrimaryPart:IsA("BasePart") then
        originalPrimary = car.PrimaryPart
    end

    if originalPrimary then
        pcall(function()
            originalPrimary:SetAttribute("CarHubGhostPrimary", true)
        end)
    end

    local clone = car:Clone()

    if originalPrimary then
        pcall(function()
            originalPrimary:SetAttribute("CarHubGhostPrimary", nil)
        end)
    end

    if not clone then
        return nil
    end

    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.Transparency = 0.45
            obj.CastShadow = false
        elseif obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            obj:Destroy()
        elseif obj:IsA("Humanoid")
            or obj:IsA("BodyVelocity")
            or obj:IsA("BodyForce")
            or obj:IsA("BodyThrust")
            or obj:IsA("BodyGyro")
            or obj:IsA("BodyAngularVelocity")
            or obj:IsA("RocketPropulsion")
            or obj:IsA("Sound")
            or obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Fire")
            or obj:IsA("Smoke")
            or obj:IsA("Sparkles")
            or obj:IsA("Explosion")
        then
            obj:Destroy()
        end
    end

    local visualPrimary = nil

    if originalPrimary then
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") and d:GetAttribute("CarHubGhostPrimary") then
                visualPrimary = d
                break
            end
        end

        if not visualPrimary then
            local byName = clone:FindFirstChild(originalPrimary.Name, true)

            if byName and byName:IsA("BasePart") then
                visualPrimary = byName
            end
        end
    end

    if not visualPrimary then
        visualPrimary = clone:FindFirstChildWhichIsA("BasePart")
    end

    if not visualPrimary then
        return nil
    end

    pcall(function()
        visualPrimary:SetAttribute("CarHubGhostPrimary", nil)
    end)

    clone.PrimaryPart = visualPrimary

    local originalPivot = car:GetPivot()
    local clonePivot = clone:GetPivot()
    local correction = clonePivot:ToObjectSpace(originalPivot)

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 44, 0, 22)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.Adornee = visualPrimary
    bb.AlwaysOnTop = true
    bb.Parent = clone

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundColor3 = Color3.fromRGB(10, 6, 22)
    lbl.BackgroundTransparency = 0.2
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.Text = "#" .. idx

    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)

    return {
        clone = clone,
        correction = correction,
        car = car,
    }
end

local function clearGhosts()
    for _, rec in ipairs(S.ghostEntities) do
        if rec and rec.clone then
            pcall(function()
                rec.clone:Destroy()
            end)
        end
    end

    S.ghostEntities = {}
    S.ghostCars = {}

    ghostFolder:ClearAllChildren()

    S.ghostVisible = false
    S.ghostDirty = false
end

local function buildGhostEntities()
    for _, rec in ipairs(S.ghostEntities) do
        if rec and rec.clone then
            pcall(function()
                rec.clone:Destroy()
            end)
        end
    end

    S.ghostEntities = {}
    S.ghostCars = {}

    ghostFolder:ClearAllChildren()

    for idx, car in ipairs(S.selCars) do
        local ok, rec = pcall(createGhostClone, car, idx)

        if ok and rec and rec.clone then
            rec.clone.Parent = ghostFolder

            table.insert(S.ghostEntities, rec)
            table.insert(S.ghostCars, car)
        else
            table.insert(S.ghostEntities, false)
            table.insert(S.ghostCars, car)
        end
    end
end

local function updateGhostTransforms(loc)
    if not loc or #S.selCars == 0 then
        return
    end

    local needBuild = (#S.ghostEntities ~= #S.selCars)

    if not needBuild then
        for i = 1, #S.selCars do
            if S.ghostCars[i] ~= S.selCars[i] then
                needBuild = true
                break
            end
        end
    end

    if needBuild then
        buildGhostEntities()
    end

    for idx, car in ipairs(S.selCars) do
        local rec = S.ghostEntities[idx]

        if rec and rec.clone and rec.clone.Parent and rec.correction then
            local tcf = getPreviewSlotCF(car, idx - 1, loc)

            if tcf then
                pcall(function()
                    rec.clone:PivotTo(tcf * rec.correction:Inverse())
                end)
            end
        end
    end
end

local function placeGhosts(overrideLocation)
    local loc = overrideLocation or S.autoLocation

    if not loc or #S.selCars == 0 then
        return
    end

    S.ghostVisible = true
    updateGhostTransforms(loc)
    S.ghostDirty = false
end

local function stopLivePreview()
    if S.livePreviewConn then
        S.livePreviewConn:Disconnect()
        S.livePreviewConn = nil
    end

    S.livePreviewActive = false
    clearGhosts()
end

local function startLivePreview()
    if S.livePreviewConn then
        S.livePreviewConn:Disconnect()
        S.livePreviewConn = nil
    end

    clearGhosts()

    if not Cfg.LivePreview then
        return
    end

    if #S.selCars == 0 then
        return
    end

    S.livePreviewActive = true
    S.ghostVisible = true
    S.ghostDirty = true

    local ch = LP.Character
    local rt = ch and ch:FindFirstChild("HumanoidRootPart")

    if rt then
        S.lastLivePos = rt.Position
        S.lastLiveUpdate = tick()
        placeGhosts(rt.CFrame)
    end

    S.livePreviewConn = RunService.Heartbeat:Connect(function()
        if not Cfg.LivePreview then
            stopLivePreview()
            return
        end

        if S.queueRunning or S.deleteRunning then
            return
        end

        local character = LP.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")

        if not rootPart then
            return
        end

        local now = tick()
        local moved = (rootPart.Position - S.lastLivePos).Magnitude > 0.5
        local interval = 1

        if moved then
            interval = 0.1
            S.lastLivePos = rootPart.Position
            S.ghostDirty = true
        end

        if S.ghostDirty or now - S.lastLiveUpdate >= interval then
            if now - S.lastLiveUpdate >= interval or S.ghostDirty then
                S.lastLiveUpdate = now
                placeGhosts(rootPart.CFrame)
            end
        end
    end)
end

local function refreshGhostPreview()
    if S.queueRunning or S.deleteRunning then
        return
    end

    if #S.selCars == 0 then
        if S.ghostVisible then
            clearGhosts()
        end

        return
    end

    S.ghostDirty = true

    if Cfg.LivePreview then
        if not S.livePreviewActive then
            startLivePreview()
            return
        end

        S.ghostVisible = true

        local ch = LP.Character
        local rt = ch and ch:FindFirstChild("HumanoidRootPart")

        if rt then
            placeGhosts(rt.CFrame)
        end
    elseif S.ghostVisible then
        placeGhosts()
    end
end

local function toggleGhostPreview()
    if S.ghostVisible then
        stopLivePreview()
        return
    end

