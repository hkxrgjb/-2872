local function makeFolder(parent, name)
    local f = parent:FindFirstChild(name)

    if f and f:IsA("Folder") then
        return f
    end

    if f then
        pcall(function()
            f:Destroy()
        end)
    end

    local new = Instance.new("Folder")
    new.Name = name
    new.Parent = parent

    return new
end

for _, oldName in ipairs({"CarESP", "_CarFlyGhosts"}) do
    local old = workspace:FindFirstChild(oldName)

    if old then
        pcall(function()
            old:Destroy()
        end)
    end
end

