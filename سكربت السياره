        local function mkSlider(pg, label, yp, mn, mx, initVal, onChange, isFloat)
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -12, 0, 56)
            row.Position = UDim2.new(0, 6, 0, yp)
            row.BackgroundColor3 = C.bg3
            row.BorderSizePixel = 0
            row.ZIndex = 4
            row.Parent = pg

            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -74, 0, 18)
            lbl.Position = UDim2.new(0, 8, 0, 4)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = C.txtL
            lbl.Font = Enum.Font.GothamSemibold
            lbl.TextSize = 10
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 5
            lbl.Parent = row
            lbl.Text = label

            local valBox = Instance.new("TextBox")
            valBox.Size = UDim2.new(0, 62, 0, 18)
            valBox.Position = UDim2.new(1, -66, 0, 4)
            valBox.BackgroundColor3 = C.bg0
            valBox.BackgroundTransparency = 0
            valBox.TextColor3 = C.accGlow
            valBox.Font = Enum.Font.GothamBold
            valBox.TextSize = 11
            valBox.TextXAlignment = Enum.TextXAlignment.Right
            valBox.ZIndex = 5
            valBox.Parent = row
            valBox.ClearTextOnFocus = false
            valBox.BorderSizePixel = 0

            local currentVal = initVal

            local function formatVal(v)
                if isFloat then
                    return string.format("%.2f", v)
                else
                    return tostring(math.floor(v))
                end
            end

            valBox.Text = formatVal(initVal)

            Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 5)

            local valStroke = addGlow(valBox, C.sep, 1)

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, -16, 0, 7)
            track.Position = UDim2.new(0, 8, 0, 38)
            track.BackgroundColor3 = C.bg0
            track.BorderSizePixel = 0
            track.ZIndex = 5
            track.Parent = row

            Instance.new("UICorner", track).CornerRadius = UDim.new(0, 4)

            local pct = (initVal - mn) / (mx - mn)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(pct, 0, 1, 0)
            fill.BackgroundColor3 = C.acc
            fill.BorderSizePixel = 0
            fill.ZIndex = 6
            fill.Parent = track

            Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

            local fillShine = Instance.new("Frame")
            fillShine.Size = UDim2.new(1, 0, 0.5, 0)
            fillShine.Position = UDim2.new(0, 0, 0, 0)
            fillShine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            fillShine.BackgroundTransparency = 0.82
            fillShine.BorderSizePixel = 0
            fillShine.ZIndex = 7
            fillShine.Parent = fill

            Instance.new("UICorner", fillShine).CornerRadius = UDim.new(0, 4)

            local knob = Instance.new("TextButton")
            knob.Text = ""
            knob.Size = UDim2.new(0, 18, 0, 18)
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            knob.BackgroundColor3 = C.accGlow
            knob.BorderSizePixel = 0
            knob.AutoButtonColor = false
            knob.ZIndex = 8
            knob.Parent = track

            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            local knobStroke = Instance.new("UIStroke", knob)
            knobStroke.Color = C.accGlow
            knobStroke.Thickness = 2
            knobStroke.Transparency = 0.6

            local function applyValue(rx)
                rx = math.clamp(rx, 0, 1)

                local nv = mn + rx * (mx - mn)
                currentVal = nv

                tw(fill, {Size = UDim2.new(rx, 0, 1, 0)}, 0.08, Enum.EasingStyle.Quad)
                tw(knob, {Position = UDim2.new(rx, 0, 0.5, 0)}, 0.08, Enum.EasingStyle.Quad)

                valBox.Text = formatVal(nv)

                if onChange then
                    onChange(nv)
                end
            end

            local dragging = false

            knob.MouseButton1Down:Connect(function()
                dragging = true

                tw(knob, {Size = UDim2.new(0, 22, 0, 22)}, 0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                TweenService:Create(knobStroke, TweenInfo.new(0.12), {Transparency = 0.2}):Play()
            end)

            trackUI(UIS.InputChanged:Connect(function(inp)
                if not dragging then
                    return
                end

                if not track.Parent then
                    dragging = false
                    return
                end

                if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end

                local abs = track.AbsolutePosition
                local w = track.AbsoluteSize.X

                local rx = math.clamp((inp.Position.X - abs.X) / w, 0, 1)

                applyValue(rx)
            end))

            trackUI(UIS.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false

                        tw(knob, {Size = UDim2.new(0, 18, 0, 18)}, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                        TweenService:Create(knobStroke, TweenInfo.new(0.18), {Transparency = 0.6}):Play()
                    end
                end
            end))

            valBox.Focused:Connect(function()
                tw(valBox, {BackgroundColor3 = C.bg4}, 0.15)
                TweenService:Create(valStroke, TweenInfo.new(0.15), {Color = C.accGlow, Thickness = 1.5}):Play()
            end)

            valBox.FocusLost:Connect(function()
                tw(valBox, {BackgroundColor3 = C.bg0}, 0.2)
                TweenService:Create(valStroke, TweenInfo.new(0.2), {Color = C.sep, Thickness = 1}):Play()

                local num = tonumber(valBox.Text)

                if num then
                    num = math.clamp(num, mn, mx)

                    local rx = (num - mn) / (mx - mn)

                    applyValue(rx)
                else
                    valBox.Text = formatVal(currentVal)
                end
            end)

            track.MouseEnter:Connect(function()
                tw(track, {BackgroundColor3 = C.bg3}, 0.15)
            end)

            track.MouseLeave:Connect(function()
                tw(track, {BackgroundColor3 = C.bg0}, 0.2)
            end)

            return valBox
        end

        local function mkToggle(pg, txt, yp, initOn, onChange)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -12, 0, 34)
            frame.Position = UDim2.new(0, 6, 0, yp)
            frame.BackgroundColor3 = C.bg3
