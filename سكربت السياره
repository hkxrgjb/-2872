local function doAutoTp(car)
    if S.queueRunning or not S.autoLocation then
        return
    end

    S.queueRunning = true

    local ch = LP.Character
    local rt = ch and ch:FindFirstChild("HumanoidRootPart")
    local pre = rt and rt.CFrame

    local tcf = getSlotCF(car)

    if not tcf then
        S.queueRunning = false
        return
    end

    prepareAndTeleport(car, tcf, {}, true)

    local hs = {}

    for _, v in ipairs(car:GetDescendants()) do
        if v:IsA("VehicleSeat") then
            hs[#hs + 1] = {seat = v, par = v.Parent}
            v.Parent = seatHolder
        end
    end

    local hm = ch and ch:FindFirstChildOfClass("Humanoid")
    local root = ch and ch:FindFirstChild("HumanoidRootPart")

    if root and hm then
        if hm.SeatPart then
            for _, i in ipairs(hm.SeatPart:GetChildren()) do
                if i.Name == "SeatWeld" then
                    i:Destroy()
                end
            end
        end

        for _, i in ipairs(root:GetChildren()) do
            if i.Name == "SeatWeld" then
                i:Destroy()
            end
        end

        task.wait(0.05)

        if hm.SeatPart and root then
            root.CFrame = hm.SeatPart.CFrame * CFrame.new(0, 5, 3)
        end
    end

    local exitWait = 0

    while exitWait < 1 do
        task.wait(0.05)
        exitWait += 0.05

        if ch and ch:FindFirstChildOfClass("Humanoid") and not ch.Humanoid.SeatPart then
            break
        end
    end

    root = ch and ch:FindFirstChild("HumanoidRootPart")

    if root and pre then
        root.CFrame = pre
    end

    for _, d in ipairs(hs) do
        if d.seat and d.seat.Parent == seatHolder then
            d.seat.Parent = d.par
        end
    end

    S.queueRunning = false
end

local function processQueue(onDone)
    if S.queueRunning or not S.autoLocation or #S.selCars == 0 then
        if onDone then
            onDone(false)
        end

        return
    end

    S.queueRunning = true
    stopLivePreview()

    local ch = LP.Character
    local rt = ch and ch:FindFirstChild("HumanoidRootPart")
    local oCF = rt and rt.CFrame

    local queue = {table.unpack(S.selCars)}
    local qseats = {}

    for _, c in ipairs(queue) do
        qseats[c] = S.selSeats[c]
    end

    resetSelectionState()

    local allHS = {}
    local fast = S.turboTransfer or Cfg.QueueDelay <= 0.05

    for i, car in ipairs(queue) do
        if not car or not car.Parent then
            continue
        end

        local succeeded = false
        local lastErr = nil

        for _ = 1, 3 do
            local attemptHS = {}

            local ok, err = pcall(function()
                local st = qseats[car] or car:FindFirstChild("DriveSeat") or car:FindFirstChildWhichIsA("VehicleSeat")

                if not st or not st.Parent then
                    error("No valid seat")
                end

                local hm = ch and ch:FindFirstChildOfClass("Humanoid")

                if not hm then
                    error("No Humanoid")
                end

                for _, v in ipairs(car:GetDescendants()) do
                    if v:IsA("VehicleSeat") and v ~= st then
                        table.insert(attemptHS, {seat = v, par = v.Parent})
                        v.Parent = seatHolder
                    end
                end

                local root = ch and ch:FindFirstChild("HumanoidRootPart")

                if root and st.Parent then
                    if (root.Position - st.Position).Magnitude > 8 then
                        root.CFrame = st.CFrame * CFrame.new(0, 2.5, 0)
                    end
                end

                st:Sit(hm)

                local sitWait = 0
                local sitLimit = fast and 0.7 or 1.4

                while sitWait < sitLimit do
                    task.wait(0.03)
                    sitWait += 0.03

                    if hm.SeatPart == st then
                        break
                    end
                end

                if hm.SeatPart ~= st then
                    error("Failed to sit")
                end

                local tcf = computeSlotCF(i - 1, car)

                if tcf then
                    prepareAndTeleport(car, tcf, {}, true)
                end

                table.insert(attemptHS, {seat = st, par = st.Parent})
                st.Parent = seatHolder

                root = ch and ch:FindFirstChild("HumanoidRootPart")

                if root and hm.SeatPart then
                    for _, i2 in ipairs(hm.SeatPart:GetChildren()) do
                        if i2.Name == "SeatWeld" then
                            i2:Destroy()
                        end
                    end

                    for _, i2 in ipairs(root:GetChildren()) do
                        if i2.Name == "SeatWeld" then
                            i2:Destroy()
                        end
                    end

                    task.wait(fast and 0.02 or 0.05)

                    if hm.SeatPart and root then
                        root.CFrame = hm.SeatPart.CFrame * CFrame.new(0, 5, 3)
                    end
                end

                local exitWait = 0
                local exitLimit = fast and 0.35 or 0.8

                while exitWait < exitLimit do
                    task.wait(0.03)
                    exitWait += 0.03

                    if not hm.SeatPart then
                        break
                    end
                end

                for _, v in ipairs(attemptHS) do
                    allHS[#allHS + 1] = v
                end

                return true
            end)

            if ok then
                succeeded = true
                break
            else
                lastErr = err

                for _, v in ipairs(attemptHS) do
                    if v.seat and v.seat.Parent == seatHolder then
                        v.seat.Parent = v.par
                    end
                end

                task.wait(0.12)
            end
        end

        if not succeeded then
            warn("Queue car failed after 3 retries: " .. tostring(lastErr))
        end

        task.wait(getEffectiveQueueDelay())
    end

    for _, d in ipairs(allHS) do
        if d.seat and d.seat.Parent == seatHolder then
            d.seat.Parent = d.par
        end
    end

    if oCF and ch and ch:FindFirstChild("HumanoidRootPart") then
        ch.HumanoidRootPart.CFrame = oCF
    end

    S.carSlots = {}
    S.queueRunning = false
    S.lastSeat = nil

    if onDone then
        onDone(true)
    end
end

