            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = C.txtL
            lbl.Font = Enum.Font.GothamSemibold
            lbl.TextSize = 10
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 5
            lbl.Parent = frame

            local track = Instance.new("TextButton")
            track.Text = ""
            track.Size = UDim2.new(0, 44, 0, 24)
            track.AnchorPoint = Vector2.new(1, 0.5)
            track.Position = UDim2.new(1, -8, 0.5, 0)
            track.BackgroundColor3 = initOn and C.acc or C.bg0
            track.BorderSizePixel = 0
            track.AutoButtonColor = false
            track.ZIndex = 5
            track.Parent = frame

            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local stroke = addGlow(track, initOn and C.acc or C.sep, 1.2)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 18, 0, 18)
            knob.AnchorPoint = Vector2.new(0, 0.5)
            knob.Position = initOn and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
            knob.BackgroundColor3 = C.txtW
            knob.BorderSizePixel = 0
            knob.ZIndex = 6
            knob.Parent = track

            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            local on = initOn

            local function setOn(v)
                on = v

                tw(track, {BackgroundColor3 = on and C.acc or C.bg0}, 0.22, Enum.EasingStyle.Quint)
                tw(knob, {Position = on and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

                if stroke then
                    TweenService:Create(stroke, TweenInfo.new(0.22), {Color = on and C.acc or C.sep}):Play()
                end

                tw(frame, {BackgroundColor3 = on and Color3.fromRGB(22, 18, 45) or C.bg3}, 0.2)

                if onChange then
                    onChange(on)
                end
            end

            track.Activated:Connect(function()
                spawnRipple(track, Vector2.new(
                    track.AbsolutePosition.X + track.AbsoluteSize.X * 0.5,
                    track.AbsolutePosition.Y + track.AbsoluteSize.Y * 0.5
                ))

                setOn(not on)
            end)

            return frame, function(v)
                setOn(v)
            end
        end

