trackGlobal(RunService.RenderStepped:Connect(function()
    local car, prim, seat = getPrimary()

    if not car then
        if S.car then
            cleanup()
        end

        return
    end

    if S.noclip then
        for _, p in ipairs(car:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end

    if not S.flying or S.isTp then
        return
    end

    if S.car ~= car then
        cleanup()
        S.car = car
    end

    if not (S.bv and S.bv.Parent) then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FlyBV"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = prim

        S.bv = bv
    end

    local cam = workspace.CurrentCamera

    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector

    local rightF = Vector3.new(right.X, 0, right.Z)

    if rightF.Magnitude > 0.01 then
        rightF = rightF.Unit
    end

    local spd = Cfg.FlySpeed

    local vel = (look * seat.Throttle * spd) + (rightF * seat.Steer * spd)

    local up = 0

    if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.Q) then
        up = 1
    elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.E) then
        up = -1
    end

    vel = vel + Vector3.new(0, up * spd, 0)

    S.bv.Velocity = S.bv.Velocity:Lerp(vel, Cfg.Smooth)
end))

trackGlobal(RunService.Heartbeat:Connect(function()
    if S.flying and S.car and not S.isTp then
        local prim = S.car.PrimaryPart

        if prim then
            local cam = workspace.CurrentCamera
            local look = cam.CFrame.LookVector

            if look.Magnitude > 0.01 then
                local pos = prim.Position
                prim.CFrame = CFrame.new(pos, pos + look)
            end
        end
    end

    local ch = LP.Character

    if ch then
        local hm = ch:FindFirstChildOfClass("Humanoid")
        local seat = hm and hm.SeatPart

        if seat ~= S.lastSeat then
            S.lastSeat = seat

            if seat and seat:IsA("VehicleSeat") and S.autoEnabled and not S.queueRunning then
                local car = findCar(seat) or seat.Parent

                if car then
                    task.spawn(doAutoTp, car)
                end
            end
        end
    end
end))