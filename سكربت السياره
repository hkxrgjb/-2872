        local function flashBtn(btn, msg, orig, d)
            local origCol = btnCol[btn]
            local origText = btn.Text

            btn.Text = msg

            tw(btn, {BackgroundColor3 = lighten(origCol or C.bg4, 50)}, 0.1)

            task.delay(0.2, function()
                if btn and btn.Parent then
                    tw(btn, {BackgroundColor3 = origCol or C.bg4}, 0.25)
                end
            end)

            task.delay(d or 1.8, function()
                if btn and btn.Parent then
                    btn.Text = orig
                end
            end)
        end

