    if not ch then
        return
    end

    local hm = ch:FindFirstChildOfClass("Humanoid")

    if not hm then
        return
    end

    local st = hm.SeatPart

    if not (st and st:IsA("VehicleSeat")) then
        return
    end

    local cr = findCar(st) or st.Parent

    if not (cr and cr:IsA("Model")) then
        return
    end

    return cr, cr.PrimaryPart or st, st
