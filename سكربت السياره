local selHighlight, selUnhighlight

local function ensureSelectionUpdater()
    if S.selectionUpdaterConn then
        return
    end

    S.selectionUpdaterConn = RunService.Heartbeat:Connect(function()
        local now = tick()
        local anyLeft = false

        for car, d in pairs(S.selBoxes) do
            anyLeft = true

            if not car or not car.Parent then
                if d.box then
                    pcall(function()
                        d.box:Destroy()
                    end)
                end

                if d.part then
                    pcall(function()
                        d.part:Destroy()
                    end)
                end

                S.selBoxes[car] = nil
            else
                local currentCF = car.PrimaryPart and car.PrimaryPart.CFrame or car:GetPivot()

                if (currentCF.Position - d.lastCF.Position).Magnitude > 0.05 then
                    d.lastCF = currentCF
                    d.lastMove = now
                end

                local interval = 1

                if now - d.lastMove < 1 then
                    interval = 0.1
                end

                if now - d.lastUpdate >= interval then
                    d.lastUpdate = now

                    local refCF, refSize = getBoundsNoMotor(car)

                    if refCF then
                        d.part.Size = refSize
                        d.part.CFrame = refCF
                    end
                end
            end
        end

        if not anyLeft and S.selectionUpdaterConn then
            S.selectionUpdaterConn:Disconnect()
            S.selectionUpdaterConn = nil
        end
    end)
end

selUnhighlight = function(car)
    local d = S.selBoxes[car]

    if d then
        if d.box then
            pcall(function()
                d.box:Destroy()
            end)
