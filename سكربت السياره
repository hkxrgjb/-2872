----------------------------------------------------------------
-- Animation / UI helpers
----------------------------------------------------------------
local function tw(obj, props, dur, style, dir)
    local ti = TweenInfo.new(
        dur or 0.25,
        style or Enum.EasingStyle.Quint,
        dir or Enum.EasingDirection.Out
    )

    TweenService:Create(obj, ti, props):Play()
end

local function btnPunch(btn)
    local origSize = btn.Size

    local punchW = origSize.X.Offset * 0.94
    local punchH = origSize.Y.Offset * 0.90

    tw(btn, {Size = UDim2.new(origSize.X.Scale, punchW, origSize.Y.Scale, punchH)}, 0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    task.delay(0.08, function()
        if btn and btn.Parent then
            tw(btn, {Size = origSize}, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end
    end)
end

local function spawnRipple(btn, inputPos)
    pcall(function()
        local rip = Instance.new("Frame")
        rip.AnchorPoint = Vector2.new(0.5, 0.5)
        rip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        rip.BackgroundTransparency = 0.72
        rip.BorderSizePixel = 0
        rip.ZIndex = btn.ZIndex + 10
        rip.ClipsDescendants = false
        rip.Parent = btn

        local babs = btn.AbsolutePosition
        local bsz = btn.AbsoluteSize

        local relX = math.clamp(inputPos.X - babs.X, 0, bsz.X)
        local relY = math.clamp(inputPos.Y - babs.Y, 0, bsz.Y)

        local rx = relX / bsz.X
        local ry = relY / bsz.Y

        rip.Position = UDim2.new(rx, 0, ry, 0)
        rip.Size = UDim2.new(0, 2, 0, 2)

        Instance.new("UICorner", rip).CornerRadius = UDim.new(1, 0)

        local maxDim = math.max(bsz.X, bsz.Y) * 2.6

        tw(rip, {
            Size = UDim2.new(0, maxDim, 0, maxDim),
            BackgroundTransparency = 1,
        }, 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        task.delay(0.52, function()
            pcall(function()
                rip:Destroy()
            end)
        end)
    end)
end

local function lighten(col, amt)
    amt = amt or 25

    return Color3.fromRGB(
        math.min(col.R * 255 + amt, 255),
        math.min(col.G * 255 + amt, 255),
        math.min(col.B * 255 + amt, 255)
    )
end

local function fmtPos(cf)
    if not cf then
        return "—"
    end

    local p = cf.Position

    return string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z)
end

local function addGlow(obj, col, thickness)
    local s = Instance.new("UIStroke", obj)
    s.Color = col or C.acc
    s.Thickness = thickness or 1
    s.Transparency = 0.5
    return s
end

