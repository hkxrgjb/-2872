local selHighlight, selUnhighlight
local function ensureSelectionUpdater()
	if S.selectionUpdaterConn then return end
	S.selectionUpdaterConn = RunService.Heartbeat:Connect(function()
		local any = false
		for item, d in pairs(S.selBoxes) do
			any = true
			if not item or not item.Parent then
				for _, sb in ipairs(d.boxes or {}) do pcall(function() sb:Destroy() end) end
				S.selBoxes[item] = nil
			end
		end
		if not any and S.selectionUpdaterConn then
			S.selectionUpdaterConn:Disconnect(); S.selectionUpdaterConn = nil
		end
	end)
end
selUnhighlight = function(item)
	local d = S.selBoxes[item]
	if d then
		for _, sb in ipairs(d.boxes or {}) do pcall(function() sb:Destroy() end) end
		S.selBoxes[item] = nil
	end
end
selHighlight = function(item)
	if S.selBoxes[item] then return end
	local boxes = {}
	for _, p in ipairs(item:GetDescendants()) do
		if p:IsA("BasePart") then
			local sb = Instance.new("SelectionBox")
			sb.Adornee = p
			sb.Color3 = Color3.fromRGB(255, 120, 60)
			sb.LineThickness = 0.05
			sb.SurfaceTransparency = 1
			sb.Parent = selectionFolder
			table.insert(boxes, sb)
		end
	end
	S.selBoxes[item] = {boxes = boxes}
	ensureSelectionUpdater()
end
local function clearSel()
	for _, c in ipairs(S.selPlanks) do selUnhighlight(c) end
	S.selPlanks = {}; S.selBoxes = {}
	selectionFolder:ClearAllChildren()
end
local function addSel(item)
	for _, x in ipairs(S.selPlanks) do if x == item then return false end end
	table.insert(S.selPlanks, item); selHighlight(item); return true
end
local function removeSel(item)
	for i, x in ipairs(S.selPlanks) do
		if x == item then
			table.remove(S.selPlanks, i)
			selUnhighlight(item)
			return
		end
	end
end
local function updateSelection(oldPlank, newPlank)
	removeSel(oldPlank)
	addSel(newPlank)
end
local function getNearbyPlanks(cp, radius, maxCount)
	local seen, res = {}, {}
	for _, p in ipairs(workspace:GetPartBoundsInRadius(cp, radius)) do
		local item = findPlank(p)
		if item and not seen[item] and isMine(item) and hasCutEvent(item) then
			seen[item] = true
			local prim = getPlankPrim(item)
			if prim then res[#res+1] = {plank=item, dist=(cp-prim.Position).Magnitude} end
		end
	end
	table.sort(res, function(a,b) return a.dist < b.dist end)
	local out = {}
	for i, d in ipairs(res) do if maxCount and i > maxCount then break end out[#out+1] = d.plank end
	return out
end
local function getAllOwned()
	local out = {}
	local pm = workspace:FindFirstChild("PlayerModels")
	if pm then
		for _, it in ipairs(pm:GetChildren()) do
			if #out >= 400 then break end
			if isPlankModel(it) and isMine(it) and hasCutEvent(it) then out[#out+1] = it end
		end
	end
	return out
end
