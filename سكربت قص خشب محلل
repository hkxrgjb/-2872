local function snapshotPlanks(treeClass)
	local set = {}
	local count = 0
	local pm = workspace:FindFirstChild("PlayerModels")
	if pm then
		for _, item in ipairs(pm:GetChildren()) do
			if isPlankModel(item) and isMine(item) and hasCutEvent(item) and getTreeClass(item) == treeClass then
				set[item] = true
				count = count + 1
			end
		end
	end
	return set, count
end

local function findNewPlank(snapshot, treeClass)
	local pm = workspace:FindFirstChild("PlayerModels")
	if not pm then return nil end
	local best = nil
	local bestLen = -1
	for _, item in ipairs(pm:GetChildren()) do
		if isPlankModel(item) and isMine(item) and hasCutEvent(item) and getTreeClass(item) == treeClass then
			if not snapshot[item] then
				local l = getPlankLength(item)
				if l > bestLen then
					bestLen = l
					best = item
				end
			end
		end
	end
	return best
end

local function refreshSnapshot(snapshot, treeClass)
	local pm = workspace:FindFirstChild("PlayerModels")
	if not pm then return end
	for _, item in ipairs(pm:GetChildren()) do
		if isPlankModel(item) and isMine(item) and hasCutEvent(item) and getTreeClass(item) == treeClass then
			snapshot[item] = true
		end
	end
end
