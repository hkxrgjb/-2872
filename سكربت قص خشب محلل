----------------------------------------------------------------
local function isPlankModel(m)
	return m:IsA("Model") and m.Name=="Plank" and m:FindFirstChild("WoodSection")~=nil
end
local function findPlank(inst)
	local c = inst
	while c do
		if isPlankModel(c) then return c end
		c = c.Parent
	end
	return nil
end
local function getPlankPrim(item)
	return item:FindFirstChild("WoodSection") or item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
end
local function getOwnerName(item)
	local o = item:FindFirstChild("Owner")
	if not o then return nil end
	local v = o.Value
	if typeof(v)=="string" then return v end
	if typeof(v)=="Instance" then return v.Name end
	return tostring(v)
end
local function isMine(item)
	local o = getOwnerName(item)
	if o == nil then return true end
	return o == LP.Name
end
local function hasCutEvent(item) return item:FindFirstChild("CutEvent") ~= nil end
local function getTreeClass(item)
	local tc = item:FindFirstChild("TreeClass")
	if tc and tc:IsA("StringValue") then return tc.Value end
	return nil
end
local function getPlankLength(plank)
	if not plank or not plank.Parent then return 0 end
	local prim = getPlankPrim(plank)
	if not prim then return 0 end
	local size = prim.Size
	return math.max(size.X, size.Y, size.Z)
end
----------------------------------------------------------------
-- التحقق: هل يقدر يقسمها فعلاً؟
-- اللعبة تحتاج فائض: الطول لازم يكون على الاقل (حجم القص + الفائض)
-- مثال: حجم القص 1 → الخشبة لازم تكون 1.2 على الاقل
----------------------------------------------------------------
local function canSplitPlank(plank, cutSize)
	local length = getPlankLength(plank)
	local needed = cutSize + Cfg.SplitMargin
	return length >= needed, length, needed
end
----------------------------------------------------------------
local function getCutProxy()
	local i = ReplicatedStorage:FindFirstChild("Interaction")
	return i and i:FindFirstChild("RemoteProxy")
end
local function equipAxe()
	local ch = LP.Character; if not ch then return nil end
	local hm = ch:FindFirstChildOfClass("Humanoid"); if not hm then return nil end
	local tool = ch:FindFirstChildWhichIsA("Tool")
	if tool then return tool end
	local bp = LP:FindFirstChild("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") then
				pcall(function() hm:EquipTool(t) end)
				task.wait(0.1)
				return ch:FindFirstChildWhichIsA("Tool")
			end
		end
	end
	return nil
end
local function fireCut(plank, height, sectionId, tool)
	local cutEvent = plank:FindFirstChild("CutEvent")
	local proxy = getCutProxy()
	if not cutEvent or not proxy then return false end
	pcall(function()
		proxy:FireServer(cutEvent, {
			height = height,
			faceVector = Vector3.new(-1, 0, 0),
			cooldown = 0.1,
			sectionId = sectionId,
			hitPoints = 10.2,
			tool = tool,
			cuttingClass = "Axe",
		})
	end)
	return true
end
----------------------------------------------------------------
local function getCutPoint(plank, height)
	local prim = getPlankPrim(plank)
	if not prim then return Vector3.zero end
	local cf = prim.CFrame
	local size = prim.Size
	local length = math.max(size.X, size.Y, size.Z)
	local axis
	if size.X >= size.Y and size.X >= size.Z then
		axis = Vector3.xAxis
	elseif size.Y >= size.X and size.Y >= size.Z then
		axis = Vector3.yAxis
	else
		axis = Vector3.zAxis
	end
	local offset = (height - length/2) * axis
	local worldOffset = cf:VectorToWorldSpace(offset)
	return prim.Position + worldOffset
end
