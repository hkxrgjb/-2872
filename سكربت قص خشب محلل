----------------------------------------------------------------
local function cutPlankFully(plank, cutSize, lock)
	debugPrint("=== START CUTTING ===")
	debugPrint("Plank length: " .. getPlankLength(plank))

	local tool = Cfg.AutoAxe and equipAxe() or (LP.Character and LP.Character:FindFirstChildWhichIsA("Tool"))
	if not tool then debugPrint("ERROR: No tool!") return end

	local treeClass = getTreeClass(plank)
	if not treeClass then debugPrint("ERROR: No TreeClass!") return end
	debugPrint("TreeClass: " .. treeClass)

	local snapshot, snapCount = snapshotPlanks(treeClass)
	debugPrint("Memory snapshot: " .. snapCount .. " planks")

	local currentPlank = plank

	while not S.stopCut do
		if not (currentPlank and currentPlank.Parent) then
			debugPrint("Plank gone! Stopping.")
			break
		end

		-- التحقق: هل يقدر يقسمها فعلاً؟ (لازم فائض 0.2 على الاقل)
		local canSplit, currentLength, needed = canSplitPlank(currentPlank, cutSize)
		debugPrint("Length: " .. currentLength .. " | Needed: " .. needed .. " | Can split: " .. tostring(canSplit))

		if not canSplit then
			debugPrint("✅ PLANK FINISHED! No surplus left (length < cut size + margin)")
			debugPrint("Removing from selection, moving to next plank...")
			removeSel(currentPlank)
			break
		end

		local cutPoint = getCutPoint(currentPlank, cutSize)
		if not lock.handle then
			debugPrint("Creating lock at cut point...")
			lock.handle = createLock(cutPoint)
		else
			debugPrint("Moving lock to new cut point (no return)...")
			updateLock(lock.handle, cutPoint)
		end
		debugPrint("Hitting section 1 (height " .. cutSize .. ")...")

		local newPlank = nil

		-- يضرب للابد حتى يظهر ملف جديد (بدون اي نظام حماية)
		while not S.stopCut do
			for hit = 1, Cfg.HitsPerCut do
				if S.stopCut then break end
				fireCut(currentPlank, cutSize, 1, tool)
				task.wait(Cfg.HitDelay)
			end

			newPlank = findNewPlank(snapshot, treeClass)
			if newPlank then break end

			if not (currentPlank and currentPlank.Parent) then
				debugPrint("Plank destroyed! Waiting for new file...")
				local grace = 0
				while grace < 2 and not newPlank do
					task.wait(0.1); grace = grace + 0.1
					newPlank = findNewPlank(snapshot, treeClass)
				end
				break
			end
		end

		if S.stopCut then
			debugPrint("Stop requested!")
			break
		end

		if newPlank then
			debugPrint("🆕 NEW FILE appeared! length: " .. getPlankLength(newPlank))
			updateSelection(currentPlank, newPlank)
			refreshSnapshot(snapshot, treeClass)
			currentPlank = newPlank
			task.wait(0.1)
		else
			debugPrint("No new file appeared. Stopping.")
			break
		end
	end

	debugPrint("=== CHAIN FINISHED ===")
end
----------------------------------------------------------------
local function startCutting(onDone)
	if S.cutting then if onDone then onDone(false) end return end
	if #S.selPlanks == 0 then if onDone then onDone(false) end return end

	debugPrint("Starting cutting for " .. #S.selPlanks .. " planks")

	S.cutting = true
	S.stopCut = false

	local ch = LP.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	S.originalPosition = root and root.CFrame

	local lock = {handle = nil}

	local list = {}
	for _, p in ipairs(S.selPlanks) do table.insert(list, p) end

	for _, item in ipairs(list) do
		if S.stopCut then break end
		if item and item.Parent and hasCutEvent(item) then
			debugPrint("Processing: " .. tostring(item))
			pcall(function()
				cutPlankFully(item, Cfg.CutSize, lock)
			end)
		end
	end

	if lock.handle then
		if S.originalPosition then lock.handle.originalCF = S.originalPosition end
		restorePlayer(lock.handle)
	end
	S.originalPosition = nil

	S.cutting = false
	debugPrint("Cutting process completed")
	if onDone then onDone(true) end
end
