local function createLock(targetPoint)
	local ch = LP.Character
	if not ch then return nil end
	local root = ch:FindFirstChild("HumanoidRootPart")
	local hm = ch:FindFirstChildOfClass("Humanoid")
	if not root or not hm then return nil end

	local originalCF = root.CFrame
	hm.PlatformStand = true
	hm.AutoRotate = false

	local bodyPos = Instance.new("BodyPosition")
	bodyPos.Name = "CutHubBodyPos"
	bodyPos.Position = targetPoint + Vector3.new(0, Cfg.HoverHeight, 0)
	bodyPos.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bodyPos.P = 10000
	bodyPos.D = 100
	bodyPos.Parent = root

	local bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "CutHubBodyGyro"
	local lookTarget = Vector3.new(targetPoint.X, root.Position.Y, targetPoint.Z)
	bodyGyro.CFrame = CFrame.new(root.Position, lookTarget)
	bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bodyGyro.P = 10000
	bodyGyro.D = 100
	bodyGyro.Parent = root

	return {originalCF = originalCF, bodyPos = bodyPos, bodyGyro = bodyGyro, root = root, hm = hm}
end

local function updateLock(handle, targetPoint)
	if not handle then return end
	if handle.bodyPos and handle.bodyPos.Parent then
		handle.bodyPos.Position = targetPoint + Vector3.new(0, Cfg.HoverHeight, 0)
	end
	if handle.bodyGyro and handle.bodyGyro.Parent and handle.root and handle.root.Parent then
		local lookTarget = Vector3.new(targetPoint.X, handle.root.Position.Y, targetPoint.Z)
		handle.bodyGyro.CFrame = CFrame.new(handle.root.Position, lookTarget)
	end
end

local function restorePlayer(handle)
	if not handle then return end
	if handle.bodyPos and handle.bodyPos.Parent then handle.bodyPos:Destroy() end
	if handle.bodyGyro and handle.bodyGyro.Parent then handle.bodyGyro:Destroy() end
	if handle.root and handle.root.Parent and handle.originalCF then
		handle.root.CFrame = handle.originalCF
	end
	if handle.hm and handle.hm.Parent then
		handle.hm.PlatformStand = false
		handle.hm.AutoRotate = true
	end
end
