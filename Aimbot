local statusText, statusColor, statusDirty = "Searching...", C.accent, true
local statusLabel, pillLabel = nil, nil
local lastStatusFlush = 0

local cleanup  -- assigned at the bottom

local function setStatus(text, color)
    color = color or C.accent
    if text ~= statusText or color ~= statusColor then
        statusText, statusColor, statusDirty = text, color, true
    end
end

local function flushStatus(now)
    if statusDirty and now - lastStatusFlush >= 0.1 then
        statusDirty = false
        lastStatusFlush = now
        if statusLabel then
            statusLabel.Text = statusText
            statusLabel.TextColor3 = statusColor
        end
        if pillLabel then
            pillLabel.Text = statusText
            pillLabel.TextColor3 = statusColor
        end
    end
end

-- ============ Helpers ============
local function camera()
    return Workspace.CurrentCamera
end

local function isAlive(plr)
    local char = plr and plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function isMate(plr)
    if not Settings.TeamCheck then return false end
    return plr.Team ~= nil and plr.Team == LocalPlayer.Team
end

local function getRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local friendCache = {}
local function isFriend(plr)
    local v = friendCache[plr.UserId]
    if v == nil then
        friendCache[plr.UserId] = false
        task.spawn(function()
            local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(plr.UserId) end)
            if ok then friendCache[plr.UserId] = res end
        end)
        return false
    end
    return v
end

local whitelistMap = {}
local function rebuildWhitelist()
    whitelistMap = {}
    for _, id in ipairs(Settings.Whitelist) do whitelistMap[id] = true end
end
rebuildWhitelist()

local function isWhitelisted(plr)
    return whitelistMap[plr.UserId] == true
end

local function toggleWhitelist(plr)
    if whitelistMap[plr.UserId] then
        for i, id in ipairs(Settings.Whitelist) do
            if id == plr.UserId then table.remove(Settings.Whitelist, i) break end
        end
    else
        table.insert(Settings.Whitelist, plr.UserId)
    end
    rebuildWhitelist()
    saveDirty = true
end

local function isValidTarget(plr)
    return plr ~= nil and plr ~= LocalPlayer and plr.Parent ~= nil
        and isAlive(plr) and not isMate(plr) and not isWhitelisted(plr)
        and not (Settings.IgnoreFriends and isFriend(plr))
end

-- ============================================================
-- Network latency (cached)
-- ============================================================
local cachedPing, lastPingCheck = 0.08, 0
local function getPing()
    local now = os.clock()
    if now - lastPingCheck < 0.5 then return cachedPing end
    lastPingCheck = now
    pcall(function()
        local item = Stats.Network and Stats.Network.ServerStatsItem
                     and Stats.Network.ServerStatsItem["Data Ping"]
        if item then
            local v = item:GetValue()
            if v and v > 5 then cachedPing = math.clamp(v / 1000, 0.02, 0.4) end
        end
    end)
    return cachedPing
end

-- ============================================================
-- Line of sight (one reusable RaycastParams; rays respect CanCollide)
-- ============================================================
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.RespectCanCollide = true
losParams.IgnoreWater = true

local function refreshLosFilter()
    local list = {}
    if LocalPlayer.Character then table.insert(list, LocalPlayer.Character) end
    local cam = camera()
    if cam then table.insert(list, cam) end
    losParams.FilterDescendantsInstances = list
end

local function isVisible(part)
    local cam = camera()
    if not cam then return true end
    local origin = cam.CFrame.Position
    local result = Workspace:Raycast(origin, part.Position - origin, losParams)
    if not result then return true end
    local hit = result.Instance
    return hit:IsDescendantOf(part.Parent) or hit.Transparency > 0.8
end

local function hasLineOfSight(part)
    if not Settings.WallCheck then return true end
    return isVisible(part)
end

-- ============================================================
-- Bone selection
-- ============================================================
local function resolveBone(char, name)
    if name == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild(name)
end

local function getBestPart(plr)
    local char = plr and plr.Character
    if not char then return nil end
    if Settings.SmartBone then
        for _, name in ipairs({ "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
            local p = char:FindFirstChild(name)
            if p and hasLineOfSight(p) then return p end
        end
        return nil
    end
    local p = resolveBone(char, Settings.TargetPart)
    if p and hasLineOfSight(p) then return p end
    return nil
end

-- ============================================================
-- Adaptive motion tracker (alpha-beta-gamma, dt-aware)
--  * follows the target's root part, so switching between Head / Torso
--    never disturbs the estimate
--  * maneuver detection: locks onto sudden dashes / flights within frames
--  * reported velocity is fused only while it agrees with real movement
--  * teleports and long gaps snap instead of creating fake speed
-- ============================================================
local TRK = {
    TAU_STEADY = 0.10, TAU_FAST = 0.03, NOISE = 0.15,
    KV = 0.40, KA = 0.15, ACC_DECAY = 0.50,
    MAX_SPEED = 500, MAX_ACCEL = 400,
    TELE_SPEED = 1200, TELE_MIN = 25,
    MIN_MOVE = 0.001, MIN_DT = 1 / 240, MAX_DT = 0.25, STALE = 0.085,
}

local function newTracker()
    return {
        init = false, hrp = nil,
        pos = Vector3.zero, vel = Vector3.zero, acc = Vector3.zero,
        time = 0, last = Vector3.zero, rel = 1, man = 0,
    }
end

local function trackerSnap(T, pos, vel, now)
    T.pos = pos
    if vel.Magnitude <= TRK.MAX_SPEED then T.vel = vel else T.vel = Vector3.zero end
    T.acc = Vector3.zero
    T.time = now
    T.last = pos
    T.rel = 1
    T.man = 0
    T.init = true
end

local function trackerUpdate(T, hrp, now)
    local pos = hrp.Position
    local vel = hrp.AssemblyLinearVelocity
    if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return end

    if not T.init or T.hrp ~= hrp then
        T.hrp = hrp
        trackerSnap(T, pos, vel, now)
        return
    end

    local moved = (pos - T.last).Magnitude
    local since = now - T.time
    if since > 0.5 then
        trackerSnap(T, pos, vel, now)
        return
    end
    local velMag = vel.Magnitude
    local velOK = velMag <= TRK.MAX_SPEED * 1.5

    if moved < TRK.MIN_MOVE and since < TRK.STALE then
        local stopped = velOK and velMag < 1 and T.vel.Magnitude > 3 and since >= 1 / 120
        if not stopped then return end
    end

    local dt = math.clamp(since, TRK.MIN_DT, TRK.MAX_DT)
    if moved > TRK.TELE_MIN and moved / dt > TRK.TELE_SPEED then
        trackerSnap(T, pos, vel, now)
        return
    end

    local pp = T.pos + T.vel * dt + T.acc * (0.5 * dt * dt)
    local pv = T.vel + T.acc * dt
    local res = pos - pp
    local speed = pv.Magnitude

    local thr = TRK.NOISE + speed * dt * 0.25
    local m = math.clamp((res.Magnitude - thr) / (thr * 3), 0, 1)
    if velOK then
        local vi = (vel - pv).Magnitude
        local thrv = 8 + 0.3 * speed
        local mv = math.clamp((vi - thrv) / (thrv * 2), 0, 1)
        local agree = vi <= math.max(6, 0.4 * speed)
        T.rel = T.rel + ((agree and 1 or 0) - T.rel) * 0.15
        if T.rel > 0.5 then m = math.max(m, mv) end
    end
    T.man = math.max(m, T.man * math.exp(-dt / 0.15))

    local tau = TRK.TAU_STEADY + (TRK.TAU_FAST - TRK.TAU_STEADY) * T.man
    local th = math.exp(-dt / tau)
    local omt = 1 - th
    local g = 1 - th ^ 3
    local h = 1.5 * omt * omt * (1 + th)
    local k = 0.5 * omt ^ 3

    local nPos = pp + res * g
    local nVel = pv + res * (h / dt)
    local nAcc = T.acc + res * (2 * k / (dt * dt))

    if velOK and T.rel > 0.5 then
        local kv = math.min(TRK.KV + 0.4 * T.man, 1)
        nVel = nVel + (vel - nVel) * kv
        local ka = TRK.KA + 0.3 * T.man
        local aMeas = (vel - T.vel) / dt
        nAcc = nAcc + (aMeas - nAcc) * ka
    end

    nAcc = nAcc * math.exp(-dt / TRK.ACC_DECAY)

    local sp = nVel.Magnitude
    if sp > TRK.MAX_SPEED then nVel = nVel * (TRK.MAX_SPEED / sp) end
    local ac = nAcc.Magnitude
    if ac > TRK.MAX_ACCEL then nAcc = nAcc * (TRK.MAX_ACCEL / ac) end

    T.pos, T.vel, T.acc = nPos, nVel, nAcc
    T.time = now
    T.last = pos
end

local function trackerPredict(T, now, lead)
    local d = math.clamp((now - T.time) + lead, 0, 0.6)
    return T.pos + T.vel * d + T.acc * (0.5 * d * d)
end

local aimTracker = newTracker()

-- ============================================================
-- Aim math
-- ============================================================
local function computeLeadOffset(root, hum, now)
    if not Settings.Prediction or not aimTracker.init then return Vector3.zero end
    local cam = camera()
    local dist = (root.Position - cam.CFrame.Position).Magnitude
    local lead = getPing() * Settings.PingComp
    if Settings.BulletSpeed > 0 then
        lead = lead + (dist / Settings.BulletSpeed) * Settings.PredAmount
    end
    lead = math.clamp(lead, 0, 0.6)

    local offset = trackerPredict(aimTracker, now, lead) - root.Position
    local airborne = (not hum) or hum.FloorMaterial == Enum.Material.Air
    if not airborne then offset = Vector3.new(offset.X, 0, offset.Z) end
    if offset.Magnitude > 40 then offset = offset.Unit * 40 end
    return offset
end

local function getAimPosition(part, offset)
    local cam = camera()
    local pos = part.Position + (offset or Vector3.zero)
    local dist = (part.Position - cam.CFrame.Position).Magnitude
    pos = pos + Vector3.new(0, dist * Settings.DynamicOffset, 0)
    local maxY = part.Position.Y + 15
    if pos.Y > maxY then pos = Vector3.new(pos.X, maxY, pos.Z) end
    return pos
end

local function screenDistance(worldPos)
    local cam = camera()
    local v, onScreen = cam:WorldToViewportPoint(worldPos)
    if not onScreen or v.Z <= 0 then return nil end
    return (Vector2.new(v.X, v.Y) - cam.ViewportSize / 2).Magnitude
end

-- Frame-rate independent camera smoothing
local function aimCamera(aimPos, base, dt)
    local cam = camera()
    local camPos = cam.CFrame.Position
    if (aimPos - camPos).Magnitude < 1 then return end
    local b = math.clamp(base, 0, 1)
    local alpha = 1 - (1 - b) ^ (math.clamp(dt, 1 / 240, 0.1) * 60)
    cam.CFrame = cam.CFrame:Lerp(CFrame.new(camPos, aimPos), alpha)
end

-- ============================================================
-- Target selection (runs 10-20 times per second, not every frame)
-- ============================================================
local function scoreFor(plr, screenDist, worldDist)
    local mode = Settings.TargetMode
    if mode == "Distance" then return worldDist end
    if mode == "Health" then
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        return hum and hum.Health or math.huge
    end
    return screenDist
end

local function getBestTarget()
    local cam = camera()
    local camPos = cam.CFrame.Position
    local bestPlr, bestPart, bestScore = nil, nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local root = getRoot(plr.Character)
            if root then
                local worldDist = (root.Position - camPos).Magnitude
                if worldDist <= Settings.MaxDistance then
                    -- cheap screen check first, raycasts only for candidates
                    local rootScreen = screenDistance(root.Position)
                    if rootScreen and rootScreen <= Settings.FOV + 60 then
                        local part = getBestPart(plr)
                        if part then
                            local sd = screenDistance(part.Position)
                            if sd and sd <= Settings.FOV then
                                if plr.UserId == Settings.PriorityId then
                                    return plr, part
                                end
                                local score = scoreFor(plr, sd, worldDist)
                                if score < bestScore then
                                    bestScore, bestPlr, bestPart = score, plr, part
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPlr, bestPart
end

local function selectTarget()
    refreshLosFilter()

    if Settings.Sticky and CurrentTarget and isValidTarget(CurrentTarget)
        and CurrentTarget.UserId ~= Settings.PriorityId and Settings.PriorityId == 0 then
        local part = getBestPart(CurrentTarget)
        if part then
            local d = screenDistance(part.Position)
            if d and d <= Settings.FOV * 1.4 then
                CurrentPart = part
                return
            end
        end
    end

    local plr, part = getBestTarget()
    if plr ~= CurrentTarget then aimTracker = newTracker() end
    CurrentTarget, CurrentPart = plr, part
end

-- ============================================================
-- Auto fire (fires the equipped tool when the aim point is on the crosshair)
-- ============================================================
local lastFire = 0
local function tryAutoFire(now, aimPos)
    if not Settings.AutoFire or now - lastFire < Settings.FireDelay then return end
    local d = screenDistance(aimPos)
    if not d or d > Settings.TriggerRadius then return end
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        lastFire = now
        pcall(function() tool:Activate() end)
    end
end

-- ============================================================
-- Kill system
-- ============================================================
local hazardParts = {}
local hazardConn = nil
local RED = Color3.fromRGB(255, 0, 0)
local REALLY_RED = BrickColor.new("Really red")

local function isHazard(v)
    return v:IsA("BasePart") and (v.Color == RED or v.BrickColor == REALLY_RED)
end

-- Red kill-bricks stop firing Touched during a kill run (scanned once, restored after)
local function beginHazardBypass()
    hazardParts = {}
    local n = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        n = n + 1
        if n % 1000 == 0 then task.wait() end
        if isHazard(v) and v.CanTouch then
            hazardParts[v] = true
            v.CanTouch = false
        end
    end
    hazardConn = Workspace.DescendantAdded:Connect(function(v)
        if isHazard(v) and v.CanTouch then
            hazardParts[v] = true
            v.CanTouch = false
        end
    end)
end

local function endHazardBypass()
    if hazardConn then
        hazardConn:Disconnect()
        hazardConn = nil
    end
    for p in pairs(hazardParts) do
        if p.Parent then p.CanTouch = true end
    end
    hazardParts = {}
end

local function equipWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    tool = bp and bp:FindFirstChildOfClass("Tool")
    if tool then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:EquipTool(tool) else tool.Parent = char end
    end
    return tool
end

-- returns: "killed" | "stopped" | "died" | "gone" | "no_weapon" | "shielded"
local function attackTarget(targetPlayer, skipShielded)
    if not equipWeapon() then
        setStatus("No Weapon Found", C.warn)
        return "no_weapon"
    end

    local angle, lastActivate, lastHeal, shieldTime = 0, 0, 0, 0

    while isKilling and Running do
        local dt = RunService.Heartbeat:Wait()
        local now = os.clock()

        local myChar = LocalPlayer.Character
        local myRoot = getRoot(myChar)
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum or myHum.Health <= 0 then return "died" end

        local tChar = targetPlayer.Character
        local tRoot = getRoot(tChar)
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not targetPlayer.Parent or not tRoot or not tHum then return "gone" end
        if tHum.Health <= 0 then return "killed" end

        if now - lastHeal >= 0.5 then
            lastHeal = now
            myHum.Health = myHum.MaxHealth
        end

        local tool = equipWeapon()

        if tChar:FindFirstChildOfClass("ForceField") then
            shieldTime = shieldTime + dt
            setStatus("Target shielded...", C.warn)
            if skipShielded and shieldTime > 6 then return "shielded" end
        else
            shieldTime = 0
            setStatus("Attacking " .. targetPlayer.Name, C.bad)

            angle = angle + math.rad(Settings.KillSpeed) * dt
            local center = tRoot.Position
            local newPos = center + Vector3.new(
                math.cos(angle) * Settings.KillRadius,
                Settings.KillHeight,
                math.sin(angle) * Settings.KillRadius
            )
            myRoot.CFrame = CFrame.new(newPos, center)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            KillAimPart = tRoot

            if tool and now - lastActivate >= 0.08 then
                lastActivate = now
                pcall(function() tool:Activate() end)
            end
        end
    end
    return "stopped"
end

local function finishKill(origin)
    endHazardBypass()
    KillAimPart = nil
    isKilling = false
    if origin and isAlive(LocalPlayer) then
        local root = getRoot(LocalPlayer.Character)
        if root then root.CFrame = origin end
    end
end

local function startSingleKill(plr)
    if isKilling or not Running then return end
    if not plr or not isAlive(plr) then return end
    isKilling = true
    task.spawn(function()
        local root = getRoot(LocalPlayer.Character)
        local origin = root and root.CFrame
        beginHazardBypass()
        local result = attackTarget(plr, false)
        finishKill(origin)
        if result == "killed" then
            setStatus("Killed " .. plr.Name, C.good)
        elseif result == "stopped" then
            setStatus("Kill Stopped", C.warn)
        elseif result == "died" then
            setStatus("You died", C.bad)
        end
    end)
end

local function startKillAll()
    if isKilling or not Running then return end
    isKilling = true
    task.spawn(function()
        local root = getRoot(LocalPlayer.Character)
        local origin = root and root.CFrame
        beginHazardBypass()
        local kills = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if not (isKilling and Running) then break end
            if isValidTarget(plr) then
                local result = attackTarget(plr, true)
                if result == "killed" then kills = kills + 1 end
                if result == "no_weapon" or result == "died" then break end
            end
        end
        finishKill(origin)
        setStatus("Kill All finished: " .. kills, C.good)
    end)
end

local function stopKilling()
    if isKilling then
        isKilling = false
        setStatus("Kill Stopped", C.warn)
    end
end

-- ============================================================
-- UI helpers
-- ============================================================
local function create(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function round(o, r)
    create("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end

local function circle(o)
    create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, o)
end

local function outline(o, color, thickness, transparency)
    return create("UIStroke", {
        Color = color, Thickness = thickness or 1, Transparency = transparency or 0,
    }, o)
end

local function safeParent(obj)
    pcall(function()
        if gethui then
            obj.Parent = gethui()
        else
            obj.Parent = game:GetService("CoreGui")
        end
    end)
    if not obj.Parent then obj.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

-- Drag with tap detection (touch + mouse). Frame must use AnchorPoint 0.5, 0.5
local function makeDraggable(frame, handle, onDown, onUp)
    local dragging, dragInput = false, nil
    local startInput, startCenter, moved = Vector2.zero, Vector2.zero, false

    track(handle.InputBegan:Connect(function(i)
        if dragging then return end
        if i.UserInputType == Enum.UserInputType.Touch
            or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            moved = false
            dragInput = i
            startInput = Vector2.new(i.Position.X, i.Position.Y)
            startCenter = frame.AbsolutePosition + frame.AbsoluteSize / 2
            if onDown then onDown() end
        end
    end))

    track(UserInputService.InputChanged:Connect(function(i)
        if not dragging then return end
        if (i.UserInputType == Enum.UserInputType.Touch and i == dragInput)
            or i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = Vector2.new(i.Position.X, i.Position.Y) - startInput
            if d.Magnitude > 10 then moved = true end
            if moved and frame.Parent then
                local vp = frame.Parent.AbsoluteSize
                local nx = math.clamp(startCenter.X + d.X, 24, vp.X - 24)
                local ny = math.clamp(startCenter.Y + d.Y, 24, vp.Y - 24)
                frame.Position = UDim2.fromOffset(nx, ny)
            end
        end
    end))

    track(UserInputService.InputEnded:Connect(function(i)
        if not dragging then return end
        local ended
        if dragInput.UserInputType == Enum.UserInputType.Touch then
            ended = (i == dragInput)
        else
            ended = (i.UserInputType == Enum.UserInputType.MouseButton1)
        end
        if ended then
            dragging = false
            dragInput = nil
            if onUp then onUp(not moved) end
        end
    end))
end

