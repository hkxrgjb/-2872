function normalizeChipOrder()
    local valid = {}
    for _, id in ipairs(CHIP_IDS) do valid[id] = true end
    local seen, cleaned = {}, {}
    for _, id in ipairs(Settings.ChipOrder) do
        if valid[id] and not seen[id] then
            seen[id] = true
            table.insert(cleaned, id)
        end
    end
    if #cleaned == 0 then cleaned = deepCopy(DEFAULTS.ChipOrder) end
    while #cleaned > 8 do table.remove(cleaned) end
    Settings.ChipOrder = cleaned
end
