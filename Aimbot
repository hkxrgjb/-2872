-- =====================================================================
-- SCREEN BOUNDARY SAFETY  [FIX#1] global
-- =====================================================================
clampedFrames = {}

function clampFrame(frame)
    local parent = frame.Parent
    if not parent or not frame.Visible then return end
    local vp = parent.AbsoluteSize
    if vp.X < 20 or vp.Y < 20 then return end
    local size  = frame.AbsoluteSize
    local halfW = math.min(size.X/2, vp.X/2 - 6)
    local halfH = math.min(size.Y/2, vp.Y/2 - 6)
    local topInset = safeTopInset()
    local cx = frame.Position.X.Offset
    local cy = frame.Position.Y.Offset
    local minX = math.max(halfW + 4, 4)
    local maxX = math.max(vp.X - halfW - 4, minX)
    local nx   = math.clamp(cx, minX, maxX)
    local minY = math.max(halfH + topInset*0.4, halfH + 4)
    local maxY = math.max(vp.Y - halfH - 4, minY)
    local ny   = math.clamp(cy, minY, maxY)
    if nx ~= cx or ny ~= cy then
        frame.Position = UDim2.fromOffset(nx, ny)
    end
end

function registerClamp(frame)
    clampedFrames[frame] = true
end

function reclampAll()
    for frame in pairs(clampedFrames) do
        if frame.Parent then
            pcall(clampFrame, frame)
        else
            clampedFrames[frame] = nil
        end
    end
end

track(uiLayer:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    task.defer(reclampAll)
end))
track(hudGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    task.defer(reclampAll)
end))

-- Pointer capture with dead-flag support
captures = {}

function isPointer(i)
    return i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1
end

function beginCapture(input, onMove, onEnd)
    local entry = { input=input, onMove=onMove, onEnd=onEnd,
                    dead=false }
    table.insert(captures, entry)
    return entry
end

function captureMatches(c, i, ended)
    if c.input.UserInputType == Enum.UserInputType.Touch then
        return i == c.input
    end
    if ended then
        return i.UserInputType == Enum.UserInputType.MouseButton1
    end
    return i.UserInputType == Enum.UserInputType.MouseMovement
end

track(UserInputService.InputChanged:Connect(function(i)
    for _, c in ipairs(captures) do
        if not c.dead and c.onMove
            and captureMatches(c, i, false)
        then
            c.onMove(i.Position, c)
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(i)
    for idx = #captures, 1, -1 do
        local c = captures[idx]
        if captureMatches(c, i, true) then
            table.remove(captures, idx)
            if not c.dead and c.onEnd then c.onEnd() end
        end
    end
end))

function makeDraggable(frame, handle, onDown, onUp, posKey)
    registerClamp(frame)
    handle.InputBegan:Connect(function(i)
        if not isPointer(i) then return end
        local startInput = Vector2.new(i.Position.X, i.Position.Y)
        local startCenter = frame.AbsolutePosition
                          + frame.AbsoluteSize / 2
        local moved = false
        if onDown then onDown() end
        beginCapture(i, function(pos)
            local d = Vector2.new(pos.X, pos.Y) - startInput
            if d.Magnitude > 10 then moved = true end
            if moved and frame.Parent then
                frame.Position = UDim2.fromOffset(
                    startCenter.X + d.X,
                    startCenter.Y + d.Y)
                clampFrame(frame)
            end
        end, function()
            if moved and posKey and frame.Parent then
                local vp = frame.Parent.AbsoluteSize
                if vp.X > 0 and vp.Y > 0 then
                    Settings.HudPos[posKey] = {
                        frame.Position.X.Offset / vp.X,
                        frame.Position.Y.Offset / vp.Y,
                    }
                    saveDirty = true
                end
            end
            if onUp then onUp(not moved) end
        end)
    end)
end

function applySavedPos(frame, key, defX, defY)
    local p = Settings.HudPos[key]
    if type(p) == "table" and type(p[1]) == "number"
        and type(p[2]) == "number"
    then
        frame.Position = UDim2.new(
            math.clamp(p[1], 0.02, 0.98), 0,
            math.clamp(p[2], 0.04, 0.96), 0)
    else
        frame.Position = UDim2.new(defX, 0, defY, 0)
    end
end

