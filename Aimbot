        if now - lastThreatCheck < 0.2 then return end
        lastThreatCheck = now
        local cam    = camera()
        local myRoot = getRoot(LocalPlayer.Character)
        if not cam or not myRoot then return end
        local look = cam.CFrame.LookVector
        local nearest, nearestDist = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isValidTarget(plr) then
                local root = getRoot(plr.Character)
                if root then
                    local rel = root.Position - myRoot.Position
                    local d   = rel.Magnitude
                    if d <= Settings.AlertRange
                        and d < nearestDist
                        and rel:Dot(look) < 0
                    then
                        nearest     = plr
                        nearestDist = d
                    end
                end
            end
        end
        local on = nearest ~= nil
        if threatFrame.Visible ~= on then
            threatFrame.Visible = on
        end
        if on and now - lastThreatToast > 2.5 then
            lastThreatToast = now
            toast(string.format(L("fmtThreat"),
                nearest.DisplayName,
                math.floor(nearestDist)), C.bad, 1.6)
