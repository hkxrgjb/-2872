-- ----- Tap a player in the world to make them the priority target (tap again to release)
track(UserInputService.TouchTapInWorld:Connect(function(pos, processed)
    if processed or not Settings.TapToLock or not Running or isKilling then return end
    local cam = camera()
    if not cam then return end
    local best, bestD = nil, 80
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) then
            local root = getRoot(plr.Character)
            if root then
                local v, onScreen = cam:WorldToScreenPoint(root.Position)
                if onScreen and v.Z > 0 then
                    local d = (Vector2.new(v.X, v.Y) - pos).Magnitude
                    if d < bestD then bestD, best = d, plr end
                end
            end
        end
    end
    if best then
        if Settings.PriorityId == best.UserId then
            setSetting("PriorityId", 0)
            toast("Released " .. best.DisplayName, C.idle, 1.5)
        else
            setSetting("PriorityId", best.UserId)
            toast("Locked on " .. best.DisplayName, C.warn, 1.5)
        end
        refreshPlayers()
    end
end))

