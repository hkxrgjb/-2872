-- [FIX#7] UIScale safety-net: shrink tabs if they overflow
tabsScale = create("UIScale", {}, tabsBar)
do
    local function updateTabsScale()
        local vp = uiLayer.AbsoluteSize
        if vp.Y <= 0 then return end
        local available = vp.Y * 0.9 - 72
        local needed    = 7 * 36 + 6 * 4       -- 7×36 px + gaps
        if needed > available and available > 0 then
            tabsScale.Scale = math.max(available / needed, 0.6)
        else
            tabsScale.Scale = 1
        end
    end
    updateTabsScale()
    track(uiLayer:GetPropertyChangedSignal("AbsoluteSize")
        :Connect(updateTabsScale))
end

