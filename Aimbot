-- ============================================================
-- Adaptive motion tracker (alpha-beta-gamma)
-- ============================================================
local newTracker, trackerUpdate, trackerPredict
do
    local TRK = {
        TAU_STEADY = 0.10, TAU_FAST = 0.03, NOISE = 0.12,
        KV = 0.40, KA = 0.15, ACC_DECAY = 0.50,
        MAX_SPEED = 500, MAX_ACCEL = 400,
        TELE_SPEED = 1200, TELE_MIN = 25,
        MIN_MOVE = 0.001, MIN_DT = 1 / 240, MAX_DT = 0.25, STALE = 0.085,
    }

    function newTracker()
        return {
            init = false, hrp = nil,
            pos = Vector3.zero, vel = Vector3.zero, acc = Vector3.zero,
            time = 0, last = Vector3.zero, rel = 1, man = 0,
        }
    end

    local function trackerSnap(T, pos, vel, now)
        T.pos = pos
        if vel.Magnitude <= TRK.MAX_SPEED then T.vel = vel else T.vel = Vector3.zero end
        T.acc = Vector3.zero
        T.time = now
        T.last = pos
        T.rel = 1
        T.man = 0
        T.init = true
    end

    function trackerUpdate(T, hrp, now)
        local pos = hrp.Position
        local vel = hrp.AssemblyLinearVelocity
        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return end
        if not T.init or T.hrp ~= hrp then
            T.hrp = hrp
            trackerSnap(T, pos, vel, now)
            return
        end
        local moved = (pos - T.last).Magnitude
        local since = now - T.time
        if since > 0.5 then
            trackerSnap(T, pos, vel, now)
            return
        end
        local velMag = vel.Magnitude
        local velOK = velMag <= TRK.MAX_SPEED * 1.5
        if moved < TRK.MIN_MOVE and since < TRK.STALE then
            local stopped = velOK and velMag < 1 and T.vel.Magnitude > 3 and since >= 1 / 120
            if not stopped then return end
        end
        local dt = math.clamp(since, TRK.MIN_DT, TRK.MAX_DT)
        if moved > TRK.TELE_MIN and moved / dt > TRK.TELE_SPEED then
            trackerSnap(T, pos, vel, now)
            return
        end
        local pp = T.pos + T.vel * dt + T.acc * (0.5 * dt * dt)
        local pv = T.vel + T.acc * dt
        local res = pos - pp
        local speed = pv.Magnitude
        local thr = TRK.NOISE + speed * dt * 0.25
        local m = math.clamp((res.Magnitude - thr) / (thr * 3), 0, 1)
        if velOK then
            local vi = (vel - pv).Magnitude
            local thrv = 8 + 0.3 * speed
            local mv = math.clamp((vi - thrv) / (thrv * 2), 0, 1)
            local agree = vi <= math.max(6, 0.4 * speed)
            T.rel = T.rel + ((agree and 1 or 0) - T.rel) * 0.15
            if T.rel > 0.5 then m = math.max(m, mv) end
        end
        T.man = math.max(m, T.man * math.exp(-dt / 0.15))
        local tau = TRK.TAU_STEADY + (TRK.TAU_FAST - TRK.TAU_STEADY) * T.man
        local th = math.exp(-dt / tau)
        local omt = 1 - th
        local g = 1 - th ^ 3
        local h = 1.5 * omt * omt * (1 + th)
        local k = 0.5 * omt ^ 3
        local nPos = pp + res * g
        local nVel = pv + res * (h / dt)
        local nAcc = T.acc + res * (2 * k / (dt * dt))
        if velOK and T.rel > 0.5 then
            local kv = math.min(TRK.KV + 0.4 * T.man, 1)
            nVel = nVel + (vel - nVel) * kv
            local ka = TRK.KA + 0.3 * T.man
            local aMeas = (vel - T.vel) / dt
            nAcc = nAcc + (aMeas - nAcc) * ka
        end
        nAcc = nAcc * math.exp(-dt / TRK.ACC_DECAY)
        local sp = nVel.Magnitude
        if sp > TRK.MAX_SPEED then nVel = nVel * (TRK.MAX_SPEED / sp) end
        local ac = nAcc.Magnitude
        if ac > TRK.MAX_ACCEL then nAcc = nAcc * (TRK.MAX_ACCEL / ac) end
        T.pos, T.vel, T.acc = nPos, nVel, nAcc
        T.time = now
        T.last = pos
    end

    function trackerPredict(T, now, lead)
        local d = math.clamp((now - T.time) + lead, 0, 0.6)
        if Settings.PredModel == "Linear" then return T.pos + T.vel * d end
        return T.pos + T.vel * d + T.acc * (0.5 * d * d)
    end
end

local aimTracker = newTracker()

-- ============================================================
-- Critically-damped spring for buttery aim
-- ============================================================
local SpringAim = {
    pos = Vector3.zero,
    vel = Vector3.zero,
    initialized = false,
}

local function springSnap(pos)
    SpringAim.pos = pos
    SpringAim.vel = Vector3.zero
    SpringAim.initialized = true
end

local function springReset()
    SpringAim.initialized = false
end

local function springUpdate(target, dt)
    if not SpringAim.initialized then
        springSnap(target)
        return target
    end
    dt = math.clamp(dt, 0.001, 0.1)
    local omega = 2 * math.pi * Settings.SpringFreq
    local zeta = math.max(Settings.SpringDamping, 1.0)
    local disp = SpringAim.pos - target
    if zeta >= 1.0 then
        local expTerm = math.exp(-omega * dt)
        local temp = (SpringAim.vel + omega * disp) * dt
        SpringAim.pos = target + (disp + temp) * expTerm
        SpringAim.vel = (SpringAim.vel - omega * temp) * expTerm
    else
        local omegaD = omega * math.sqrt(1 - zeta * zeta)
        local expTerm = math.exp(-zeta * omega * dt)
        local cosT = math.cos(omegaD * dt)
        local sinT = math.sin(omegaD * dt)
        SpringAim.pos = target + expTerm * (disp * cosT + ((SpringAim.vel + zeta * omega * disp) / omegaD) * sinT)
        SpringAim.vel = expTerm * (SpringAim.vel * cosT - (SpringAim.vel * zeta * omega / omegaD + disp * omegaD + zeta * omega * (SpringAim.vel + zeta * omega * disp) / omegaD) * sinT)
    end
    return SpringAim.pos
end

-- Transition blend state
local transBlend = {active = false, from = Vector3.zero, start = 0, dur = 0.12}

local function beginTransition(fromPos)
    transBlend.active = true
    transBlend.from = fromPos
    transBlend.start = os.clock()
    transBlend.dur = math.max(Settings.TransitionBlend, 0.04)
end

local function getTransitionWeight(now)
    if not transBlend.active then return 1.0 end
    local elapsed = now - transBlend.start
    if elapsed >= transBlend.dur then
        transBlend.active = false
        return 1.0
    end
    local t = elapsed / transBlend.dur
    return 1 - (1 - t) ^ 3
end

-- ============================================================
-- Aim math
-- ============================================================
local function screenDistance(worldPos)
    local cam = camera()
    local v, onScreen = cam:WorldToViewportPoint(worldPos)
    if not onScreen or v.Z <= 0 then return nil end
    return (Vector2.new(v.X, v.Y) - cam.ViewportSize / 2).Magnitude
end

local function solveLead(T, now, origin, rootPos)
    local ping = getPing() * Settings.PingComp
    local speed = Settings.BulletSpeed
    if speed <= 0 then
        return math.clamp(ping, 0, 0.6), 0
    end
    local flight = (rootPos - origin).Magnitude / speed * Settings.PredAmount
    for _ = 1, 3 do
        local p = trackerPredict(T, now, math.clamp(flight + ping, 0, 0.6))
        flight = (p - origin).Magnitude / speed * Settings.PredAmount
    end
    return math.clamp(flight + ping, 0, 0.6), flight
end

local function computeLeadOffset(root, hum, now)
    local cam = camera()
    local origin = cam.CFrame.Position
    local lead, flight = 0, 0
    local predicting = Settings.Prediction and aimTracker.init
    if predicting then
        lead, flight = solveLead(aimTracker, now, origin, root.Position)
    elseif Settings.BulletSpeed > 0 then
        flight = (root.Position - origin).Magnitude / Settings.BulletSpeed
    end
    local drop = 0.5 * Settings.BulletGravity * flight * flight
    diag.lead, diag.drop = lead, drop
    if not predicting then return Vector3.zero, drop end
    local offset = trackerPredict(aimTracker, now, lead) - root.Position
    local airborne = (not hum) or hum.FloorMaterial == Enum.Material.Air
    if not airborne then offset = Vector3.new(offset.X, 0, offset.Z) end
    if offset.Magnitude > 40 then offset = offset.Unit * 40 end
    return offset, drop
end

local function getAimPosition(part, offset, drop)
    local cam = camera()
    drop = drop or 0
    local pos = part.Position + (offset or Vector3.zero)
    local dist = (part.Position - cam.CFrame.Position).Magnitude
    pos = pos + Vector3.new(0, dist * Settings.DynamicOffset + drop, 0)
    local maxY = part.Position.Y + 15 + drop
    if pos.Y > maxY then pos = Vector3.new(pos.X, maxY, pos.Z) end
    return pos
end

-- ============================================================
-- v8.5 Smooth camera aim (spring + transition blend)
-- ============================================================
local lastAimLook = nil
local yieldUntil = 0

local function aimCamera(aimPos, base, dt, now, assist, aimVelocity)
    local cam = camera()
    if not cam then return end
    local camCF = cam.CFrame
    local camPos = camCF.Position
    local toAim = aimPos - camPos
    local dist = toAim.Magnitude
    if dist < 1 then return end
    local look = camCF.LookVector

    if assist and Settings.YieldToInput and lastAimLook then
        if look:Cross(lastAimLook).Magnitude > 0.004 then
            yieldUntil = now + 0.15
        end
    end

    if assist and base <= 0.001 then return end

    local dir = toAim.Unit
    local preFFAngle = math.deg(math.atan2(look:Cross(dir).Magnitude, look:Dot(dir)))

    -- Init spring from current camera aim point
    local currentAimPoint = camPos + look * dist
    if not SpringAim.initialized then
        springSnap(currentAimPoint)
    end

    -- Transition blend
    if transBlend.active then
        local w = getTransitionWeight(now)
        aimPos = transBlend.from:Lerp(aimPos, w)
    end

    -- Dynamic frequency
    local b = math.clamp(base, 0, 1)
    if assist and Settings.AdaptiveSmooth then
        b = b * math.clamp(0.35 + preFFAngle / 12, 0.35, 1)
    end
    if now < yieldUntil then b = b * Settings.YieldAmount end

    local freqMult = math.clamp(0.3 + b * 2.2, 0.3, 2.5)
    if assist and Settings.SnapOnAcquire and now < acquireBoostUntil then
        freqMult = math.min(4.0, freqMult * 2.0 + 0.5)
    end

    local savedFreq = Settings.SpringFreq
    Settings.SpringFreq = savedFreq * freqMult
    local springPos = springUpdate(aimPos, dt)
    Settings.SpringFreq = savedFreq

    -- Feed-forward
    local ffAxis, ffAngle = nil, 0
    if assist and aimVelocity and Settings.TrackingGain > 0 and now >= yieldUntil then
        local dirToTarget = toAim.Unit
        local radial = aimVelocity:Dot(dirToTarget)
        local tangential = aimVelocity - dirToTarget * radial
        local tangentialSpeed = tangential.Magnitude
        if tangentialSpeed > 0.05 then
            local axis = dirToTarget:Cross(tangential)
            if axis.Magnitude > 1e-5 then
                ffAxis = axis.Unit
                local angularRate = tangentialSpeed / dist
                ffAngle = math.clamp(angularRate * Settings.TrackingGain * dt, -math.rad(10), math.rad(10))
                diag.ff = math.deg(ffAngle) / math.max(dt, 1e-4)
            end
        end
    end

    -- Deadzone
    local aimDir = springPos - camPos
    if aimDir.Magnitude < 1 then return end
    local aimUnit = aimDir.Unit
    local angle = math.deg(math.atan2(look:Cross(aimUnit).Magnitude, look:Dot(aimUnit)))

    if assist and angle < Settings.Deadzone and SpringAim.vel.Magnitude < 0.15 and math.abs(ffAngle) < 0.0005 then
        cam.CFrame = camCF
        lastAimLook = look
        return
    end

    local newCF = CFrame.new(camPos, springPos)
    if ffAxis and ffAngle ~= 0 then
        local newLook = (CFrame.fromAxisAngle(ffAxis, ffAngle) * newCF.LookVector).Unit
        newCF = CFrame.new(camPos, camPos + newLook)
    end

    cam.CFrame = newCF
    lastAimLook = newCF.LookVector
end

