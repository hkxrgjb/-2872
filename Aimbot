function setSetting(key, value)
    if Settings[key] == value then return end
    Settings[key] = value
    saveDirty = true
    Kernel.emit("set:" .. key, value)
    Kernel.emit("set", key, value)
end

function onChange(key, fn)
    track(Kernel.on("set:" .. key, fn))
end

function resetSection(sectionName)
    local keys = SECTION_KEYS[sectionName]
    if not keys then return end
    for _, key in ipairs(keys) do
        if DEFAULTS[key] ~= nil and type(DEFAULTS[key]) ~= "table" then
