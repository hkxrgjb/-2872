RunService.RenderStepped:Connect(function(deltaTime)
    if not FOVCircle then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Thickness = 1.5; FOVCircle.NumSides = 60
        FOVCircle.Transparency = 0.6; FOVCircle.Color = Color3.fromRGB(0, 170, 255); FOVCircle.Filled = false
    end
    FOVCircle.Visible = S.ShowFOV and S.Enabled
    if FOVCircle.Visible then
        FOVCircle.Position = Vector2.new(WS.CurrentCamera.ViewportSize.X/2, WS.CurrentCamera.ViewportSize.Y/2)
        FOVCircle.Radius = S.FOV
    end
    
    if not S.Enabled then
        statusBar.Text = "🎯 Aimbot: OFF"
        return
    end

    if not isKilling then
        if Locked and alive(Locked) and not isMate(Locked) then
            Target = Locked
        else
            Locked = nil
            Target = getTarget()
        end

        if Target then
            doAim(Target, deltaTime)
            statusBar.Text = "🎯 " .. Target.Name .. "  |  " .. TargetPartName
            statusBar.TextColor3 = Color3.fromRGB(0, 190, 255)
        else
            statusBar.Text = "🎯 Searching for target..."
            statusBar.TextColor3 = Color3.fromRGB(120, 120, 120)
        end
    end
end)
