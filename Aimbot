    local function buildPlayerRow(plr)
        local frame = create("Frame", {
            Name = plr.Name,
            Size = UDim2.new(1, 0, 0, 44),
            BackgroundColor3 = C.row,
            BorderSizePixel = 0,
        }, listHolder)
        round(frame, 9)
        local nameLbl = create("TextLabel", {
            Size = UDim2.new(1, -172, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Text = plr.DisplayName,
            TextColor3 = C.text,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, frame)
        local ignBtn  = miniIconButton("block",  -6);   ignBtn.Parent  = frame
        local wlBtn   = miniIconButton("shield", -46);  wlBtn.Parent   = frame
        local prioBtn = miniIconButton("star",   -86);  prioBtn.Parent = frame
        local killBtn = miniIconButton("skull",  -126); killBtn.Parent = frame

        prioBtn.MouseButton1Click:Connect(function()
            setSetting("PriorityId",
                (Settings.PriorityId == plr.UserId)
                and 0 or plr.UserId)
            refreshPlayers()
        end)
        wlBtn.MouseButton1Click:Connect(function()
            toggleWhitelist(plr)
            refreshPlayers()
        end)
        ignBtn.MouseButton1Click:Connect(function()
            toggleIgnore(plr)
            refreshPlayers()
        end)
        killBtn.MouseButton1Click:Connect(function()
            confirmDialog(
                string.format(L("fmtConfirmKill"),
                              plr.DisplayName),
                function() startSingleKill(plr) end, true)
        end)
        frame.InputBegan:Connect(function(i)
            if not isPointer(i) then return end
            local zoneRight = frame.AbsolutePosition.X
                            + frame.AbsoluteSize.X - 168
            if i.Position.X > zoneRight then return end
            local now = os.clock()
            if (rowLastTap[plr.UserId] or 0) > now - 0.35 then
                rowLastTap[plr.UserId] = 0
                toggleIgnore(plr)
                refreshPlayers()
            else
                rowLastTap[plr.UserId] = now
            end
        end)
        return { frame=frame, name=nameLbl, prio=prioBtn,
                 wl=wlBtn, ign=ignBtn, kill=killBtn }
    end

    refreshPlayers = function()
        for plr, row in pairs(playerRows) do
            if not plr.Parent then
                row.frame:Destroy()
                playerRows[plr] = nil
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local row = playerRows[plr]
                if not row then
                    row = buildPlayerRow(plr)
                    playerRows[plr] = row
                end
                local hum = plr.Character
                    and plr.Character:FindFirstChildOfClass("Humanoid")
                local alive = hum ~= nil and hum.Health > 0
                local base = plr.DisplayName
                if isIgnored(plr) then
                    base = L("prefixIgnore") .. base
                end
                if alive then
                    local pct = math.floor(
                        hum.Health / math.max(hum.MaxHealth, 1) * 100)
                    row.name.Text =
                        string.format(L("fmtPlayerHP"), base, pct)
                else
                    row.name.Text =
                        string.format(L("fmtPlayerDead"), base)
                end
                row.prio.BackgroundColor3 =
                    (Settings.PriorityId == plr.UserId)
                    and C.warn or C.bar
                row.wl.BackgroundColor3 =
                    isWhitelisted(plr) and C.good or C.bar
                row.ign.BackgroundColor3 =
                    isIgnored(plr) and C.bad or C.bar
                row.kill.BackgroundColor3 =
                    alive and Color3.fromRGB(190,55,55) or C.bar
            end
        end
