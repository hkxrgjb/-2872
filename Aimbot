-- Settings + saved config
-- ============================================================
local function deepCopy(t)
    local r = {}
    for k, v in pairs(t) do
        r[k] = (type(v) == "table") and deepCopy(v) or v
    end
    return r
end

local DEFAULTS = {
    -- core
    Enabled = true, AutoAim = true, AutoFire = false, Sticky = true,
    WallCheck = true, TeamCheck = true, IgnoreFriends = false,
    SmartBone = true, TargetPart = "Head", TargetMode = "Crosshair",
    -- aim
    FOV = 160, Smoothness = 0.2, Strength = 0.85, MaxDistance = 1000,
    -- prediction
    Prediction = true, PredAmount = 1.0, BulletSpeed = 1500, PingComp = 0.0, DynamicOffset = 0.02,
    -- auto fire
    FireDelay = 0.12, TriggerRadius = 22,
    -- visuals
    ESP = false, ESPNames = true, ESPOutline = true, ShowFOV = true,
    -- interface
    ShowHUD = true, ShowChips = true, UIScale = 1.0, PerfMode = false,
    -- kill orbit
    KillRadius = 8, KillHeight = 7, KillSpeed = 400,
    -- players
    PriorityId = 0, Whitelist = {},
}

local Settings = deepCopy(DEFAULTS)

local CONFIG_FILE = "ProAimbot_v3.json"
local saveDirty = false

local function saveConfig()
    if not writefile then return false end
    local ok = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(Settings))
    end)
    if ok then saveDirty = false end
    return ok
end

local function loadConfig()
    if not (readfile and isfile) then return end
    pcall(function()
        if not isfile(CONFIG_FILE) then return end
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        if type(data) ~= "table" then return end
        for k, v in pairs(data) do
            if DEFAULTS[k] ~= nil and type(v) == type(DEFAULTS[k]) then
                if k == "Whitelist" then
                    local clean = {}
                    for _, id in ipairs(v) do
                        if type(id) == "number" then table.insert(clean, id) end
                    end
                    Settings[k] = clean
                else
                    Settings[k] = v
                end
            end
        end
    end)
end
loadConfig()

-- Change notifications so every control (menu, quick buttons) stays in sync
local listeners = {}
local function onChange(key, fn)
    listeners[key] = listeners[key] or {}
    table.insert(listeners[key], fn)
end

local function setSetting(key, value)
    if Settings[key] == value then return end
    Settings[key] = value
    saveDirty = true
    local list = listeners[key]
    if list then
        for _, fn in ipairs(list) do fn(value) end
    end
end

