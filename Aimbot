onChange("RadarSize", function(v) radarFrame.Size = UDim2.fromOffset(v, v) end)

local radarDots = {}
local lastRadar = 0

local function getRadarDot(plr)
    local d = radarDots[plr]
    if not d then
        d = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(7, 7), BorderSizePixel = 0,
        }, radarFrame)
        circle(d)
        radarDots[plr] = d
    end
    return d
end

function updateRadar(now, perf)
    if not Settings.Radar then return end
    if perf and now - lastRadar < 0.1 then return end
    lastRadar = now

    for plr, d in pairs(radarDots) do
        if not plr.Parent then
            d:Destroy()
            radarDots[plr] = nil
        end
    end

    local cam = camera()
    local myRoot = getRoot(LocalPlayer.Character)
    if not cam or not myRoot then return end
    local look = cam.CFrame.LookVector
    local fwd = Vector3.new(look.X, 0, look.Z)
    if fwd.Magnitude < 0.01 then return end
    fwd = fwd.Unit
    local right = Vector3.new(-fwd.Z, 0, fwd.X)
    local radius = Settings.RadarSize / 2 - 6
    local range = math.max(Settings.RadarRange, 10)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local root = isAlive(plr) and getRoot(plr.Character) or nil
            if root then
                local rel = root.Position - myRoot.Position
                local px = rel:Dot(right) / range * radius
                local py = -rel:Dot(fwd) / range * radius
                local mag = math.sqrt(px * px + py * py)
                local outside = mag > radius
                if outside then px, py = px / mag * radius, py / mag * radius end

                local c
                if plr == CurrentTarget then
                    c = C.white
                elseif plr.UserId == Settings.PriorityId then
                    c = C.warn
                elseif isWhitelisted(plr) then
                    c = C.idle
                elseif plr.Team ~= nil and plr.Team == LocalPlayer.Team then
                    c = C.accent
                else
                    c = C.bad
                end

                local dot = getRadarDot(plr)
                dot.Visible = true
                dot.Position = UDim2.new(0.5, px, 0.5, py)
                dot.BackgroundColor3 = c
                dot.BackgroundTransparency = outside and 0.5 or 0
            else
                local dot = radarDots[plr]
                if dot then dot.Visible = false end
            end
        end
    end
end

