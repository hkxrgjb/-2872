-- Screen boundary clamping helper
local function clampToScreen(frame, pos)
    local vp = frame.Parent and frame.Parent.AbsoluteSize or Vector2.new(400, 800)
    local halfW = math.max(frame.AbsoluteSize.X / 2, 24)
    local halfH = math.max(frame.AbsoluteSize.Y / 2, 24)
    local margin = 8
    local x = math.clamp(pos.X, halfW + margin, vp.X - halfW - margin)
    local y = math.clamp(pos.Y, halfH + margin, vp.Y - halfH - margin)
    return Vector2.new(x, y)
end

-- Pointer capture
local captures = {}
local function isPointer(i)
    return i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1
end

local function beginCapture(input, onMove, onEnd)
    table.insert(captures, { input = input, onMove = onMove, onEnd = onEnd })
end

local function captureMatches(c, i, ended)
    if c.input.UserInputType == Enum.UserInputType.Touch then
        return i == c.input
    end
    if ended then return i.UserInputType == Enum.UserInputType.MouseButton1 end
    return i.UserInputType == Enum.UserInputType.MouseMovement
end

track(UserInputService.InputChanged:Connect(function(i)
    for _, c in ipairs(captures) do
        if c.onMove and captureMatches(c, i, false) then c.onMove(i.Position) end
    end
end))

track(UserInputService.InputEnded:Connect(function(i)
    for idx = #captures, 1, -1 do
        local c = captures[idx]
        if captureMatches(c, i, true) then
            table.remove(captures, idx)
            if c.onEnd then c.onEnd() end
        end
    end
end))

-- Drag with strict screen boundaries and tap detection
local function makeDraggable(frame, handle, onDown, onUp, posKey)
    handle.InputBegan:Connect(function(i)
        if not isPointer(i) then return end
        local startInput = Vector2.new(i.Position.X, i.Position.Y)
        local startCenter = frame.AbsolutePosition + frame.AbsoluteSize / 2
        local moved = false
        if onDown then onDown() end
        beginCapture(i, function(pos)
            local d = Vector2.new(pos.X, pos.Y) - startInput
            if d.Magnitude > 10 then moved = true end
            if moved and frame.Parent then
                local targetPos = startCenter + d
                local clamped = clampToScreen(frame, targetPos)
                frame.Position = UDim2.fromOffset(clamped.X, clamped.Y)
            end
        end, function()
            if moved and posKey and frame.Parent then
                local vp = frame.Parent.AbsoluteSize
                if vp.X > 0 and vp.Y > 0 then
                    Settings.HudPos[posKey] = { frame.Position.X.Offset / vp.X, frame.Position.Y.Offset / vp.Y }
                    saveDirty = true
                end
            end
            if onUp then onUp(not moved) end
        end)
    end)
end

local function applySavedPos(frame, key)
    local p = Settings.HudPos[key]
    if type(p) == "table" and type(p[1]) == "number" and type(p[2]) == "number" then
        local vp = frame.Parent and frame.Parent.AbsoluteSize or Vector2.new(400, 800)
        local x = math.clamp(p[1] * vp.X, 30, vp.X - 30)
        local y = math.clamp(p[2] * vp.Y, 30, vp.Y - 30)
        frame.Position = UDim2.fromOffset(x, y)
    end
end

