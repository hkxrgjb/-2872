function resolveBone(char, name)
    if name == "Torso" then
        return char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild(name)
end

BONE_ORDER_NEAR = { "Head", "UpperTorso", "Torso", "HumanoidRootPart" }
BONE_ORDER_FAR  = { "UpperTorso", "Torso", "Head", "HumanoidRootPart" }

function getBestPart(plr)
    local char = plr and plr.Character
    if not char then return nil end
    if Settings.SmartBone then
        local order = BONE_ORDER_NEAR
        local limit = Settings.AutoBoneDistance
        if limit > 0 then
            local root = char:FindFirstChild("HumanoidRootPart")
            local cam  = camera()
            if root and cam
                and (root.Position - cam.CFrame.Position).Magnitude > limit
            then
                order = BONE_ORDER_FAR
            end
        end
        for _, name in ipairs(order) do
            local p = char:FindFirstChild(name)
            if p and hasLineOfSight(p) then return p end
        end
        return nil
    end
    local p = resolveBone(char, Settings.TargetPart)
    if p and hasLineOfSight(p) then return p end
    return nil
end

-- =====================================================================
-- CRITICALLY-DAMPED SPRING  [FIX#1] global
-- =====================================================================
SpringSystem = {}
SpringSystem.__index = SpringSystem

function SpringSystem.new(freq, damping)
    local self   = setmetatable({}, SpringSystem)
    self.Freq    = freq or 8.0
    self.Damping = damping or 1.0
    self.Pos     = Vector3.zero
    self.Vel     = Vector3.zero
    self.Target  = Vector3.zero
    self.Initialized = false
    return self
end

function SpringSystem:SetTarget(target)
    self.Target = target
    if not self.Initialized then
        self.Pos  = target
        self.Vel  = Vector3.zero
        self.Initialized = true
    end
end

function SpringSystem:Snap(pos)
    self.Pos     = pos
    self.Vel     = Vector3.zero
    self.Target  = pos
    self.Initialized = true
end

function SpringSystem:Step(dt)
    local omega    = 2 * math.pi * self.Freq
    local zeta     = math.max(self.Damping, 1.0)
    local effOmega = (zeta > 1) and (omega / zeta) or omega
    local disp     = self.Pos - self.Target
    local expTerm  = math.exp(-effOmega * dt)
    local temp     = (self.Vel + effOmega * disp) * dt
    self.Pos = self.Target + (disp + temp) * expTerm
    self.Vel = (self.Vel - effOmega * temp) * expTerm
end

function SpringSystem:Update(dt)
    if not self.Initialized then return self.Pos end
    dt = math.clamp(dt, 0.001, 0.1)
    local steps = math.clamp(math.ceil(dt / (1/120)), 1, 8)
    local h = dt / steps
    for _ = 1, steps do self:Step(h) end
    return self.Pos
end

aimSpring = SpringSystem.new(Settings.SpringFreq, Settings.SpringDamping)
onChange("SpringFreq",    function(v) aimSpring.Freq    = v end)
onChange("SpringDamping", function(v) aimSpring.Damping = v end)

-- =====================================================================
-- ADAPTIVE KINEMATIC TRACKER  [FIX#1] global
-- =====================================================================
newTracker      = nil
trackerUpdate   = nil
trackerPredict  = nil
do
    local TRK = {
        TAU_STEADY=0.10, TAU_FAST=0.03, NOISE=0.12,
        KV=0.40, KA=0.15, ACC_DECAY=0.50,
        MAX_SPEED=500, MAX_ACCEL=400,
        TELE_SPEED=1200, TELE_MIN=25,
        MIN_MOVE=0.001, MIN_DT=1/240, MAX_DT=0.25, STALE=0.085,
    }

    function newTracker()
        return {
            init=false, hrp=nil,
            pos=Vector3.zero, vel=Vector3.zero, acc=Vector3.zero,
            time=0, last=Vector3.zero, rel=1, man=0,
        }
    end

    local function trackerSnap(T, pos, vel, now)
        T.pos = pos
        if vel.Magnitude <= TRK.MAX_SPEED then T.vel = vel
        else T.vel = Vector3.zero end
        T.acc   = Vector3.zero
        T.time  = now
        T.last  = pos
        T.rel   = 1
        T.man   = 0
        T.init  = true
    end

    function trackerUpdate(T, hrp, now)
        local pos = hrp.Position
        local vel = hrp.AssemblyLinearVelocity
        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return end
        if not T.init or T.hrp ~= hrp then
            T.hrp = hrp
            trackerSnap(T, pos, vel, now)
            return
        end
        local moved = (pos - T.last).Magnitude
        local since = now - T.time
        if since > 0.5 then
            trackerSnap(T, pos, vel, now)
            return
        end
        local velMag = vel.Magnitude
        local velOK  = velMag <= TRK.MAX_SPEED * 1.5
        if moved < TRK.MIN_MOVE and since < TRK.STALE then
            local stopped = velOK and velMag < 1
                and T.vel.Magnitude > 3 and since >= 1/120
            if not stopped then return end
        end
        local dt = math.clamp(since, TRK.MIN_DT, TRK.MAX_DT)
        if moved > TRK.TELE_MIN and moved / dt > TRK.TELE_SPEED then
            trackerSnap(T, pos, vel, now)
            return
        end
        local pp = T.pos + T.vel*dt + T.acc*(0.5*dt*dt)
        local pv = T.vel + T.acc*dt
        local res = pos - pp
        local speed = pv.Magnitude
        local thr = TRK.NOISE + speed * dt * 0.25
        local m = math.clamp((res.Magnitude - thr) / (thr*3), 0, 1)
        if velOK then
            local vi   = (vel - pv).Magnitude
            local thrv = 8 + 0.3 * speed
            local mv   = math.clamp((vi - thrv) / (thrv*2), 0, 1)
            local agree = vi <= math.max(6, 0.4 * speed)
            T.rel = T.rel + ((agree and 1 or 0) - T.rel) * 0.15
            if T.rel > 0.5 then m = math.max(m, mv) end
        end
        T.man = math.max(m, T.man * math.exp(-dt / 0.15))
        local tau = TRK.TAU_STEADY + (TRK.TAU_FAST - TRK.TAU_STEADY) * T.man
        local th  = math.exp(-dt / tau)
        local omt = 1 - th
        local g = 1 - th^3
        local h = 1.5 * omt * omt * (1 + th)
        local k = 0.5 * omt^3
        local nPos = pp + res * g
        local nVel = pv + res * (h / dt)
        local nAcc = T.acc + res * (2 * k / (dt*dt))
        if velOK and T.rel > 0.5 then
            local kv = math.min(TRK.KV + 0.4*T.man, 1)
            nVel = nVel + (vel - nVel) * kv
            local ka = TRK.KA + 0.3 * T.man
            local aMeas = (vel - T.vel) / dt
            nAcc = nAcc + (aMeas - nAcc) * ka
        end
        nAcc = nAcc * math.exp(-dt / TRK.ACC_DECAY)
        local sp = nVel.Magnitude
        if sp > TRK.MAX_SPEED then
            nVel = nVel * (TRK.MAX_SPEED / sp)
        end
        local ac = nAcc.Magnitude
        if ac > TRK.MAX_ACCEL then
            nAcc = nAcc * (TRK.MAX_ACCEL / ac)
        end
        T.pos, T.vel, T.acc = nPos, nVel, nAcc
        T.time = now
        T.last = pos
    end

    function trackerPredict(T, now, lead)
        local d = math.clamp((now - T.time) + lead, 0, 0.6)
        if Settings.PredModel == "Linear" then
            return T.pos + T.vel * d
        end
        return T.pos + T.vel*d + T.acc*(0.5*d*d)
    end
end

aimTracker = newTracker()

-- =====================================================================
-- TARGET TRANSITION BLENDER  [FIX#1] global
-- =====================================================================
transitionState = {
    active    = false,
    startTime = 0,
    fromPos   = Vector3.zero,
    duration  = Settings.TransitionBlend,
}

function beginTransition(fromPos)
    transitionState.active    = true
    transitionState.startTime = os.clock()
    transitionState.fromPos   = fromPos
    transitionState.duration  = math.max(Settings.TransitionBlend, 0.04)
end

function getTransitionWeight(now)
    if not transitionState.active then return 1.0 end
    local elapsed = now - transitionState.startTime
    if elapsed >= transitionState.duration then
        transitionState.active = false
        return 1.0
    end
    local t = elapsed / transitionState.duration
    return 1 - (1 - t)^3
end

-- =====================================================================
-- Aim math  [FIX#1] global
-- =====================================================================
function screenDistance(worldPos)
    local cam = camera()
    local v, onScreen = cam:WorldToViewportPoint(worldPos)
    if not onScreen or v.Z <= 0 then return nil end
    return (Vector2.new(v.X, v.Y) - cam.ViewportSize / 2).Magnitude
end

function solveLead(T, now, origin, rootPos)
    local ping  = getPing() * Settings.PingComp
    local speed = Settings.BulletSpeed
    if speed <= 0 then
        return math.clamp(ping, 0, 0.6), 0
    end
    local flight = (rootPos - origin).Magnitude / speed * Settings.PredAmount
    for _ = 1, 3 do
        local p = trackerPredict(T, now,
                    math.clamp(flight + ping, 0, 0.6))
        flight = (p - origin).Magnitude / speed * Settings.PredAmount
    end
    return math.clamp(flight + ping, 0, 0.6), flight
end

function computeLeadOffset(root, hum, now)
    local cam    = camera()
    local origin = cam.CFrame.Position
    local lead, flight = 0, 0
    local predicting = Settings.Prediction and aimTracker.init
    if predicting then
        lead, flight = solveLead(aimTracker, now, origin, root.Position)
    elseif Settings.BulletSpeed > 0 then
        flight = (root.Position - origin).Magnitude / Settings.BulletSpeed
    end
    local drop = 0.5 * Settings.BulletGravity * flight * flight
    diag.lead, diag.drop = lead, drop
    if not predicting then return Vector3.zero, drop end
    local offset = trackerPredict(aimTracker, now, lead) - root.Position
    local airborne = (not hum) or hum.FloorMaterial == Enum.Material.Air
    if not airborne then offset = Vector3.new(offset.X, 0, offset.Z) end
    if offset.Magnitude > 40 then offset = offset.Unit * 40 end
    return offset, drop
end

function getAimPosition(part, offset, drop)
    local cam  = camera()
    drop = drop or 0
    local pos  = part.Position + (offset or Vector3.zero)
    local dist = (part.Position - cam.CFrame.Position).Magnitude
    pos = pos + Vector3.new(0, dist * Settings.DynamicOffset + drop, 0)
    local maxY = part.Position.Y + 15 + drop
    if pos.Y > maxY then pos = Vector3.new(pos.X, maxY, pos.Z) end
    return pos
end

function applyResponseCurve(b)
    local curve = Settings.ResponseCurve
    if curve == "EaseOut" then return 1 - (1 - b)^2
    elseif curve == "Snap" then return b ^ 0.5 end
    return b
end

-- =====================================================================
-- SPRING-BASED CAMERA AIM  [FIX#1] global
-- =====================================================================
lastAimLook    = nil
yieldUntil     = 0
lastTransStart = 0

function smoothAimCamera(aimPos, base, dt, now, assist, aimVelocity)
    local cam = camera()
    if not cam then return end
    local camCF  = cam.CFrame
    local camPos = camCF.Position
    local toAim  = aimPos - camPos
    local dist   = toAim.Magnitude
    if dist < 1 then return end
    local look = camCF.LookVector
    if assist and base <= 0.001 then return end

    local manualCross = 0
    if assist and lastAimLook then
        manualCross = look:Cross(lastAimLook).Magnitude
        if Settings.YieldToInput and manualCross > 0.004 then
            yieldUntil = now + 0.15
        end
    end

    local dir = toAim.Unit
    local preFFAngle = math.deg(math.atan2(
        look:Cross(dir).Magnitude, look:Dot(dir)))
    local currentAimPoint = camPos + look * dist

    if transitionState.active
        and transitionState.startTime ~= lastTransStart
    then
        lastTransStart = transitionState.startTime
        transitionState.fromPos = currentAimPoint
    end

    if not aimSpring.Initialized then
        aimSpring:Snap(currentAimPoint)
    end

    local finalTarget = aimPos
    if transitionState.active then
        local w = getTransitionWeight(now)
        finalTarget = transitionState.fromPos:Lerp(aimPos, w)
    end

    local b = math.clamp(base, 0, 1)
    if assist and Settings.AdaptiveSmooth then
        b = b * math.clamp(0.35 + preFFAngle / 12, 0.35, 1)
    end
    local flicking = manualCross > 0.03
    if now < yieldUntil
        and not (Settings.FlickAssist and flicking)
    then
        b = b * Settings.YieldAmount
    end
    b = applyResponseCurve(b)

    local freqMult = math.clamp(0.3 + b * 2.2, 0.3, 2.5)
    if assist and Settings.FlickAssist and flicking then
        freqMult = freqMult + 1.4
    end
    if assist and Settings.SnapOnAcquire
        and now < acquireBoostUntil
    then
        freqMult = math.min(4.0, freqMult * 2.0 + 0.5)
    end

    aimSpring.Freq    = Settings.SpringFreq * freqMult
    aimSpring.Damping = math.max(Settings.SpringDamping, 1.0)
    aimSpring:SetTarget(finalTarget)
    local springPos = aimSpring:Update(dt)
    local aimDir    = springPos - camPos
    if aimDir.Magnitude < 1 then return end
    local aimUnit = aimDir.Unit
    local angle = math.deg(math.atan2(
        look:Cross(aimUnit).Magnitude, look:Dot(aimUnit)))

    local ffAxis, ffAngle = nil, 0
    if assist and aimVelocity and Settings.TrackingGain > 0
        and now >= yieldUntil
    then
        local radial      = aimVelocity:Dot(dir)
        local tangential  = aimVelocity - dir * radial
        local tangSpeed   = tangential.Magnitude
        if tangSpeed > 0.05 then
            local axis = dir:Cross(tangential)
            if axis.Magnitude > 1e-5 then
                ffAxis = axis.Unit
                local angularRate = tangSpeed / dist
                ffAngle = math.clamp(
                    angularRate * Settings.TrackingGain * dt,
                    -math.rad(10), math.rad(10))
                diag.ff = math.deg(ffAngle) / math.max(dt, 1e-4)
            end
        end
    end

    if assist and angle < Settings.Deadzone
        and aimSpring.Vel.Magnitude < 0.15
        and math.abs(ffAngle) < 0.0005
    then
        cam.CFrame   = camCF
        lastAimLook  = look
        return
    end

    local newCF = CFrame.new(camPos, springPos)
    if ffAxis and ffAngle ~= 0 then
        local newLook = (CFrame.fromAxisAngle(ffAxis, ffAngle)
                         * newCF.LookVector).Unit
        newCF = CFrame.new(camPos, camPos + newLook)
    end
    cam.CFrame  = newCF
    lastAimLook = newCF.LookVector
end

