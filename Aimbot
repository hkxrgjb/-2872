                    for _, id in ipairs(Settings[key]) do
                        if type(id) == wantType then
                            table.insert(clean, id)
                        end
                    end
                end
                Settings[key] = clean
            end
            cleanList("Whitelist", "number")
            cleanList("Ignore",    "number")
            cleanList("ChipOrder", "string")
            if type(Settings.ChipEnabled) ~= "table" then Settings.ChipEnabled = {} end
            if type(Settings.HudPos)     ~= "table" then Settings.HudPos      = {} end
