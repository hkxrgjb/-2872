local function saveConfig()
    if not writefile then return false end
    local ok = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(Settings))
    end)
    if ok then saveDirty = false end
    return ok
end

do
local function loadConfig()
    if not (readfile and isfile) then return end
    pcall(function()
        local file = CONFIG_FILE
        if not isfile(file) then
            -- migrate settings from an older version
            if isfile("ProAimbot_v5.json") then
                file = "ProAimbot_v5.json"
            elseif isfile("ProAimbot_v4.json") then
                file = "ProAimbot_v4.json"
            else
                return
            end
        end
        local data = HttpService:JSONDecode(readfile(file))
        if type(data) ~= "table" then return end
        for k, v in pairs(data) do
            if DEFAULTS[k] ~= nil and type(v) == type(DEFAULTS[k]) then
                if k == "Whitelist" then
                    local clean = {}
                    for _, id in ipairs(v) do
                        if type(id) == "number" then table.insert(clean, id) end
                    end
                    Settings[k] = clean
                else
                    Settings[k] = v
                end
            end
        end
    end)
end
loadConfig()
end

