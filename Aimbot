-- Settings search: filters every control by its label across all tabs
local searchItems, sections, sectionByBody = {}, {}, {}

local function registerSearch(row, text, parent)
    local item = { row = row, text = string.lower(text) }
    table.insert(searchItems, item)
    local sec = sectionByBody[parent]
    if sec then table.insert(sec.items, item) end
end

local function runSearch(query)
    query = string.lower(query or "")
    if query == "" then
        for _, it in ipairs(searchItems) do it.row.Visible = true end
        for _, sec in ipairs(sections) do
            sec.wrap.Visible = true
            sec.body.Visible = sec.expanded
            sec.arrow.Text = sec.expanded and "▾" or "▸"
        end
        for n, page in pairs(tabPages) do page.Visible = (n == currentTab) end
        content.CanvasPosition = Vector2.zero
        return
    end
    for _, it in ipairs(searchItems) do
        it.row.Visible = string.find(it.text, query, 1, true) ~= nil
    end
    for _, sec in ipairs(sections) do
        local found = false
        for _, it in ipairs(sec.items) do
            if it.row.Visible then
                found = true
                break
            end
        end
        sec.wrap.Visible = found
        sec.body.Visible = found
        sec.arrow.Text = "▾"
    end
    for n, page in pairs(tabPages) do page.Visible = (n ~= "Players") end
end

track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    runSearch(searchBox.Text)
end))

