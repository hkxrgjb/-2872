-- ============================================================
-- ESP: boxes, names, distance, health bars, tracers, chams
-- Color = visibility: green visible, red behind a wall, accent teammate.
-- State (who / color / distance) refreshes ~5x per second; positions are
-- drawn every frame so boxes never lag behind moving players.
-- ============================================================
local updateESPState, renderESP, destroyAllESP
do
local espObjects = {}

local function hidePieces(o)
    o.box.Visible = false
    o.nameLbl.Visible = false
    o.distLbl.Visible = false
    o.hpBg.Visible = false
    o.tracer.Visible = false
