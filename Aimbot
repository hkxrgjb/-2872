-- [AI] ADAPTIVE WEAPON TUNING  [FIX#1] global
-- =====================================================================
weaponTelemetry = {}

function getWStat(name)
    local s = weaponTelemetry[name]
    if not s then
        s = { shots=0, hits=0, dmg=0, distSum=0, distN=0,
              flightSum=0, flightN=0, lastShotT=0, lastShotDist=0 }
        weaponTelemetry[name] = s
    end
    return s
end

function aiRecordShot()
    if not (Settings.AIWeaponTuning and currentWeapon) then return end
    local s = getWStat(currentWeapon)
    s.shots     = s.shots + 1
    s.lastShotT = os.clock()
    s.lastShotDist = 0
    if CurrentPart and CurrentPart.Parent then
        local cam = camera()
        if cam then
            local d = (CurrentPart.Position
                       - cam.CFrame.Position).Magnitude
            s.lastShotDist = d
            s.distSum = s.distSum + d
            s.distN   = s.distN + 1
        end
    end
end

function aiRecordHit(dmg)
    if not (Settings.AIWeaponTuning and currentWeapon) then return end
    local s = getWStat(currentWeapon)
    s.hits = s.hits + 1
    s.dmg  = s.dmg + (dmg or 0)
    local now = os.clock()
    local ft  = now - s.lastShotT
    if ft > 0.02 and ft < 1.5 and s.lastShotDist > 5 then
        s.flightSum = s.flightSum + ft
        s.flightN   = s.flightN + 1
    end
end

function aiCategorize(avgDist)
    if avgDist > 250 then return "sniper", L("catSniper")
    elseif avgDist > 120 then return "rifle", L("catRifle")
    elseif avgDist > 40 then return "smg", L("catSMG")
    else return "close", L("catClose") end
end

function aiTuneCycle()
    if not (Settings.AIWeaponTuning and currentWeapon) then return end
    local s = weaponTelemetry[currentWeapon]
    if not s or s.shots < 6 then return end
    local acc     = s.hits / math.max(s.shots, 1)
    local avgDist = s.distN > 0 and (s.distSum / s.distN) or 0
    local avgFlight = s.flightN > 0 and (s.flightSum / s.flightN) or 0
    if avgFlight > 0.03 and avgDist > 10 then
        local est = math.clamp(avgDist / avgFlight, 300, 3000)
        local cur = Settings.BulletSpeed
        if math.abs(est - cur) > math.max(cur * 0.12, 40) then
            setSetting("BulletSpeed",
                math.floor(cur * 0.5 + est * 0.5 + 0.5))
        end
    end
    if acc < 0.35 then
        setSetting("Smoothness",
            math.max(0.05, Settings.Smoothness - 0.04))
        setSetting("PredAmount",
            math.min(2.0, Settings.PredAmount + 0.05))
    elseif acc > 0.75 then
        setSetting("Smoothness",
            math.min(0.7, Settings.Smoothness + 0.02))
    end
    local cat = aiCategorize(avgDist)
    if cat == "close" or cat == "smg" then
        if acc > 0.5 then
            setSetting("FireDelay",
                math.max(0.06, Settings.FireDelay - 0.01))
        end
    elseif cat == "sniper" then
        setSetting("FireDelay",
            math.min(0.4, Settings.FireDelay + 0.01))
    end
    local prof = Settings.Weapons[currentWeapon] or {}
    prof.BulletSpeed   = Settings.BulletSpeed
    prof.BulletGravity = Settings.BulletGravity
    prof.FireDelay     = Settings.FireDelay
    prof.Tuned         = true
    prof.Category      = cat
    prof.Acc           = math.floor(acc * 100)
    Settings.Weapons[currentWeapon] = prof
    saveDirty = true
    logEvent(string.format("AI tuned %s (%s) acc %d%%",
        currentWeapon, cat, math.floor(acc * 100)))
    s.shots     = math.floor(s.shots * 0.5)
    s.hits      = math.floor(s.hits * 0.5)
    s.flightSum = s.flightSum * 0.5
    s.flightN   = math.floor(s.flightN * 0.5 + 0.5)
    s.distSum   = s.distSum * 0.5
    s.distN     = math.floor(s.distN * 0.5 + 0.5)
end

task.spawn(function()
    while Running do
        task.wait(5)
        pcall(aiTuneCycle)
    end
end)

