-- =====================================================================
-- KERNEL: EventBus + module lifecycle
-- =====================================================================
local Kernel = {}
do
    local listeners = {}
    local counter   = 0

    function Kernel.on(event, fn)
        listeners[event] = listeners[event] or {}
        counter = counter + 1
        local id = counter
        listeners[event][id] = fn
        local handle = {}
        function handle:Disconnect()
            local list = listeners[event]
            if list then list[id] = nil end
        end
        return handle
    end

    function Kernel.once(event, fn)
        local handle
        handle = Kernel.on(event, function(...)
            handle:Disconnect()
            fn(...)
        end)
        return handle
    end

    function Kernel.emit(event, ...)
        local list = listeners[event]
        if not list then return end
        for _, fn in pairs(list) do
            local ok, err = pcall(fn, ...)
            if not ok then warn("[ProAimbot][EventBus] " .. tostring(err)) end
        end
    end

    function Kernel.shutdown()
        listeners = {}
    end

    local modules = {}
    function Kernel.register(name, mod)
        modules[name] = mod
    end
    function Kernel.startAll()
        for name, mod in pairs(modules) do
            if mod.Start then
                local ok, err = pcall(mod.Start)
                if not ok then warn("[ProAimbot][Module:" .. name .. "] " .. tostring(err)) end
            end
        end
    end
    function Kernel.stopAll()
        for name, mod in pairs(modules) do
            if mod.Stop then pcall(mod.Stop) end
        end
    end
end

local function subscribe(event, fn)
    return track(Kernel.on(event, fn))
end

