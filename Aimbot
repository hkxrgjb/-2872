local function logEvent(text)
    table.insert(eventLog, os.date("%H:%M:%S") .. "  " .. text)
    if #eventLog > 60 then table.remove(eventLog, 1) end
end

local cleanup
local function setStatus(text, color)
    color = color or C.accent
    if text ~= statusText or color ~= statusColor then
        statusText, statusColor, statusDirty = text, color, true
    end
end

local function toast(text, color, duration)
    logEvent(text)
    toastText = text
    toastColor = color or C.accent
    toastUntil = os.clock() + (duration or 2)
    lastHudFlush = 0
end

local function flushHud(now)
    if now - lastHudFlush < 0.1 then return end
    lastHudFlush = now
    if statusDirty then
        statusDirty = false
        if statusLabel then
            statusLabel.Text = statusText
            statusLabel.TextColor3 = statusColor
        end
        if pillLabel then
            pillLabel.Text = statusText
            pillLabel.TextColor3 = statusColor
        end
    end
    if toastLabel then
        local show = now < toastUntil
        if show then
            toastLabel.Text = toastText
            toastLabel.TextColor3 = toastColor
        end
        if show ~= toastShown then
            toastShown = show
            toastLabel.Visible = show
        end
    end
end

