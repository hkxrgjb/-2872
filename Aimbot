-- ============================================================
-- Main loop (bound right AFTER the camera script so our aim sticks)
-- ============================================================
;(function()
local lastSelect, lastESP, lastInfo, lastStats, lastDiag = 0, 0, 0, 0, 0
local fovLocked = false
local lastFov = Settings.FOV
local infoText = "Searching for target..."

local function frameStep(dt, now, perf)
    -- HUD state
    if lastFov ~= Settings.FOV then
        lastFov = Settings.FOV
        fovFrame.Size = UDim2.fromOffset(Settings.FOV * 2, Settings.FOV * 2)
    end
    local showFov = Settings.ShowFOV and Settings.Enabled
        and not (Settings.NearestLock or Settings.TargetScope == "Global")
    if fovFrame.Visible ~= showFov then fovFrame.Visible = showFov end
    local locked = CurrentPart ~= nil and Settings.Enabled and not isKilling
    if locked ~= fovLocked then
        fovLocked = locked
        fovStroke.Color = locked and C.good or C.accent
    end
    local showAim = Settings.Enabled and not Settings.AutoAim
    if aimBtn.Visible ~= showAim then
        aimBtn.Visible = showAim
        if not showAim then aimHeld = false end
    end

    -- ESP: state ~5x/s, drawing every frame
    if now - lastESP >= (perf and 0.3 or 0.2) then
        lastESP = now
        updateESPState()
    end
    renderESP()
    updateRadar(now, perf)
    updateThreat(now)
    updateWeaponProfile(now)
    if not isKilling then runTriggerBot(now) end

    -- Kill mode: camera follows the victim
    if isKilling then
        marker.Visible = false
        if KillAimPart and KillAimPart.Parent then
            aimCamera(getAimPosition(KillAimPart, KillAimPart.AssemblyLinearVelocity * 0.06), 0.5, dt, now, false)
        end
        return
    end

    if not Settings.Enabled then
        setTarget(nil, nil)
        lastAimLook = nil
        marker.Visible = false
        setStatus("Aimbot: OFF", C.idle)
        return
    end

    local active = Settings.AutoAim or aimHeld

    -- Target selection
    if now - lastSelect >= (perf and 0.1 or 0.05) then
        lastSelect = now
        if active then
            local t0 = os.clock()
            selectTarget(now)
            diag.selMs = (os.clock() - t0) * 1000
        else
            setTarget(nil, nil)
        end
    end

    -- Validate every frame (cheap)
    if CurrentPart and (not CurrentPart.Parent or not CurrentTarget or not isAlive(CurrentTarget)) then
        if CurrentTarget and CurrentTarget.Parent and not isAlive(CurrentTarget) then
            stats.kills = stats.kills + 1
        end
        setTarget(nil, nil)
    end

    if CurrentPart and active then
        local char = CurrentTarget.Character
        local root = getRoot(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local offset, drop = Vector3.zero, 0
        if root then
            trackerUpdate(aimTracker, root, now)
            offset, drop = computeLeadOffset(root, hum, now)
        end

        local aimPos = getAimPosition(CurrentPart, offset, drop)
        local base = (1 - Settings.Smoothness) * Settings.Strength
        if Settings.SnapOnAcquire and now < acquireBoostUntil then
            base = math.min(1, base * 2.5 + 0.3)
        end
        aimCamera(aimPos, base, dt, now, true)
        if not lockHidden then tryAutoFire(now, aimPos) end

        -- hit feedback: health lost by the locked target right after one of our shots
        if hum then
            if hitTrack.target ~= CurrentTarget then
                hitTrack.target, hitTrack.hp = CurrentTarget, hum.Health
            else
                if hum.Health < hitTrack.hp - 0.5 and now - lastShot < 0.8 then
                    stats.hits = stats.hits + 1
                    stats.damage = stats.damage + (hitTrack.hp - hum.Health)
                    if Settings.HitFeedback then hitFlashUntil = now + 0.18 end
                end
                hitTrack.hp = hum.Health
            end
        end

        if Settings.ShowMarker then
            local cam = camera()
            local v, onScreen = cam:WorldToViewportPoint(aimPos)
            marker.Visible = onScreen and v.Z > 0
            if marker.Visible then
                marker.Position = UDim2.fromOffset(v.X, v.Y)
                local pulse = now < hitFlashUntil
                marker.Size = pulse and UDim2.fromOffset(28, 28) or UDim2.fromOffset(14, 14)
            end
        else
            marker.Visible = false
        end

        if now - lastInfo >= 0.1 then
            lastInfo = now
            local cam = camera()
            local dist = (CurrentPart.Position - cam.CFrame.Position).Magnitude
            infoText = string.format("%s | %s | %dm | %d HP",
                CurrentTarget.DisplayName, CurrentPart.Name,
                math.floor(dist), hum and math.floor(hum.Health) or 0)
        end
        setStatus(infoText, C.accent)
    else
        lastAimLook = nil
        marker.Visible = false
        if active then
            setStatus("Searching for target...", C.idle)
        else
            setStatus("Hold AIM to aim", C.idle)
        end
    end
end

local lastErr = 0
local function onRender(dt)
    if not Running then return end
    local now = os.clock()

    -- FPS tracking + adaptive performance
    fpsEMA = fpsEMA + (1 / math.max(dt, 0.001) - fpsEMA) * 0.05
    if now - lastStats >= 0.5 then
        lastStats = now
        if fpsEMA < 26 or frameMs > 6 then
            autoPerfOn = Settings.AutoPerf
        elseif fpsEMA > 42 and frameMs < 3 then
            autoPerfOn = false
        end
        if Settings.ShowStats and statsLabel then
            statsLabel.Text = string.format("%d FPS · %d ms%s",
                math.floor(fpsEMA + 0.5), math.floor(getPing() * 1000),
                perfActive() and " · eco" or "")
        end
        if weaponInfoLabel then
            local saved = currentWeapon and type(Settings.Weapons[currentWeapon]) == "table"
            weaponInfoLabel.Text = "Weapon: " .. (currentWeapon or "none")
                .. (saved and "  (profile saved)" or "")
        end
        if sessionInfoLabel then
            local acc = 0
            if stats.shots > 0 then
                acc = math.min(100, math.floor(stats.hits / stats.shots * 100 + 0.5))
            end
            sessionInfoLabel.Text = string.format(
                "%d locks · %d locked kills · %d hits / %d shots (%d%%) · %d dmg · %d errors · %d min",
                stats.locks, stats.kills, stats.hits, stats.shots, acc,
                math.floor(stats.damage), stats.errors, math.floor((now - stats.start) / 60))
        end
        if logInfoLabel then
            local from = math.max(1, #eventLog - 8)
            logInfoLabel.Text = table.concat(eventLog, "\n", from, #eventLog)
        end
    end

    if Settings.Diagnostics and diagLabel and now - lastDiag >= 0.2 then
        lastDiag = now
        local T = aimTracker
        diagLabel.Text = string.format(
            "tgt %s  spd %.1f  acc %.1f  man %.2f  rel %.2f\nlead %.3fs  drop %.2f  sel %.2fms  fps %d  ping %dms\nlocks %d  kills %d  hits %d  dmg %d  shots %d  errors %d  frame %.2fms",
            CurrentTarget and CurrentTarget.Name or "-",
            T.vel.Magnitude, T.acc.Magnitude, T.man, T.rel,
            diag.lead, diag.drop, diag.selMs,
            math.floor(fpsEMA + 0.5), math.floor(getPing() * 1000),
            stats.locks, stats.kills, stats.hits, math.floor(stats.damage), stats.shots,
            stats.errors, frameMs)
    end

    -- A bug in one frame must never kill the whole script
    local t0 = os.clock()
    local ok, err = pcall(frameStep, dt, now, perfActive())
    frameMs = frameMs + ((os.clock() - t0) * 1000 - frameMs) * 0.05
    if not ok then stats.errors = stats.errors + 1 end
    if not ok and now - lastErr > 3 then
        lastErr = now
        warn("[ProAimbot] " .. tostring(err))
        toast("Error: " .. string.sub(tostring(err), 1, 70), C.bad, 3)
    end

    flushHud(now)
end

RunService:BindToRenderStep("ProAimbot", Enum.RenderPriority.Camera.Value + 1, onRender)

-- Auto-save changed settings (batched, never on every slider tick)
task.spawn(function()
    while Running do
        task.wait(2)
        if saveDirty then saveConfig() end
    end
end)

end)() -- main loop

-- ============================================================
-- Cleanup (Unload button / re-execute)
-- ============================================================
cleanup = function()
    Running = false
    isKilling = false
    pcall(function() RunService:UnbindFromRenderStep("ProAimbot") end)
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    captures = {}
    endHazardBypass()
    if saveDirty then saveConfig() end
    pcall(destroyAllESP)
    if weaponConn then pcall(function() weaponConn:Disconnect() end) end
    pcall(function() uiLayer:Destroy() end)
    pcall(function() hudGui:Destroy() end)
    pcall(function() espGui:Destroy() end)
    pcall(function() chamsFolder:Destroy() end)
    if Env.__ProAimbotCleanup == cleanup then Env.__ProAimbotCleanup = nil end
end
Env.__ProAimbotCleanup = cleanup
