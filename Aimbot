-- Safe HUD position helpers
-- ============================================================
local hudRegistry = {}

local function applyHudPos(frame, key, dx, dy)
    if not frame or not frame.Parent then
        return
    end

    local vp = frame.Parent.AbsoluteSize
    if not vp or vp.X <= 10 or vp.Y <= 10 then
        vp = Vector2.new(420, 820)
    end

    local xScale = dx
    local yScale = dy

    if Settings.LeftHanded and key ~= "main" and key ~= "chipEditor" then
        xScale = 1 - dx
    end

    local x, y
    local p = Settings.HudPos[key]

    if type(p) == "table" and type(p[1]) == "number" and type(p[2]) == "number" then
        x = p[1] * vp.X
        y = p[2] * vp.Y
    else
        x = xScale * vp.X
        y = yScale * vp.Y
    end

    x = math.clamp(x, 30, vp.X - 30)
    y = math.clamp(y, 42, vp.Y - 30)

    frame.Position = UDim2.fromOffset(x, y)
end

local function registerHud(frame, key, dx, dy)
    table.insert(hudRegistry, {
        frame = frame,
        key = key,
        dx = dx,
        dy = dy,
    })
    applyHudPos(frame, key, dx, dy)
end

local function applyAllHud()
    for _, entry in ipairs(hudRegistry) do
        applyHudPos(entry.frame, entry.key, entry.dx, entry.dy)
    end
end

