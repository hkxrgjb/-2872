local function normalizeChipOrder()
    local valid = {}
    for _, id in ipairs(CHIP_IDS) do
        valid[id] = true
    end

    local cleaned = {}
    local seen = {}

    if type(Settings.ChipOrder) == "table" then
        for _, id in ipairs(Settings.ChipOrder) do
            if valid[id] and not seen[id] then
                seen[id] = true
                table.insert(cleaned, id)
            end
        end
    end

    if #cleaned == 0 then
        for _, id in ipairs(DEFAULTS.ChipOrder) do
            if valid[id] and not seen[id] then
                seen[id] = true
                table.insert(cleaned, id)
            end
        end
    end

    while #cleaned > 8 do
        table.remove(cleaned)
    end

    Settings.ChipOrder = cleaned
end

