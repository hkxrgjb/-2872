-- Auto fire (fires the equipped tool when the aim point is on the crosshair)
-- ============================================================
local lastFire = 0
local function tryAutoFire(now, aimPos)
    if not Settings.AutoFire or now - lastFire < Settings.FireDelay then return end
    local d = screenDistance(aimPos)
    if not d or d > Settings.TriggerRadius then return end
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        lastFire = now
        pcall(function() tool:Activate() end)
    end
end

-- ============================================================
-- Trigger bot: fires when the crosshair (screen center) is on an enemy.
-- Works on its own, even with the aimbot off.
-- ============================================================
local trigParams = RaycastParams.new()
trigParams.FilterType = Enum.RaycastFilterType.Exclude
trigParams.RespectCanCollide = true
trigParams.IgnoreWater = true

local function runTriggerBot(now)
    if not Settings.TriggerBot or now - lastFire < Settings.FireDelay then return end
    local cam = camera()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not cam or not tool then return end

    trigParams.FilterDescendantsInstances = { char, cam }
    local result = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * Settings.MaxDistance, trigParams)
    if not result then return end

    -- accessories live inside the character: climb until a player owns the model
    local plr = nil
    local node = result.Instance
    while node and node ~= Workspace do
        plr = Players:GetPlayerFromCharacter(node)
        if plr then break end
        node = node.Parent
    end
    if plr and isValidTarget(plr) then
        lastFire = now
        pcall(function() tool:Activate() end)
    end
end

-- ============================================================
-- Kill system
-- ============================================================
local startSingleKill, startKillAll, stopKilling, endHazardBypass
do
local hazardParts = {}
local hazardConn = nil
local RED = Color3.fromRGB(255, 0, 0)
local REALLY_RED = BrickColor.new("Really red")

local function isHazard(v)
    return v:IsA("BasePart") and (v.Color == RED or v.BrickColor == REALLY_RED)
end

-- Red kill-bricks stop firing Touched during a kill run (scanned once, restored after)
local function beginHazardBypass()
    hazardParts = {}
    local n = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        n = n + 1
        if n % 1000 == 0 then task.wait() end
        if isHazard(v) and v.CanTouch then
            hazardParts[v] = true
            v.CanTouch = false
        end
    end
    hazardConn = Workspace.DescendantAdded:Connect(function(v)
        if isHazard(v) and v.CanTouch then
            hazardParts[v] = true
            v.CanTouch = false
        end
    end)
end

function endHazardBypass()
    if hazardConn then
        hazardConn:Disconnect()
        hazardConn = nil
    end
    for p in pairs(hazardParts) do
        if p.Parent then p.CanTouch = true end
    end
    hazardParts = {}
end

local function equipWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    tool = bp and bp:FindFirstChildOfClass("Tool")
    if tool then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:EquipTool(tool) else tool.Parent = char end
    end
    return tool
end

-- returns: "killed" | "stopped" | "died" | "gone" | "no_weapon" | "shielded"
local function attackTarget(targetPlayer, skipShielded)
    if not equipWeapon() then
        toast("No weapon found", C.warn, 2.5)
        return "no_weapon"
    end

    local angle, lastActivate, lastHeal, shieldTime = 0, 0, 0, 0

    while isKilling and Running do
        local dt = RunService.Heartbeat:Wait()
        local now = os.clock()

        local myChar = LocalPlayer.Character
        local myRoot = getRoot(myChar)
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum or myHum.Health <= 0 then return "died" end
        if Settings.KillSafeHP > 0 and myHum.Health < myHum.MaxHealth * Settings.KillSafeHP / 100 then
            return "retreat"
        end

        local tChar = targetPlayer.Character
        local tRoot = getRoot(tChar)
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not targetPlayer.Parent or not tRoot or not tHum then return "gone" end
        if tHum.Health <= 0 then return "killed" end

        if now - lastHeal >= 0.5 then
            lastHeal = now
            myHum.Health = myHum.MaxHealth
        end

        local tool = equipWeapon()

        if tChar:FindFirstChildOfClass("ForceField") then
            shieldTime = shieldTime + dt
            setStatus("Target shielded...", C.warn)
            if skipShielded and shieldTime > 6 then return "shielded" end
        else
            shieldTime = 0
            setStatus("Attacking " .. targetPlayer.Name, C.bad)

            local center = tRoot.Position
            local pattern = Settings.KillPattern
            if pattern == "Above" then
                -- hover over the target, face pointing down at it
                local f = tRoot.CFrame.LookVector
                f = Vector3.new(f.X, 0, f.Z)
                if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) end
                local newPos = center + Vector3.new(0, Settings.KillHeight, 0)
                myRoot.CFrame = CFrame.lookAt(newPos, center, f.Unit)
            elseif pattern == "Behind" then
                local back = -tRoot.CFrame.LookVector
                back = Vector3.new(back.X, 0, back.Z)
                if back.Magnitude < 0.01 then back = Vector3.new(0, 0, 1) end
                local newPos = center + back.Unit * Settings.KillRadius + Vector3.new(0, 1, 0)
                myRoot.CFrame = CFrame.new(newPos, center)
            else
                angle = angle + math.rad(Settings.KillSpeed) * dt
                local newPos = center + Vector3.new(
                    math.cos(angle) * Settings.KillRadius,
                    Settings.KillHeight,
                    math.sin(angle) * Settings.KillRadius
                )
                myRoot.CFrame = CFrame.new(newPos, center)
            end
            myRoot.AssemblyLinearVelocity = Vector3.zero
            KillAimPart = tRoot

            if tool and now - lastActivate >= 0.08 then
                lastActivate = now
                pcall(function() tool:Activate() end)
            end
        end
    end
    return "stopped"
end

local function finishKill(origin)
    endHazardBypass()
    KillAimPart = nil
    isKilling = false
    if origin and isAlive(LocalPlayer) then
        local root = getRoot(LocalPlayer.Character)
        if root then root.CFrame = origin end
    end
end

function startSingleKill(plr)
    if isKilling or not Running then return end
    if not plr or not isAlive(plr) then return end
    isKilling = true
    task.spawn(function()
        local root = getRoot(LocalPlayer.Character)
        local origin = root and root.CFrame
        beginHazardBypass()
        local result = attackTarget(plr, false)
        finishKill(origin)
        if result == "killed" then
            toast("Killed " .. plr.Name, C.good, 2.5)
        elseif result == "stopped" then
            toast("Kill stopped", C.warn, 2)
        elseif result == "died" then
            toast("You died", C.bad, 2.5)
        elseif result == "retreat" then
            toast("Retreated (low HP)", C.warn, 2.5)
        end
    end)
end

function startKillAll()
    if isKilling or not Running then return end
    isKilling = true
    task.spawn(function()
        local root = getRoot(LocalPlayer.Character)
        local origin = root and root.CFrame
        beginHazardBypass()
        local kills = 0
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if isValidTarget(p) then table.insert(list, p) end
        end
        local mode = Settings.KillOrder
        if mode ~= "Default" and root then
            local function sortKey(p)
                if mode == "Lowest HP" then
                    local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                    return h and h.Health or math.huge
                end
                local r = getRoot(p.Character)
                return r and (r.Position - root.Position).Magnitude or math.huge
            end
            table.sort(list, function(a, b) return sortKey(a) < sortKey(b) end)
        end
        for _, plr in ipairs(list) do
            if not (isKilling and Running) then break end
            if isValidTarget(plr) then
                local result = attackTarget(plr, true)
                if result == "killed" then kills = kills + 1 end
                if result == "no_weapon" or result == "died" or result == "retreat" then break end
            end
        end
        finishKill(origin)
        toast("Kill All finished: " .. kills, C.good, 3)
    end)
end

function stopKilling()
    if isKilling then
        isKilling = false
    end
end
end -- kill system

