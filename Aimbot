    local lang = string.lower(tostring(Settings and Settings.Language or "en"))
    local t = STR[lang] or nil
    if t and t[key] ~= nil then return t[key] end
    local en = STR.en[key]
    if en ~= nil then return en end
    return tostring(key)
end

