local selectTarget
do
-- NearestLock overrides scope and mode: always the closest enemy, 360 degrees around you
local function effectiveScope()
    if Settings.NearestLock then return "Global" end
    return Settings.TargetScope
end

local function effectiveMode()
    if Settings.NearestLock then return "Distance" end
    return Settings.TargetMode
end

-- angle in degrees between the camera look direction and a world position
local function angleTo(camCF, pos)
    local d = pos - camCF.Position
    if d.Magnitude < 0.01 then return 0 end
    local u = d.Unit
    local look = camCF.LookVector
    return math.deg(math.atan2(look:Cross(u).Magnitude, look:Dot(u)))
end

-- Returns part, rank (pixels, or degrees in Global scope), worldDistance
-- when the player can be aimed at
local function evaluate(plr, now, fovMult, camPos)
    if not isValidTarget(plr) then return nil end
    if (skipUntil[plr.UserId] or 0) > now then return nil end
    local char = plr.Character
    if Settings.SkipShielded and char:FindFirstChildOfClass("ForceField") then return nil end
    local root = getRoot(char)
    if not root then return nil end
    local worldDist = (root.Position - camPos).Magnitude
    if worldDist > Settings.MaxDistance then return nil end

    local scope = effectiveScope()
    local fov = Settings.FOV * fovMult
    if scope ~= "Global" then
        -- cheap check first, raycasts only for real candidates
        local rootScreen = screenDistance(root.Position)
        if not rootScreen then return nil end
        if scope == "FOV" and rootScreen > fov + 60 then return nil end
    end
    local part = getBestPart(plr)
    if not part then return nil end

    local rank
    if scope == "Global" then
        rank = angleTo(camera().CFrame, part.Position)
    else
        rank = screenDistance(part.Position)
        if not rank then return nil end
        if scope == "FOV" and rank > fov then return nil end
    end
    return part, rank, worldDist
end

-- lower score = better target
local function scoreFor(plr, part, rank, worldDist)
    local mode = effectiveMode()
    if mode == "Distance" then return worldDist end
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if mode == "Health" then return hum and hum.Health or math.huge end
    if mode == "Threat" or mode == "Smart" then
        -- how directly the enemy faces me: 1 = looking straight at me
        local facing = 0
        local root = getRoot(char)
        local myRoot = getRoot(LocalPlayer.Character)
        if root and myRoot then
            local toMe = myRoot.Position - root.Position
            if toMe.Magnitude > 0.1 then facing = root.CFrame.LookVector:Dot(toMe.Unit) end
        end
        local score = worldDist * (1.5 - facing)
        if mode == "Smart" then
            score = score + (hum and hum.Health or 100) * 0.3
                + angleTo(camera().CFrame, part.Position) * 2
        end
        return score
    end
    return rank
end

function selectTarget(now)
    refreshLosFilter()
    local cam = camera()
    local camPos = cam.CFrame.Position

    -- 1) priority target
    local pid = Settings.PriorityId
    if pid ~= 0 then
        local plr = Players:GetPlayerByUserId(pid)
        if plr then
            local part = evaluate(plr, now, 2.0, camPos)
            if part then
                lockHidden, lastGood = false, now
                setTarget(plr, part)
                return
            end
        end
    end

    -- 2) keep the current target
    if CurrentTarget and isValidTarget(CurrentTarget) then
        local part = evaluate(CurrentTarget, now, 1.4, camPos)
        if part and (Settings.Sticky or now - targetSince < Settings.SwitchDelay) then
            CurrentPart = part
            lockHidden, lastGood = false, now
            return
        end
        -- briefly hidden (pillar, corner): keep following it for LockMemory seconds
        if not part and Settings.LockMemory > 0 and now - lastGood < Settings.LockMemory then
            local root = getRoot(CurrentTarget.Character)
            if root then
                CurrentPart = root
                lockHidden = true
                return
            end
        end
    end

    -- 3) best target by the selected mode
    local bestPlr, bestPart, bestScore = nil, nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        local part, rank, wd = evaluate(plr, now, 1.0, camPos)
        if part then
            local score = scoreFor(plr, part, rank, wd)
            if score < bestScore then
                bestScore, bestPlr, bestPart = score, plr, part
            end
        end
    end
    lockHidden = false
    if bestPart then lastGood = now end
    setTarget(bestPlr, bestPart)
end

end -- selection helpers

