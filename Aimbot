local CONFIG_FILE = "ProAimbot_v85.json"
local saveDirty = false

local function saveConfig()
    if not writefile then return false end
    local ok = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(Settings))
    end)
    if ok then saveDirty = false end
    return ok
end

do
    local function loadConfig()
        if not (readfile and isfile) then return end
        pcall(function()
            local file = CONFIG_FILE
            if not isfile(file) then
                for _, older in ipairs({"ProAimbot_v7.json", "ProAimbot_v6.json", "ProAimbot_v5.json"}) do
                    if isfile(older) then file = older break end
                end
                if not isfile(file) then return end
            end
            local data = HttpService:JSONDecode(readfile(file))
            if type(data) ~= "table" then return end
            for k, v in pairs(data) do
                if DEFAULTS[k] ~= nil then
                    if type(v) == type(DEFAULTS[k]) then
                        Settings[k] = v
                    end
                end
            end
            if type(Settings.ChipEnabled) ~= "table" then Settings.ChipEnabled = {} end
            LANG = Settings.Language or "EN"
        end)
    end
    loadConfig()
end

local listeners = {}
local function onChange(key, fn)
    listeners[key] = listeners[key] or {}
    table.insert(listeners[key], fn)
end

local function setSetting(key, value)
    if Settings[key] == value then return end
    Settings[key] = value
    saveDirty = true
    local list = listeners[key]
    if list then
        for _, fn in ipairs(list) do fn(value) end
    end
end

