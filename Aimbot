themed = {}

function bindColor(obj, prop, key)
    obj[prop] = C[key]
    table.insert(themed, { obj=obj, prop=prop, key=key })
end

function create(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

function round(o, r)
    create("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end

function circle(o)
    create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, o)
end

function outline(o, color, thickness, transparency)
    local stroke = create("UIStroke", {
        Thickness     = thickness or 1,
        Transparency  = transparency or 0,
    }, o)
    if type(color) == "string" then
        bindColor(stroke, "Color", color)
    else
        stroke.Color = color
    end
    return stroke
end

function animate(obj, props, duration, easing, direction)
    local info = TweenInfo.new(
        duration or 0.2,
        easing or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

function safeParent(obj)
    pcall(function()
        if gethui then obj.Parent = gethui()
        else obj.Parent = game:GetService("CoreGui") end
    end)
    if not obj.Parent then
        obj.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

function safeTopInset()
    local ok, a = pcall(function()
        return GuiService:GetGuiInset()
    end)
    if ok and typeof(a) == "Vector2" then
        return math.max(30, a.Y)
    end
    return 36
end

