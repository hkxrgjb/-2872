        local goalColor = state and C.good or C.bar
        local goalPos = state and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        if animate then
            TweenService:Create(sw, TweenInfo.new(0.15), { BackgroundColor3 = goalColor }):Play()
