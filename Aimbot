function gotoWaypoint()
    local w = Settings.Waypoints[Settings.WaypointSlot]
    if type(w) ~= "table" or type(w[1]) ~= "number"
        or type(w[2]) ~= "number" or type(w[3]) ~= "number"
    then
        toast(string.format(L("fmtWayEmpty"),
              Settings.WaypointSlot), C.warn, 2)
        return
    end
    if isKilling then
        toast(L("toastStopKillFirst"), C.warn, 2)
        return
    end
    local root = getRoot(LocalPlayer.Character)
    if not root then return end
    root.CFrame = CFrame.new(w[1], w[2] + 3, w[3])
    root.AssemblyLinearVelocity = Vector3.zero
    toast(string.format(L("fmtWayTele"), Settings.WaypointSlot),
          C.accent, 2)
end

-- =====================================================================
-- Auto fire  [FIX#1] global
-- =====================================================================
lastFire = 0

function tryAutoFire(now, aimPos)
    if not Settings.AutoFire
        or now - lastFire < Settings.FireDelay then return end
    local d = screenDistance(aimPos)
    if not d then return end
    local radius = Settings.TriggerRadius
    if Settings.SmartFire then
        radius = radius * 0.8
        if not (aimTracker.init and aimTracker.rel > 0.55) then
            return
        end
    end
    if d > radius then return end
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        lastFire = now
        pcall(function() tool:Activate() end)
    end
end

-- =====================================================================
-- Trigger bot  [FIX#1] global
-- =====================================================================
trigParams = RaycastParams.new()
trigParams.FilterType        = Enum.RaycastFilterType.Exclude
trigParams.RespectCanCollide = true
trigParams.IgnoreWater       = true

function runTriggerBot(now)
    if not Settings.TriggerBot
        or now - lastFire < Settings.FireDelay then return end
    local cam  = camera()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not cam or not tool then return end
    trigParams.FilterDescendantsInstances = { char, cam }
    local result = Workspace:Raycast(
        cam.CFrame.Position,
        cam.CFrame.LookVector * Settings.MaxDistance,
        trigParams)
    if not result then return end
    local plr  = nil
    local node = result.Instance
    while node and node ~= Workspace do
        plr = Players:GetPlayerFromCharacter(node)
        if plr then break end
        node = node.Parent
    end
    if plr and isValidTarget(plr) then
        lastFire = now
        pcall(function() tool:Activate() end)
    end
end

-- =====================================================================
-- [GHOST] SMART INVISIBILITY / CLONE SYSTEM
-- [FIX#1] GhostClone is GLOBAL.
-- [FIX#4] Truthful error + LocalTransparencyModifier fallback.
-- =====================================================================
GhostClone = { active = false, fallbackMode = false }
do
    local gs = {
        originCF = nil, clone = nil, anchor = nil, conn = nil,
        farPos = Vector3.zero,
    }

    local function clearObjects()
        if gs.clone  then pcall(function() gs.clone:Destroy()  end) gs.clone  = nil end
        if gs.anchor then pcall(function() gs.anchor:Destroy() end) gs.anchor = nil end
        if gs.conn   then pcall(function() gs.conn:Disconnect() end) gs.conn  = nil end
    end

    -- [FIX#4] helper: set LocalTransparencyModifier on every part
    local function setCharTransparency(char, value)
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                d.LocalTransparencyModifier = value
            elseif d:IsA("Decal") then
                d.Transparency = value
            end
        end
    end

    function GhostClone.isEnabled()
        return GhostClone.active
    end

    function GhostClone.enable()
        if GhostClone.active then return end
        if isKilling then
            toast(L("toastStopKillFirst"), C.warn, 2)
            return
        end
        local char = LocalPlayer.Character
        local root = getRoot(char)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local cam  = camera()
        if not root or not hum or hum.Health <= 0 or not cam then
            toast(L("toastNoChar"), C.warn, 2)
            return
        end

        gs.originCF = root.CFrame
        gs.farPos   = root.Position + Vector3.new(0, 4000, 0)

        -- [FIX#4] Try to clone; fall back to LocalTransparencyModifier
        local ok, clone = pcall(function() return char:Clone() end)
        if not ok or not clone then
            -- Fallback: make the real character translucent in place
            GhostClone.fallbackMode = true
            setCharTransparency(char, 0.55)
            GhostClone.active = true
            toast(L("toastGhostOn"), C.good, 2)
            if refreshGhostBtn then refreshGhostBtn() end
            logEvent("Ghost (fallback transparency): ON")
            return
        end

        clone.Name = "ProAimbot_GhostClone"
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BaseScript") or d:IsA("ForceField") then
                d:Destroy()
            end
        end
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Transparency = 0.55
                d.CanCollide   = false
                d.Anchored     = true
            elseif d:IsA("Decal") then
                d.Transparency = 0.55
            elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                d.Enabled = false
            end
        end
        local chum = clone:FindFirstChildOfClass("Humanoid")
        if chum then
            chum.HealthDisplayDistance = 0
            pcall(function()
                chum:ChangeState(Enum.HumanoidStateType.Physics)
            end)
        end
        clone.Parent = Workspace
        gs.clone = clone

        local anchor = Instance.new("Part")
        anchor.Name        = "ProAimbot_GhostAnchor"
        anchor.Size        = Vector3.new(10, 1, 10)
        anchor.Anchored    = true
        anchor.CanCollide  = true
        anchor.Transparency = 1
        anchor.CFrame      = CFrame.new(gs.farPos
                             - Vector3.new(0, 3.5, 0))
        anchor.Parent      = Workspace
        gs.anchor = anchor

        root.CFrame = CFrame.new(gs.farPos)
        root.AssemblyLinearVelocity = Vector3.zero
        hum.PlatformStand = true

        gs.conn = track(RunService.Heartbeat:Connect(function()
            if not GhostClone.active then return end
            local r = getRoot(LocalPlayer.Character)
            if r then
                r.CFrame = CFrame.new(gs.farPos)
                r.AssemblyLinearVelocity  = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end))

        if chum then cam.CameraSubject = chum end

        GhostClone.active = true
        toast(L("toastGhostOn"), C.good, 2)
        if refreshGhostBtn then refreshGhostBtn() end
        logEvent("Ghost clone: ON")
    end

    function GhostClone.disable(silent)
        if not GhostClone.active then return end
        GhostClone.active = false

        -- [FIX#4] Fallback path: just restore transparency
        if GhostClone.fallbackMode then
            local char = LocalPlayer.Character
            if char then setCharTransparency(char, 0) end
            GhostClone.fallbackMode = false
            if not silent then
                toast(L("toastGhostOff"), C.good, 2)
                logEvent("Ghost (fallback): OFF")
            end
            if refreshGhostBtn then refreshGhostBtn() end
            return
        end

        if gs.conn then
            pcall(function() gs.conn:Disconnect() end)
            gs.conn = nil
        end
        local char = LocalPlayer.Character
        local root = getRoot(char)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if root and gs.originCF then
            root.CFrame = gs.originCF + Vector3.new(0, 2.5, 0)
            root.AssemblyLinearVelocity = Vector3.zero
        end
        if hum then hum.PlatformStand = false end
        local cam = camera()
        if cam and hum then cam.CameraSubject = hum end
        if gs.clone  then
            pcall(function() gs.clone:Destroy()  end)
            gs.clone = nil
        end
        if gs.anchor then
            pcall(function() gs.anchor:Destroy() end)
            gs.anchor = nil
        end
        if not silent then
            toast(L("toastGhostOff"), C.good, 2)
            logEvent("Ghost clone: OFF")
        end
        if refreshGhostBtn then refreshGhostBtn() end
    end

    track(LocalPlayer.CharacterAdded:Connect(function()
        if GhostClone.active then
            GhostClone.disable(true)
        end
    end))
end

function toggleGhostClone()
    if GhostClone.isEnabled() then
        GhostClone.disable(false)
    else
        GhostClone.enable()
    end
end

-- =====================================================================
-- Kill system  (do-block keeps internals scoped)
-- =====================================================================
do
    local hazardParts = {}
    local hazardConn  = nil
    local RED         = Color3.fromRGB(255, 0, 0)
    local REALLY_RED  = BrickColor.new("Really red")

    local function isHazard(v)
        return v:IsA("BasePart")
            and (v.Color == RED or v.BrickColor == REALLY_RED)
    end

    local function beginHazardBypass()
        hazardParts = {}
        local n = 0
        for _, v in ipairs(Workspace:GetDescendants()) do
            n = n + 1
            if n % 1000 == 0 then task.wait() end
            if isHazard(v) and v.CanTouch then
                hazardParts[v] = true
                v.CanTouch = false
            end
        end
        hazardConn = Workspace.DescendantAdded:Connect(function(v)
            if isHazard(v) and v.CanTouch then
                hazardParts[v] = true
                v.CanTouch = false
            end
        end)
    end

    function endHazardBypass()
        if hazardConn then
            hazardConn:Disconnect()
            hazardConn = nil
        end
        for p in pairs(hazardParts) do
            if p.Parent then p.CanTouch = true end
        end
        hazardParts = {}
    end

    local function equipWeapon()
        local char = LocalPlayer.Character
        if not char then return nil end
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then return tool end
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        tool = bp and bp:FindFirstChildOfClass("Tool")
        if tool then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(tool)
            else tool.Parent = char end
        end
        return tool
    end

    local function attackTarget(targetPlayer, skipShielded)
        if not equipWeapon() then
            toast(L("toastNoWeapon"), C.warn, 2.5)
            return "no_weapon"
        end
        local angle, lastActivate, lastHeal, shieldTime = 0, 0, 0, 0
        while isKilling and Running do
            local dt  = RunService.Heartbeat:Wait()
            local now = os.clock()
            local myChar = LocalPlayer.Character
            local myRoot = getRoot(myChar)
            local myHum  = myChar
                and myChar:FindFirstChildOfClass("Humanoid")
            if not myRoot or not myHum or myHum.Health <= 0 then
                return "died"
            end
            if Settings.KillSafeHP > 0
                and myHum.Health
                    < myHum.MaxHealth * Settings.KillSafeHP / 100
            then
                return "retreat"
            end
            local tChar = targetPlayer.Character
            local tRoot = getRoot(tChar)
            local tHum  = tChar
                and tChar:FindFirstChildOfClass("Humanoid")
            if not targetPlayer.Parent or not tRoot or not tHum then
                return "gone"
            end
            if tHum.Health <= 0 then return "killed" end
            if now - lastHeal >= 0.5 then
                lastHeal = now
                myHum.Health = myHum.MaxHealth
            end
            local tool = equipWeapon()
            if tChar:FindFirstChildOfClass("ForceField") then
                shieldTime = shieldTime + dt
                setStatus(L("statusShielded"), C.warn)
                if skipShielded and shieldTime > 6 then
                    return "shielded"
                end
            else
                shieldTime = 0
                setStatus(string.format(L("fmtAttacking"),
                    targetPlayer.Name), C.bad)
                local center  = tRoot.Position
                local pattern = Settings.KillPattern
                if pattern == "Above" then
                    local f = tRoot.CFrame.LookVector
                    f = Vector3.new(f.X, 0, f.Z)
                    if f.Magnitude < 0.01 then
                        f = Vector3.new(0, 0, -1)
                    end
                    local newPos = center
                        + Vector3.new(0, Settings.KillHeight, 0)
                    myRoot.CFrame = CFrame.lookAt(
                        newPos, center, f.Unit)
                elseif pattern == "Behind" then
                    local back = -tRoot.CFrame.LookVector
                    back = Vector3.new(back.X, 0, back.Z)
                    if back.Magnitude < 0.01 then
                        back = Vector3.new(0, 0, 1)
                    end
                    local newPos = center + back.Unit
                        * Settings.KillRadius
                        + Vector3.new(0, 1, 0)
                    myRoot.CFrame = CFrame.new(newPos, center)
                else
                    angle = angle
                        + math.rad(Settings.KillSpeed) * dt
                    local newPos = center + Vector3.new(
                        math.cos(angle) * Settings.KillRadius,
                        Settings.KillHeight,
                        math.sin(angle) * Settings.KillRadius)
                    myRoot.CFrame = CFrame.new(newPos, center)
                end
                myRoot.AssemblyLinearVelocity = Vector3.zero
                KillAimPart = tRoot
                if tool and now - lastActivate >= 0.08 then
                    lastActivate = now
                    pcall(function() tool:Activate() end)
                end
            end
        end
        return "stopped"
    end

    local function finishKill(origin)
        endHazardBypass()
        KillAimPart = nil
        isKilling   = false
        if origin and isAlive(LocalPlayer) then
            local root = getRoot(LocalPlayer.Character)
            if root then root.CFrame = origin end
        end
    end

    function startSingleKill(plr)
        if isKilling or not Running then return end
        if GhostClone.isEnabled() then
            toast(L("toastGhostOff"), C.warn, 2)
            GhostClone.disable(true)
        end
        if not plr or not isAlive(plr) then return end
        isKilling = true
        task.spawn(function()
            local root   = getRoot(LocalPlayer.Character)
            local origin = root and root.CFrame
            beginHazardBypass()
            local result = attackTarget(plr, false)
            finishKill(origin)
            if result == "killed" then
                toast(string.format(L("fmtKilled"), plr.Name),
                      C.good, 2.5)
            elseif result == "stopped" then
                toast(L("toastKillStopped"), C.warn, 2)
            elseif result == "died" then
                toast(L("toastDied"), C.bad, 2.5)
            elseif result == "retreat" then
                toast(L("toastRetreat"), C.warn, 2.5)
            end
        end)
    end

    function startKillAll()
        if isKilling or not Running then return end
        if GhostClone.isEnabled() then
            GhostClone.disable(true)
        end
        isKilling = true
        task.spawn(function()
            local root   = getRoot(LocalPlayer.Character)
            local origin = root and root.CFrame
            beginHazardBypass()
            local kills = 0
            local list  = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if isValidTarget(p) then
                    table.insert(list, p)
                end
            end
            local mode = Settings.KillOrder
            if mode ~= "Default" and root then
                local function sortKey(p)
                    if mode == "Lowest HP" then
                        local h = p.Character
                            and p.Character:FindFirstChildOfClass(
                                "Humanoid")
                        return h and h.Health or math.huge
                    end
                    local r = getRoot(p.Character)
                    return r and (r.Position - root.Position).Magnitude
                           or math.huge
                end
                table.sort(list, function(a, b)
                    return sortKey(a) < sortKey(b)
                end)
            end
            for _, plr in ipairs(list) do
                if not (isKilling and Running) then break end
                if isValidTarget(plr) then
                    local result = attackTarget(plr, true)
                    if result == "killed" then kills = kills + 1 end
                    if result == "no_weapon" or result == "died"
                        or result == "retreat" then break end
                end
            end
            finishKill(origin)
            toast(string.format(L("fmtKillDone"), kills),
                  C.good, 3)
        end)
    end

    function stopKilling()
        if isKilling then isKilling = false end
    end
end

-- =====================================================================
-- MOVEMENT SYSTEM  [FIX#1] Movement is GLOBAL.
-- =====================================================================
Movement = {}
do
    local noclipConn = nil
    local flyVert    = 0
    local flyJoy     = Vector2.new(0, 0)
    local flyUpHeld, flyDownHeld = false, false

    function Movement.getHumanoid()
        local char = LocalPlayer.Character
        return char and char:FindFirstChildOfClass("Humanoid")
    end

    function Movement.applyStats()
        local hum = Movement.getHumanoid()
        if hum then
            hum.WalkSpeed   = Settings.WalkSpeed
            hum.JumpPower   = Settings.JumpPower
            hum.UseJumpPower = true
        end
    end

    function Movement.setNoclip(on)
        if on and not noclipConn then
            noclipConn = track(RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end))
        elseif not on and noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
    end

    function Movement.setFlyVel(root)
        local cam = camera()
        if not cam then return end
        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then flat = flat.Unit
        else flat = Vector3.new(0, 0, -1) end
        local right = Vector3.new(-flat.Z, 0, flat.X)
        local vert  = 0
        if flyUpHeld   then vert = vert + 1 end
        if flyDownHeld then vert = vert - 1 end
        local dir = right * flyJoy.X + flat * flyJoy.Y
                    + Vector3.new(0, vert, 0)
        if dir.Magnitude > 1 then dir = dir.Unit end
        root.AssemblyLinearVelocity = dir * Settings.FlySpeed
    end

    function Movement.setJoy(x, y)
        flyJoy = Vector2.new(x, y)
    end

    function Movement.setVertical(v)
        if v > 0 then flyUpHeld, flyDownHeld = true, false
        elseif v < 0 then flyUpHeld, flyDownHeld = false, true
        else flyUpHeld, flyDownHeld = false, false end
    end

    function Movement.flyActive()
        return Settings.Fly and not isKilling
               and not GhostClone.isEnabled()
    end

    function Movement.frame()
        if Movement.flyActive() then
            local root = getRoot(LocalPlayer.Character)
            if root then Movement.setFlyVel(root) end
        end
    end

    function Movement.restore()
        Movement.setNoclip(false)
        local hum = Movement.getHumanoid()
        if hum then
            hum.WalkSpeed  = 16
            hum.JumpPower  = 50
            hum.AutoRotate = true
        end
    end

    onChange("WalkSpeed",  Movement.applyStats)
    onChange("JumpPower",  Movement.applyStats)
    onChange("Noclip", function(v) Movement.setNoclip(v) end)
    onChange("Fly", function(v)
        local hum = Movement.getHumanoid()
        if hum then hum.AutoRotate = not v end
        if not v then
            local root = getRoot(LocalPlayer.Character)
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end)

    track(LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        Movement.applyStats()
    end))

    Kernel.register("Movement", {
        Start = Movement.applyStats,
        Stop  = Movement.restore,
    })
end

-- =====================================================================
-- VECTOR ICON SYSTEM  [FIX#1] drawIcon is GLOBAL.
-- =====================================================================
function drawIcon(parent, iconType, size, color)
    local container = Instance.new("Frame")
    container.Name = "Icon_" .. tostring(iconType)
    container.Size = UDim2.fromOffset(size, size)
    container.BackgroundTransparency = 1
    container.AnchorPoint = Vector2.new(0.5, 0.5)
    container.Position    = UDim2.new(0.5, 0, 0.5, 0)
    container.Parent      = parent
    local c = color or C.text
    local t = math.max(1, math.floor(size * 0.12))

    local function bar(spec, horizontal, len)
        local f = Instance.new("Frame")
        f.BackgroundColor3 = c
        f.BorderSizePixel  = 0
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.new(0.5 + spec[1]*0.3, 0,
                               0.5 + spec[2]*0.3, 0)
        f.Size = horizontal
            and UDim2.new(len or 0.35, 0, 0, t)
            or  UDim2.new(0, t, len or 0.35, 0)
        f.Parent = container
        return f
    end

    local function corner(o, r)
        local cc = Instance.new("UICorner")
        cc.CornerRadius = r or UDim.new(0.5, 0)
        cc.Parent = o
        return cc
    end

    if iconType == "crosshair" then
        for _, spec in ipairs({{0,-1},{0,1},{-1,0},{1,0}}) do
            bar(spec, spec[1] ~= 0)
        end
        local dot = Instance.new("Frame")
        dot.BackgroundColor3 = c; dot.BorderSizePixel = 0
        dot.AnchorPoint = Vector2.new(0.5,0.5)
        dot.Position = UDim2.new(0.5,0,0.5,0)
        dot.Size = UDim2.fromOffset(t+1, t+1)
        corner(dot); dot.Parent = container
    elseif iconType == "target" then
        local ring = Instance.new("Frame")
        ring.Size = UDim2.fromScale(0.75,0.75)
        ring.Position = UDim2.new(0.5,0,0.5,0)
        ring.AnchorPoint = Vector2.new(0.5,0.5)
        ring.BackgroundTransparency = 1; ring.Parent = container
        corner(ring)
        local stroke = Instance.new("UIStroke")
        stroke.Color = c; stroke.Thickness = t; stroke.Parent = ring
        local dot = Instance.new("Frame")
        dot.BackgroundColor3 = c; dot.BorderSizePixel = 0
        dot.AnchorPoint = Vector2.new(0.5,0.5)
        dot.Position = UDim2.new(0.5,0,0.5,0)
        dot.Size = UDim2.fromOffset(t+2, t+2)
        corner(dot); dot.Parent = container
    elseif iconType == "gear" then
        local ring = Instance.new("Frame")
        ring.Size = UDim2.fromScale(0.8,0.8)
        ring.Position = UDim2.new(0.5,0,0.5,0)
        ring.AnchorPoint = Vector2.new(0.5,0.5)
        ring.BackgroundTransparency = 1; ring.Parent = container
        corner(ring)
        local stroke = Instance.new("UIStroke")
        stroke.Color = c; stroke.Thickness = t; stroke.Parent = ring
        local inner = Instance.new("Frame")
        inner.Size = UDim2.fromScale(0.35,0.35)
        inner.Position = UDim2.new(0.5,0,0.5,0)
        inner.AnchorPoint = Vector2.new(0.5,0.5)
        inner.BackgroundColor3 = c; inner.BorderSizePixel = 0
        corner(inner); inner.Parent = container
    elseif iconType == "eye" then
        local oval = Instance.new("Frame")
        oval.Size = UDim2.new(0.9,0,0.5,0)
        oval.Position = UDim2.new(0.5,0,0.5,0)
        oval.AnchorPoint = Vector2.new(0.5,0.5)
        oval.BackgroundTransparency = 1; oval.Parent = container
        corner(oval)
        local stroke = Instance.new("UIStroke")
        stroke.Color = c; stroke.Thickness = t; stroke.Parent = oval
        local pupil = Instance.new("Frame")
        pupil.Size = UDim2.fromScale(0.3,0.3)
        pupil.Position = UDim2.new(0.5,0,0.5,0)
        pupil.AnchorPoint = Vector2.new(0.5,0.5)
        pupil.BackgroundColor3 = c; pupil.BorderSizePixel = 0
        corner(pupil); pupil.Parent = container
    elseif iconType == "skull" then
        local head = Instance.new("Frame")
        head.Size = UDim2.fromScale(0.6,0.5)
        head.Position = UDim2.new(0.5,0,0.35,0)
        head.AnchorPoint = Vector2.new(0.5,0.5)
        head.BackgroundColor3 = c; head.BorderSizePixel = 0
        corner(head, UDim.new(0.4,0)); head.Parent = container
        for _, xOff in ipairs({-0.15, 0.15}) do
            local eyeHole = Instance.new("Frame")
            eyeHole.Size = UDim2.fromScale(0.15,0.15)
            eyeHole.Position = UDim2.new(0.5+xOff,0,0.3,0)
            eyeHole.AnchorPoint = Vector2.new(0.5,0.5)
            eyeHole.BackgroundColor3 = Color3.new(0,0,0)
            eyeHole.BorderSizePixel = 0
            corner(eyeHole); eyeHole.Parent = container
        end
        local jaw = Instance.new("Frame")
        jaw.Size = UDim2.new(0.4,0,0.2,0)
        jaw.Position = UDim2.new(0.5,0,0.7,0)
        jaw.AnchorPoint = Vector2.new(0.5,0.5)
