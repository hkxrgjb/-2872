            main.Visible = not main.Visible
        elseif Settings.Hotkeys then
            if i.KeyCode == Enum.KeyCode.X then
                setSetting("Enabled", not Settings.Enabled)
            elseif i.KeyCode == Enum.KeyCode.Z then
                setSetting("NearestLock",
                           not Settings.NearestLock)
            elseif i.KeyCode == Enum.KeyCode.C then
                setSetting("ESP", not Settings.ESP)
            elseif i.KeyCode == Enum.KeyCode.V then
                nextTarget()
            elseif i.KeyCode == Enum.KeyCode.F then
                setSetting("Fly", not Settings.Fly)
            elseif i.KeyCode == Enum.KeyCode.G then
                toggleGhostClone()
            end
        end
    end))

    onChange("Sticky", function(v)
        if not v then setTarget(nil, nil) end
    end)

    applyStealthUI()
end)()

-- ============================================================
-- Main loop
-- ============================================================
;(function()
    local lastSelect, lastESP, lastInfo = 0, 0, 0
    local lastStats, lastDiag           = 0, 0
    local fovLocked  = false
    local lastFov    = Settings.FOV
    local infoText   = L("statusSearching")

    local function frameStep(dt, now, perf)
        local stealth = stealthActive()

        if lastFov ~= Settings.FOV then
            lastFov = Settings.FOV
            fovFrame.Size =
                UDim2.fromOffset(Settings.FOV*2, Settings.FOV*2)
        end
        local showFov = Settings.ShowFOV and Settings.Enabled
            and not stealth
            and not (Settings.NearestLock
                     or Settings.TargetScope == "Global")
        if fovFrame.Visible ~= showFov then
            fovFrame.Visible = showFov
        end
        local locked = CurrentPart ~= nil
            and Settings.Enabled and not isKilling
        if locked ~= fovLocked then
            fovLocked = locked
            fovStroke.Color = locked and C.good or C.accent
        end
        local showAim = Settings.Enabled
            and not Settings.AutoAim and not stealth
        if aimBtn.Visible ~= showAim then
            aimBtn.Visible = showAim
            if not showAim then aimHeld = false end
        end
        if not stealth then
            if now - lastESP >= (perf and 0.3 or 0.2) then
                lastESP = now
                updateESPState()
            end
            renderESP()
            updateRadar(now, perf)
            updateThreat(now)
        end
        updateWeaponProfile(now)
        Movement.frame()
        if not isKilling then runTriggerBot(now) end

        if isKilling then
            marker.Visible = false
            if KillAimPart and KillAimPart.Parent then
                smoothAimCamera(
                    getAimPosition(KillAimPart,
                        KillAimPart.AssemblyLinearVelocity
                        * 0.06, 0),
                    0.5, dt, now, false, nil)
            end
            return
        end
        if not Settings.Enabled then
            setTarget(nil, nil)
            lastAimLook = nil
            aimSpring.Initialized = false
            marker.Visible = false
            setStatus(L("statusOff"), C.idle)
            return
        end
        local active = Settings.AutoAim or aimHeld
        if now - lastSelect >= (perf and 0.1 or 0.05) then
            lastSelect = now
            if active then
                local t0 = os.clock()
                selectTarget(now)
                diag.selMs = (os.clock() - t0) * 1000
            else
                setTarget(nil, nil)
            end
        end
        if CurrentPart and (not CurrentPart.Parent
            or not CurrentTarget
            or not isAlive(CurrentTarget))
        then
            if CurrentTarget and CurrentTarget.Parent
                and not isAlive(CurrentTarget)
            then
                stats.kills = stats.kills + 1
            end
            setTarget(nil, nil)
        end
        if CurrentPart and active then
            local char = CurrentTarget.Character
            local root = getRoot(char)
            local hum  = char
                and char:FindFirstChildOfClass("Humanoid")
            local offset, drop = Vector3.zero, 0
            if root then
                trackerUpdate(aimTracker, root, now)
                offset, drop = computeLeadOffset(root, hum, now)
                diag.conf = aimTracker.rel
            end
            local aimPos = getAimPosition(CurrentPart, offset, drop)
            local base = (1 - Settings.Smoothness)
                         * Settings.Strength
            smoothAimCamera(
                aimPos, base, dt, now, true,
                aimTracker.init and aimTracker.vel or nil)
            if not lockHidden then
                tryAutoFire(now, aimPos)
            end
            if hum then
                if hitTrack.target ~= CurrentTarget then
                    hitTrack.target = CurrentTarget
                    hitTrack.hp     = hum.Health
                else
                    if hum.Health < hitTrack.hp - 0.5
                        and now - lastShot < 0.8
                    then
                        local dmg = hitTrack.hp - hum.Health
                        stats.hits   = stats.hits + 1
                        stats.damage = stats.damage + dmg
                        aiRecordHit(dmg)
                        if Settings.HitFeedback then
                            hitFlashUntil = now + 0.18
                        end
                    end
                    hitTrack.hp = hum.Health
                end
            end
            if stealth then
                marker.Visible = false
            elseif Settings.ShowMarker then
                local cam = camera()
                local v, onScr =
                    cam:WorldToViewportPoint(aimPos)
                marker.Visible = onScr and v.Z > 0
                if marker.Visible then
                    marker.Position =
                        UDim2.fromOffset(v.X, v.Y)
                    local pulse = now < hitFlashUntil
                    marker.Size = pulse
                        and UDim2.fromOffset(28, 28)
                        or  UDim2.fromOffset(14, 14)
                end
            else
                marker.Visible = false
            end
            if now - lastInfo >= 0.1 then
                lastInfo = now
                local cam  = camera()
                local dist = (CurrentPart.Position
                    - cam.CFrame.Position).Magnitude
                infoText = string.format(L("fmtLockInfo"),
                    CurrentTarget.DisplayName,
                    CurrentPart.Name,
                    math.floor(dist),
                    hum and math.floor(hum.Health) or 0)
            end
            setStatus(infoText, C.accent)
        else
            lastAimLook = nil
            aimSpring.Initialized = false
            marker.Visible = false
            if active then
                setStatus(L("statusSearching"), C.idle)
            else
                setStatus(L("statusHold"), C.idle)
            end
        end
    end

    local lastErr = 0

    local function onRender(dt)
        if not Running then return end
        local now = os.clock()
        fpsEMA = fpsEMA
            + (1 / math.max(dt, 0.001) - fpsEMA) * 0.05

        if now - lastStats >= 0.5 then
            lastStats = now
            if fpsEMA < 26 or frameMs > 6 then
                autoPerfOn = Settings.AutoPerf
            elseif fpsEMA > 42 and frameMs < 3 then
                autoPerfOn = false
            end
            if Settings.ShowStats and statsLabel
                and not stealthActive()
            then
                statsLabel.Text = string.format(
                    "%d FPS | %d ms%s",
                    math.floor(fpsEMA + 0.5),
                    math.floor(getPing() * 1000),
                    perfActive() and " | eco" or "")
            end
            if weaponInfoLabel then
                local saved = currentWeapon
                    and type(Settings.Weapons[currentWeapon])
                        == "table"
                weaponInfoLabel.Text = L("weaponLabel") .. ": "
                    .. (currentWeapon or L("none"))
                    .. (saved and "  [profile]" or "")
            end
            if trackingInfoLabel then
                if CurrentTarget and aimTracker.init then
                    trackingInfoLabel.Text = string.format(
                        L("fmtTracking"),
                        CurrentTarget.DisplayName,
                        aimTracker.vel.Magnitude,
                        diag.lead, aimTracker.rel)
                else
                    trackingInfoLabel.Text = L("trackingIdle")
                end
            end
            if aiInfoLabel then
                if Settings.AIWeaponTuning and currentWeapon then
                    local s = weaponTelemetry[currentWeapon]
                    if s and s.shots > 0 then
                        local acc = math.floor(
                            s.hits / math.max(s.shots,1) * 100)
                        local avgD = s.distN > 0
                            and (s.distSum / s.distN) or 0
                        local _, catLbl = aiCategorize(avgD)
                        aiInfoLabel.Text = string.format(
                            L("fmtAI"), currentWeapon,
                            catLbl, acc, s.shots)
                    else
                        aiInfoLabel.Text = L("aiIdle")
                    end
                else
                    aiInfoLabel.Text = L("aiIdle")
                end
            end
            if sessionInfoLabel then
                local acc = 0
                if stats.shots > 0 then
                    acc = math.min(100, math.floor(
                        stats.hits / stats.shots * 100 + 0.5))
                end
                sessionInfoLabel.Text = string.format(
                    "%d locks | %d kills | %d hits / %d shots"
                    .. " (%d%%) | %d dmg | %d errors | %d min",
                    stats.locks, stats.kills,
                    stats.hits, stats.shots, acc,
                    math.floor(stats.damage), stats.errors,
                    math.floor((now - stats.start) / 60))
            end
            if logInfoLabel then
                if #eventLog > 0 then
                    local from = math.max(1, #eventLog - 8)
                    logInfoLabel.Text =
                        table.concat(eventLog, "\n",
                                     from, #eventLog)
                else
                    logInfoLabel.Text = ""
                end
            end
        end

        if Settings.Diagnostics and diagLabel
            and not stealthActive()
            and now - lastDiag >= 0.2
        then
            lastDiag = now
            local T = aimTracker
            diagLabel.Text = string.format(
                "tgt %s  spd %.1f  acc %.1f  man %.2f"
                .. "  conf %.2f  ff %.1f deg/s\n"
                .. "lead %.3fs  drop %.2f  sel %.2fms"
                .. "  fps %d  ping %dms\n"
                .. "locks %d  kills %d  hits %d  dmg %d"
                .. "  shots %d  errors %d  frame %.2fms",
                CurrentTarget and CurrentTarget.Name or "-",
                T.vel.Magnitude, T.acc.Magnitude,
                T.man, T.rel, diag.ff,
                diag.lead, diag.drop, diag.selMs,
                math.floor(fpsEMA + 0.5),
                math.floor(getPing() * 1000),
                stats.locks, stats.kills, stats.hits,
                math.floor(stats.damage), stats.shots,
                stats.errors, frameMs)
        end

        local t0 = os.clock()
        local ok, err = pcall(frameStep, dt, now, perfActive())
        frameMs = frameMs
            + ((os.clock() - t0) * 1000 - frameMs) * 0.05
        if not ok then
            stats.errors = stats.errors + 1
        end
        if not ok and now - lastErr > 3 then
            lastErr = now
            warn("[ProAimbot] " .. tostring(err))
            toast("Error: "
                .. string.sub(tostring(err), 1, 70),
                C.bad, 3)
        end
        flushHud(now)
    end

    RunService:BindToRenderStep(
        "ProAimbot",
        Enum.RenderPriority.Camera.Value + 1,
        onRender)

    task.spawn(function()
        while Running do
            task.wait(2)
            if saveDirty then saveConfig() end
        end
    end)
end)()

-- ============================================================
-- Cleanup
-- ============================================================
cleanup = function()
    Running   = false
    isKilling = false
    pcall(function()
        RunService:UnbindFromRenderStep("ProAimbot")
    end)
    Kernel.stopAll()
    Movement.restore()
    pcall(function()
        if GhostClone.isEnabled() then
            GhostClone.disable(true)
        end
    end)
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    captures = {}
    endHazardBypass()
    if saveDirty then saveConfig() end
    pcall(destroyAllESP)
    if weaponConn then
        pcall(function() weaponConn:Disconnect() end)
    end
    pcall(function() uiLayer:Destroy()     end)
    pcall(function() hudGui:Destroy()      end)
    pcall(function() espGui:Destroy()      end)
    pcall(function() chamsFolder:Destroy() end)
    Kernel.shutdown()
    if Env.__ProAimbotCleanup == cleanup then
        Env.__ProAimbotCleanup = nil
    end
end

Env.__ProAimbotCleanup = cleanup
Kernel.startAll()
refreshLanguage()
toast(L("toastLoaded"), C.good, 2)
