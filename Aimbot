    local function createButtonRow(parent, items)
        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundTransparency = 1,
        }, parent)
        local n = #items
        for i, item in ipairs(items) do
            local btn = create("TextButton", {
                Size = UDim2.new(1/n, -4, 1, 0),
                Position = UDim2.new((i-1)/n, 2, 0, 0),
                BackgroundColor3 = item[2],
                Text = "",
                TextColor3 = C.white,
                TextSize = 13,
                Font = Enum.Font.GothamBold,
                AutoButtonColor = true,
                BorderSizePixel = 0,
            }, row)
            round(btn, 9)
            locText(btn, item[1])
            btn.MouseButton1Click:Connect(item[3])
        end
    end

    local function createCycle(parent, textKey, key, options)
        local btn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = Color3.fromRGB(45, 45, 60),
            Text = "",
            TextColor3 = C.white,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = true,
            BorderSizePixel = 0,
        }, parent)
        round(btn, 9)
        registerSearch(btn, textKey, parent)
        local function refresh(v)
            btn.Text = L(textKey) .. ": " .. tostring(v)
        end
        refresh(Settings[key])
        onChange(key, refresh)
        subscribe("languageChanged",
            function() refresh(Settings[key]) end)
        btn.MouseButton1Click:Connect(function()
            local idx = 1
            for i, o in ipairs(options) do
                if o == Settings[key] then idx = i break end
            end
            setSetting(key, options[idx % #options + 1])
        end)
    end

    local function createSlider(parent, textKey, min, max,
                                key, decimals)
        local fmt  = "%." .. decimals .. "f"
        local mult = 10 ^ decimals
        local row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 60),
            BackgroundColor3 = C.row,
            BorderSizePixel = 0,
        }, parent)
        round(row, 9)
        registerSearch(row, textKey, parent)
        local lbl = create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 22),
            Position = UDim2.new(0, 12, 0, 4),
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = C.text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        local function refreshLbl(v)
            lbl.Text = L(textKey) .. ": "
                       .. string.format(fmt, v)
        end
        local hit = create("TextButton", {
            Size = UDim2.new(1, -24, 0, 32),
            Position = UDim2.new(0, 12, 0, 24),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
        }, row)
        local bar = create("Frame", {
            Size = UDim2.new(1, 0, 0, 6),
            Position = UDim2.new(0, 0, 0.5, -3),
            BackgroundColor3 = C.bar,
            BorderSizePixel = 0,
        }, hit)
        round(bar, 3)
        local fill = create("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BorderSizePixel = 0,
        }, bar)
        bindColor(fill, "BackgroundColor3", "accent")
        round(fill, 3)
        local knob = create("Frame", {
            Size = UDim2.fromOffset(22, 22),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = C.white,
            BorderSizePixel = 0,
        }, bar)
        circle(knob)
        local function apply(v)
            local pct = math.clamp((v - min) / (max - min), 0, 1)
            fill.Size     = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            refreshLbl(v)
        end
        apply(Settings[key])
        onChange(key, apply)
        subscribe("languageChanged",
            function() apply(Settings[key]) end)
        local function setFromX(x)
            local rx = math.clamp(
                (x - bar.AbsolutePosition.X)
                / math.max(bar.AbsoluteSize.X, 1), 0, 1)
            local v = min + (max - min) * rx
            v = math.floor(v * mult + 0.5) / mult
            setSetting(key, v)
        end
        hit.InputBegan:Connect(function(i)
            if not isPointer(i) then return end
            local sx, sy = i.Position.X, i.Position.Y
            local lastX, claimed = sx, false
            beginCapture(i, function(pos, entry)
                lastX = pos.X
                if not claimed then
                    local dx = math.abs(pos.X - sx)
                    local dy = math.abs(pos.Y - sy)
                    if dy > dx and dy > 8 then
                        entry.dead = true
                    elseif dx > 6 and dx >= dy then
                        claimed = true
                        content.ScrollingEnabled = false
                        setFromX(pos.X)
                    end
                else
                    setFromX(pos.X)
                end
            end, function()
                if claimed then
                    content.ScrollingEnabled = true
                else
                    setFromX(lastX)
                end
            end)
        end)
    end

