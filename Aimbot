    slotLbl.Text = T("editSlot") .. ": " .. editSlot .. " / " .. #Settings.ChipOrder
    assignLbl.Text = T("assign") .. ": " .. id

    if visibleBtn then
        if Settings.ChipEnabled[id] ~= false then
            visibleBtn.Text = T("hide") .. " " .. id
        else
            visibleBtn.Text = T("show") .. " " .. id
        end
    end
end

