-- ============================================================
local espFolder = create("Folder", { Name = "ProAimbot_ESP" })
safeParent(espFolder)
local espObjects = {}

local function destroyESP(plr)
    local o = espObjects[plr]
    if o then
        o.hl:Destroy()
        o.bb:Destroy()
        espObjects[plr] = nil
    end
end

local function createESP(plr)
    local hl = create("Highlight", {
        Name = plr.Name, FillTransparency = 0.75, OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, espFolder)
    local bb = create("BillboardGui", {
        Name = plr.Name, AlwaysOnTop = true, Size = UDim2.fromOffset(140, 34),
        StudsOffset = Vector3.new(0, 3, 0), LightInfluence = 0,
    }, espFolder)
    local lbl = create("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
        TextSize = 12, Font = Enum.Font.GothamBold, TextColor3 = C.white,
        TextStrokeTransparency = 0.4,
    }, bb)
    espObjects[plr] = { hl = hl, bb = bb, lbl = lbl }
    return espObjects[plr]
end

local function updateESP()
    for plr in pairs(espObjects) do
        if not plr.Parent then destroyESP(plr) end
    end
    if not Settings.ESP then
        for plr in pairs(espObjects) do destroyESP(plr) end
        return
    end

    local cam = camera()
    if not cam then return end
    local camPos = cam.CFrame.Position
    refreshLosFilter()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local root = getRoot(char)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local dist = root and (root.Position - camPos).Magnitude or math.huge

            if root and hum and hum.Health > 0 and dist <= Settings.MaxDistance then
                local o = espObjects[plr] or createESP(plr)
                local head = char:FindFirstChild("Head") or root
                local color
                if plr.Team ~= nil and plr.Team == LocalPlayer.Team then
                    color = C.accent
                elseif isVisible(head) then
                    color = C.good
                else
                    color = C.bad
                end

                o.hl.Adornee = char
                o.hl.FillColor = color
                o.hl.OutlineColor = color
                o.hl.Enabled = Settings.ESPOutline

                o.bb.Adornee = head
                o.bb.Enabled = Settings.ESPNames
                o.lbl.TextColor3 = color
                o.lbl.Text = string.format("%s\n%dm  %d HP",
                    plr.DisplayName, math.floor(dist), math.floor(hum.Health))
            else
                destroyESP(plr)
            end
        end
    end
end

