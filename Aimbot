-- =====================================================================
-- ESP system
-- [FIX#1] updateESPState, renderESP are GLOBAL.
-- =====================================================================
updateESPState = nil
renderESP      = nil
do
    local espObjects = {}

    local function hidePieces(o)
        o.box.Visible     = false
        o.nameLbl.Visible = false
        o.distLbl.Visible = false
        o.hpBg.Visible    = false
        o.tracer.Visible  = false
        o.arrow.Visible   = false
    end

    local function destroyESP(plr)
        local o = espObjects[plr]
        if o then
            o.box:Destroy()
            o.nameLbl:Destroy()
            o.distLbl:Destroy()
            o.hpBg:Destroy()
            o.tracer:Destroy()
            o.arrow:Destroy()
            o.hl:Destroy()
            espObjects[plr] = nil
        end
    end

    local function newESPLabel(size)
        return create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(140, size + 2),
            Text = "",
            TextSize = size,
            Font = Enum.Font.GothamBold,
            TextColor3 = C.white,
            TextStrokeTransparency = 0.4,
            Visible = false,
        }, espGui)
    end

    local function createArrow(parent)
        local a = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(22, 22),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Visible = false,
        }, parent)
        local left = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.38, 0, 0.55, 0),
            Size = UDim2.fromOffset(10, 3),
            BackgroundColor3 = C.bad,
            BorderSizePixel = 0,
            Rotation = 45,
        }, a)
        round(left, 2)
        local right = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.62, 0, 0.55, 0),
            Size = UDim2.fromOffset(10, 3),
            BackgroundColor3 = C.bad,
            BorderSizePixel = 0,
            Rotation = -45,
        }, a)
        round(right, 2)
        return a, { left, right }
    end

    local function createESP(plr)
        local o = { show = false, color = C.good, dist = 0 }
        o.box = create("Frame", {
            Name = plr.Name,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Visible = false,
        }, espGui)
        o.stroke = outline(o.box, C.good, 1.5, 0)
        o.nameLbl = newESPLabel(12)
        o.distLbl = newESPLabel(11)
        o.hpBg = create("Frame", {
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            Visible = false,
        }, espGui)
        o.hpFill = create("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.fromScale(1, 1),
            BorderSizePixel = 0,
        }, o.hpBg)
        o.tracer = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BorderSizePixel = 0,
            Visible = false,
        }, espGui)
        o.arrow, o.arrowBars = createArrow(espGui)
        o.hl = create("Highlight", {
            Name = plr.Name,
            FillTransparency = 0.75,
            OutlineTransparency = 0,
            Enabled = false,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        }, chamsFolder)
        espObjects[plr] = o
        return o
    end

    local function espColorFor(plr, mate, visible)
        if plr.UserId == Settings.PriorityId then return C.warn end
        if isWhitelisted(plr) or isIgnored(plr) then return C.idle end
        if mate then return C.accent end
        return visible and C.good or C.bad
    end

    local function setESPHidden(o)
        o.show = false
        hidePieces(o)
        o.hl.Enabled = false
    end

    function updateESPState()
        if stealthActive() then return end
        for plr in pairs(espObjects) do
            if not plr.Parent then destroyESP(plr) end
        end
        if not Settings.ESP then
            for plr in pairs(espObjects) do destroyESP(plr) end
            return
        end
        local cam = camera()
        if not cam then return end
        local camPos = cam.CFrame.Position
        refreshLosFilter()
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                local root = getRoot(char)
                local head = char and char:FindFirstChild("Head")
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                local mate = plr.Team ~= nil and plr.Team == LocalPlayer.Team
                local dist = root and (root.Position - camPos).Magnitude or math.huge
                local ok = root and head and hum and hum.Health > 0
                    and dist <= Settings.MaxDistance
                    and (Settings.ESPTeam or not mate)
                if ok then
                    table.insert(list, {
                        plr = plr, char = char, root = root,
                        head = head, hum = hum, mate = mate, dist = dist,
                    })
                else
                    local o = espObjects[plr]
                    if o then setESPHidden(o) end
                end
            end
        end
        table.sort(list, function(a, b) return a.dist < b.dist end)
        local perf = perfActive()
        for i, e in ipairs(list) do
            local plr = e.plr
            if i > Settings.ESPMax then
                local o = espObjects[plr]
                if o then setESPHidden(o) end
            else
                local o = espObjects[plr] or createESP(plr)
                local visible = isVisible(e.head)
                if Settings.ESPVisibleOnly and not visible and not e.mate then
                    setESPHidden(o)
                else
                    o.show  = true
                    o.root  = e.root
                    o.head  = e.head
                    o.hum   = e.hum
                    o.dist  = e.dist
                    o.color = espColorFor(plr, e.mate, visible)
                    local prefix = ""
                    if plr.UserId == Settings.PriorityId then
                        prefix = L("prefixPrio")
                    elseif isWhitelisted(plr) then
                        prefix = L("prefixWhite")
                    elseif isIgnored(plr) then
                        prefix = L("prefixIgnore")
                    end
                    o.nameLbl.Text = prefix .. plr.DisplayName
                    local info = string.format("%dm", math.floor(e.dist))
                    if Settings.ESPWeapon then
                        local tool = e.char:FindFirstChildOfClass("Tool")
                        if tool then info = info .. " | " .. tool.Name end
                    end
                    o.distLbl.Text = info
                    o.hl.Adornee       = e.char
                    o.hl.FillColor     = o.color
                    o.hl.OutlineColor  = o.color
                    o.hl.Enabled       = Settings.ESPChams and not perf
                end
            end
        end
    end

    function renderESP()
        if not Settings.ESP or stealthActive() then return end
        local cam = camera()
        if not cam then return end
        local vs     = cam.ViewportSize
        local origin = Vector2.new(vs.X / 2, vs.Y)
        local tracers = Settings.ESPTracers and not perfActive()
        for _, o in pairs(espObjects) do
            local drawn = false
            if o.show and o.root.Parent and o.head.Parent
                and o.hum.Health > 0
            then
                local top = cam:WorldToViewportPoint(
                    o.head.Position
                    + Vector3.new(0, o.head.Size.Y * 0.5 + 0.25, 0))
                local bot = cam:WorldToViewportPoint(
                    o.root.Position - Vector3.new(0, 3, 0))
                local onScreen = top.Z > 0 and bot.Z > 0
                    and top.X > -40 and top.X < vs.X + 40
                    and top.Y > -60 and bot.Y < vs.Y + 60
                if onScreen then
                    drawn = true
                    o.arrow.Visible = false
                    local h  = math.max(bot.Y - top.Y, 8)
                    local w  = h * 0.55
                    local cx = (top.X + bot.X) / 2
                    local x0 = cx - w / 2
                    o.box.Visible = Settings.ESPBoxes
                    if Settings.ESPBoxes then
                        o.box.Position = UDim2.fromOffset(x0, top.Y)
                        o.box.Size     = UDim2.fromOffset(w, h)
                        o.stroke.Color = o.color
                    end
                    o.nameLbl.Visible = Settings.ESPNames
                    if Settings.ESPNames then
                        o.nameLbl.Position     = UDim2.fromOffset(cx - 70, top.Y - 16)
                        o.nameLbl.TextColor3   = o.color
                    end
                    o.distLbl.Visible = Settings.ESPNames
                    if Settings.ESPNames then
                        o.distLbl.Position     = UDim2.fromOffset(cx - 70, bot.Y + 2)
                        o.distLbl.TextColor3   = C.white
                    end
                    o.hpBg.Visible = Settings.ESPHealth
                    if Settings.ESPHealth then
                        local pct = math.clamp(
                            o.hum.Health / math.max(o.hum.MaxHealth, 1), 0, 1)
                        o.hpBg.Position = UDim2.fromOffset(x0 - 6, top.Y)
                        o.hpBg.Size     = UDim2.fromOffset(3, h)
                        o.hpFill.Size   = UDim2.fromScale(1, pct)
                        o.hpFill.BackgroundColor3 =
                            Color3.fromRGB(255,60,60):Lerp(C.good, pct)
                    end
                    o.tracer.Visible = tracers
                    if tracers then
                        local p2 = Vector2.new(cx, bot.Y)
                        local d  = p2 - origin
                        o.tracer.Size = UDim2.fromOffset(d.Magnitude, 1.5)
                        o.tracer.Position = UDim2.fromOffset(
                            (origin.X + p2.X) / 2,
                            (origin.Y + p2.Y) / 2)
                        o.tracer.Rotation =
                            math.deg(math.atan2(d.Y, d.X))
                        o.tracer.BackgroundColor3 = o.color
                    end
                end
            end
            if not drawn then
                hidePieces(o)
                if Settings.ESPArrows and o.show
                    and o.root.Parent and o.hum.Health > 0
                then
                    local cf  = cam.CFrame
                    local rel = o.root.Position - cf.Position
                    local fwd = cf.LookVector
                    local right = fwd:Cross(Vector3.new(0, 1, 0))
                    if right.Magnitude > 0.001 then
                        right = right.Unit
                        local up = right:Cross(fwd)
                        local dx, dy = rel:Dot(right), rel:Dot(up)
                        local len = math.sqrt(dx*dx + dy*dy)
                        if len > 0.001 then
                            dx = dx / len
                            dy = dy / len
                            local ex = vs.X * 0.5 - 40
                            local ey = vs.Y * 0.5 - 40
                            o.arrow.Position = UDim2.fromOffset(
                                vs.X * 0.5 + dx * ex,
                                vs.Y * 0.5 - dy * ey)
                            o.arrow.Rotation =
                                math.deg(math.atan2(dx, dy))
                            o.arrow.Visible = true
                            for _, barPart in ipairs(o.arrowBars) do
                                barPart.BackgroundColor3 = o.color
                            end
                        end
                    end
                end
            end
        end
    end

    function destroyAllESP()
        for plr in pairs(espObjects) do
            destroyESP(plr)
        end
    end
end

