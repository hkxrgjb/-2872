local function createSlider(parent, text, min, max, key, decimals)
    local fmt = "%." .. decimals .. "f"
    local mult = 10 ^ decimals

    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = C.row, BorderSizePixel = 0,
    }, parent)
    round(row, 8)

    local lbl = create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 22), Position = UDim2.new(0, 12, 0, 4),
        BackgroundTransparency = 1, Text = "", TextColor3 = C.text,
        TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    -- big touch area around the thin bar
    local hit = create("TextButton", {
        Size = UDim2.new(1, -24, 0, 32), Position = UDim2.new(0, 12, 0, 24),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, row)

    local bar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0.5, -3),
        BackgroundColor3 = C.bar, BorderSizePixel = 0,
    }, hit)
    round(bar, 3)

    local fill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0,
    }, bar)
    round(fill, 3)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = C.white, BorderSizePixel = 0,
    }, bar)
    circle(knob)

    local function apply(v)
        local pct = math.clamp((v - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        lbl.Text = text .. ": " .. string.format(fmt, v)
    end
    apply(Settings[key])
    onChange(key, apply)

    local function setFromX(x)
        local rx = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local v = min + (max - min) * rx
        v = math.floor(v * mult + 0.5) / mult
        setSetting(key, v)
    end

    local dragInput = nil
    hit.InputBegan:Connect(function(i)
        if dragInput then return end
        if i.UserInputType == Enum.UserInputType.Touch
            or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragInput = i
            content.ScrollingEnabled = false   -- no scrolling while sliding
            setFromX(i.Position.X)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(i)
        if not dragInput then return end
        if (i.UserInputType == Enum.UserInputType.Touch and i == dragInput)
            or i.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(i.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(i)
        if not dragInput then return end
        local ended
        if dragInput.UserInputType == Enum.UserInputType.Touch then
            ended = (i == dragInput)
        else
            ended = (i.UserInputType == Enum.UserInputType.MouseButton1)
        end
        if ended then
            dragInput = nil
            content.ScrollingEnabled = true
        end
    end))
end

