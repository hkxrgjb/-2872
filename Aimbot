-- ----- Threat alert: red screen border + toast when an enemy is close behind you
local threatFrame = create("Frame", {
    Name = "Threat", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
    BorderSizePixel = 0, Visible = false,
}, hudGui)
create("UIStroke", { Color = C.bad, Thickness = 6, Transparency = 0.25 }, threatFrame)
local lastThreatCheck, lastThreatToast = 0, 0

function updateThreat(now)
    if not Settings.ThreatAlert then
        if threatFrame.Visible then threatFrame.Visible = false end
        return
    end
    if now - lastThreatCheck < 0.2 then return end
    lastThreatCheck = now

    local cam = camera()
    local myRoot = getRoot(LocalPlayer.Character)
    if not cam or not myRoot then return end
    local look = cam.CFrame.LookVector
    local nearest, nearestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isValidTarget(plr) then
            local root = getRoot(plr.Character)
            if root then
                local rel = root.Position - myRoot.Position
                local d = rel.Magnitude
                if d <= Settings.AlertRange and d < nearestDist and rel:Dot(look) < 0 then
                    nearest, nearestDist = plr, d
                end
            end
        end
    end

    local on = nearest ~= nil
    if threatFrame.Visible ~= on then threatFrame.Visible = on end
    if on and now - lastThreatToast > 2.5 then
        lastThreatToast = now
        toast(string.format("⚠ %s behind you · %dm", nearest.DisplayName, math.floor(nearestDist)), C.bad, 1.6)
    end
end

