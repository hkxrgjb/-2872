local function getChar(p) return p and p.Character end
local function alive(p)
    local c = getChar(p)
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function isMate(p)
    if not S.TeamCheck then return false end
    return p.Team ~= nil and p.Team == LP.Team
end

local function hasLOS(part)
    if not S.WallCheck then return true end
    local cam = WS.CurrentCamera
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character, cam}
    local ray = WS:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rp)
    if ray then
        if ray.Instance:IsDescendantOf(part.Parent) or ray.Instance.Transparency > 0.8 then
            return true
        end
        return false
    end
    return true
end

local function getBestPart(p)
    local c = getChar(p)
    if not c then return nil, "None" end
    if S.SmartBone then
        local partsToCheck = {"Head", "UpperTorso", "Torso", "HumanoidRootPart"}
        for _, pName in ipairs(partsToCheck) do
            local part = c:FindFirstChild(pName)
            if part and hasLOS(part) then
                return part, pName
            end
        end
        return nil, "Blocked"
    else
        local part = c:FindFirstChild(S.TargetPart)
        if part and hasLOS(part) then
            return part, S.TargetPart
        end
        return nil, "Blocked"
    end
end

local function getAimPosition(part)
    if not part then return Vector3.new() end
    local pos = part.Position
    local dist = (pos - WS.CurrentCamera.CFrame.Position).Magnitude
    local offsetY = dist * S.DynamicOffset
    pos = pos + Vector3.new(0, offsetY, 0)

    if S.Prediction then
        local velocity = part.AssemblyLinearVelocity
        local t = (dist / 1500) * S.PredAmount
        pos = pos + (velocity * t)
    end
    return pos
end

local function getTarget()
    local bestTarget, bestDist = nil, S.FOV
    local center = Vector2.new(WS.CurrentCamera.ViewportSize.X/2, WS.CurrentCamera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) and not isMate(p) then
            local part = getBestPart(p)
            if part then
                local screenPos, onScreen = WS.CurrentCamera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestTarget = p
                    end
                end
            end
        end
    end
    return bestTarget
end

local function doAim(target, dt)
    if not target then return end
    local part, partName = getBestPart(target)
    if not part then return end
    TargetPartName = partName
    local cam = WS.CurrentCamera
    local aimPos = getAimPosition(part)
    if (aimPos - cam.CFrame.Position).Magnitude < 1 then return end
    local targetCFrame = CFrame.new(cam.CFrame.Position, aimPos)
    local smoothFactor = 1 - S.Smoothness
    local alpha = math.clamp(smoothFactor * S.Strength * (dt * 60), 0, 1)
    pcall(function() cam.CFrame = cam.CFrame:Lerp(targetCFrame, alpha) end)
end

local function equipWeapon()
    local myChar = LP.Character
    if not myChar then return nil end
    local tool = myChar:FindFirstChildOfClass("Tool")
    if not tool then
        local backpack = LP:FindFirstChild("Backpack")
        if backpack then
            tool = backpack:FindFirstChildOfClass("Tool")
            if tool then tool.Parent = myChar end
        end
    end
    return tool
end

local function stopKilling()
    isKilling = false
    statusBar.Text = "⏹️ Kill Stopped."
    statusBar.TextColor3 = Color3.fromRGB(255, 150, 0)
end

local function killTarget(targetPlayer)
    if isKilling or not targetPlayer or not targetPlayer.Character then return end
    local myChar = LP.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    
    isKilling = true
    local originalCFrame = myChar.HumanoidRootPart.CFrame
    local targetChar = targetPlayer.Character
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    
    statusBar.Text = "⏳ Attacking " .. targetPlayer.Name .. "..."
    statusBar.TextColor3 = Color3.fromRGB(255, 100, 100)
    
    local tool = equipWeapon()
    if not tool then
        statusBar.Text = "❌ لا يوجد سلاح في الحقيبة!"
        isKilling = false
        return
    end

    task.spawn(function()
        while isKilling do
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Health = hum.MaxHealth
            end
            for _, v in ipairs(WS:GetDescendants()) do
                if v:IsA("BasePart") then
                    if v.Color == Color3.fromRGB(255, 0, 0) or v.BrickColor == BrickColor.new("Really red") then
                        v.CanTouch = false
                        v.CanCollide = false
                    end
                end
            end
            task.wait(0.2)
        end
    end)

    local angle = 0
    local snapCam = true
    
    while targetChar and targetChar.Parent and targetHum and targetHum.Health > 0 and isKilling and alive(LP) do
        tool = equipWeapon()
        if targetChar:FindFirstChildOfClass("ForceField") then
            statusBar.Text = "🛡️ ينتظر اختفاء الدرع..."
            task.wait(0.5)
        else
            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            if not targetHRP then break end
            
            angle = angle + math.rad(15)
            local radius = 8
            local height = 7
            local newPos = targetHRP.Position + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
            
            pcall(function()
                myChar.HumanoidRootPart.CFrame = CFrame.new(newPos, targetHRP.Position)
                myChar.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
            end)

            pcall(function()
                local cam = WS.CurrentCamera
                local aimPos = getAimPosition(targetHRP)
                local targetCFrame = CFrame.new(cam.CFrame.Position, aimPos)
                if snapCam then
                    cam.CFrame = targetCFrame
                    snapCam = false
                else
                    cam.CFrame = cam.CFrame:Lerp(targetCFrame, 0.8)
                end
            end)

            if tool then
                pcall(function() tool:Activate() end)
            end
        end
        task.wait(0.05)
    end

    if myChar and myChar:FindFirstChild("HumanoidRootPart") and isKilling then
        pcall(function() myChar.HumanoidRootPart.CFrame = originalCFrame end)
        statusBar.Text = "✅ Finished killing " .. targetPlayer.Name
    end
    isKilling = false
end

