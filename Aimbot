    -- ============================================================
    -- Tap-to-lock and hotkeys
    -- ============================================================
    track(UserInputService.TouchTapInWorld:Connect(function(pos, processed)
        if processed or not Settings.TapToLock or not Running or isKilling then
            return
        end

        local cam = camera()
        if not cam then
            return
        end

        local best, bestD = nil, 80

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isAlive(plr) then
                local root = getRoot(plr.Character)
                if root then
                    local v, onScreen = cam:WorldToScreenPoint(root.Position)
                    if onScreen and v.Z > 0 then
                        local d = (Vector2.new(v.X, v.Y) - pos).Magnitude
                        if d < bestD then
                            bestD = d
                            best = plr
                        end
                    end
                end
            end
        end

        if best then
            if Settings.PriorityId == best.UserId then
                setSetting("PriorityId", 0)
                toast(T("released") .. " " .. best.DisplayName, C.idle, 1.5)
            else
                setSetting("PriorityId", best.UserId)
                toast(T("lockedOn") .. " " .. best.DisplayName, C.warn, 1.5)
            end
            refreshPlayers()
        end
    end))

    track(UserInputService.InputBegan:Connect(function(i, processed)
        if processed then
            return
        end

        if i.KeyCode == Enum.KeyCode.RightShift then
            main.Visible = not main.Visible
        elseif Settings.Hotkeys then
            if i.KeyCode == Enum.KeyCode.X then
                setSetting("Enabled", not Settings.Enabled)
            elseif i.KeyCode == Enum.KeyCode.Z then
                setSetting("NearestLock", not Settings.NearestLock)
            elseif i.KeyCode == Enum.KeyCode.C then
                setSetting("ESP", not Settings.ESP)
            elseif i.KeyCode == Enum.KeyCode.V then
                nextTarget()
            end
        end
    end))

    onChange("Sticky", function(v)
        if not v then
            setTarget(nil, nil)
        end
    end)
end)()

-- ============================================================
-- Fly update (mobile + PC)
-- ============================================================
local function updateFlyFrame()
    if Settings.Fly and not flyActive then
        startFly()
    end

    if not Settings.Fly and flyActive then
        stopFly()
    end

    if flyActive and flyBodyVel and not flyBodyVel.Parent then
        flyActive = false
    end

    if not flyActive or not flyBodyVel or not flyBodyGyro then
        return
    end

    local cam = camera()
    if not cam then
        return
    end

    local hum = getHumanoid()
    local move = hum and hum.MoveDirection or Vector3.zero
    local horizontal = Vector3.new(move.X, 0, move.Z)

    if horizontal.Magnitude > 1 then
        horizontal = horizontal.Unit
    end

    local vertical = 0

    if UserInputService:IsKeyDown(Enum.KeyCode.Space) or flyUpHeld then
        vertical = vertical + 1
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or flyDownHeld then
        vertical = vertical - 1
    end

    local dir = horizontal + Vector3.new(0, vertical, 0)
    flyBodyVel.Velocity = dir * Settings.FlySpeed
    flyBodyGyro.CFrame = cam.CFrame
end

