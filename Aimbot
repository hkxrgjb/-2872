    local origin = cam.CFrame.Position
    local result = Workspace:Raycast(origin, part.Position - origin, losParams)
    if not result then return true end
    local hit = result.Instance
    return hit:IsDescendantOf(part.Parent) or hit.Transparency > 0.8
end

