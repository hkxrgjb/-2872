-- =====================================================================
-- Menu content builder
-- [FIX#3] onChange("Language", refreshLanguage) added.
-- [FIX#7] Tab buttons 36 px / 14 px icons / 8 pt labels.
-- =====================================================================
;(function()
    local tabButtons, tabPages = {}, {}
    local currentTab = "Main"

    local function switchTab(name)
        currentTab = name
        if searchBox and searchBox.Text ~= "" then
            searchBox.Text = ""
        end
        for n, page in pairs(tabPages) do
            page.Visible = (n == name)
        end
        for n, btn in pairs(tabButtons) do
            btn.BackgroundColor3 =
                (n == name) and C.accentD or C.row
        end
        content.CanvasPosition = Vector2.zero
    end

    local TAB_DEFS = {
        { name="Main",    key="tabMain",    icon="menu",   order=1 },
        { name="Aim",     key="tabAim",     icon="target", order=2 },
        { name="Visual",  key="tabVisual",  icon="eye",    order=3 },
        { name="Move",    key="tabMove",    icon="speed",  order=4 },
        { name="Players", key="tabPlayers", icon="user",   order=5 },
        { name="Kill",    key="tabKill",    icon="skull",  order=6 },
        { name="Misc",    key="tabMisc",    icon="gear",   order=7 },
    }

    local function addTab(def)
        local btn = create("TextButton", {
            Name = def.name,
            LayoutOrder = def.order,
            Size = UDim2.new(1, 0, 0, 36),     -- [FIX#7] 48→36
            BackgroundColor3 = C.row,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
        }, tabsBar)
        round(btn, 8)
        -- [FIX#7] icon 18→14, y 16→12
        drawIcon(btn, def.icon, 14, C.text).Position =
            UDim2.new(0.5, 0, 0, 12)
        local lbl = create("TextLabel", {
            Size = UDim2.new(1, -4, 0, 14),
            Position = UDim2.new(0, 2, 1, -13),-- [FIX#7] -17→-13
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = C.text,
            TextSize = 8,                       -- [FIX#7] 9→8
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, btn)
        locText(lbl, def.key)
        tabButtons[def.name] = btn
        btn.MouseButton1Click:Connect(function()
            switchTab(def.name)
        end)
        local page = create("Frame", {
            Name = def.name,
            LayoutOrder = def.order,
            Size = UDim2.new(1, -8, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = false,
        }, content)
        create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)
        tabPages[def.name] = page
        return page
    end

    local pMain    = addTab(TAB_DEFS[1])
    local pAim     = addTab(TAB_DEFS[2])
    local pVisual  = addTab(TAB_DEFS[3])
    local pMove    = addTab(TAB_DEFS[4])
    local pPlayers = addTab(TAB_DEFS[5])
    local pKill    = addTab(TAB_DEFS[6])
    local pMisc    = addTab(TAB_DEFS[7])

    local function applyTheme(name)
        local t = THEMES[name] or THEMES.Blue
        C.accent, C.accentD = t[1], t[2]
        for _, b in ipairs(themed) do
            if b.obj.Parent then b.obj[b.prop] = C[b.key] end
        end
        for n, btn in pairs(tabButtons) do
            btn.BackgroundColor3 =
                (n == currentTab) and C.accentD or C.row
        end
        statusColor = C.accent
        statusDirty = true
    end
    onChange("Theme", applyTheme)

    local searchItems, sections, sectionByBody = {}, {}, {}

    local function registerSearch(row, textKey, parent)
        local item = { row = row, key = textKey }
        table.insert(searchItems, item)
        local sec = sectionByBody[parent]
        if sec then table.insert(sec.items, item) end
    end

    local function runSearch(query)
        query = string.lower(query or "")
        if query == "" then
            for _, it in ipairs(searchItems) do
                it.row.Visible = true
            end
            for _, sec in ipairs(sections) do
                sec.wrap.Visible  = true
                sec.body.Visible  = sec.expanded
                sec.arrow.Text    = sec.expanded and "v" or ">"
            end
            for n, page in pairs(tabPages) do
                page.Visible = (n == currentTab)
            end
            content.CanvasPosition = Vector2.zero
            return
        end
        for _, it in ipairs(searchItems) do
            it.row.Visible =
                string.find(string.lower(L(it.key)), query, 1, true)
                ~= nil
        end
        for _, sec in ipairs(sections) do
            local found = false
            for _, it in ipairs(sec.items) do
                if it.row.Visible then found = true break end
            end
            sec.wrap.Visible = found
            sec.body.Visible = found
            sec.arrow.Text   = "v"
        end
        for n, page in pairs(tabPages) do
            page.Visible = (n ~= "Players")
        end
    end

    track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        runSearch(searchBox.Text)
    end))

    subscribe("languageChanged", function()
        searchBox.PlaceholderText = L("search")
        if searchBox.Text ~= "" then runSearch(searchBox.Text) end
    end)

    -- Section factory
    local function createSection(parent, titleKey, iconType,
                                 expanded, sectionKey)
        local wrap = create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
        }, parent)
        create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, wrap)
        local head = create("TextButton", {
            LayoutOrder = 0,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = C.head,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
        }, wrap)
        round(head, 9)
        local iconHolder = create("Frame", {
            Size = UDim2.fromOffset(22, 22),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 10, 0.5, 0),
            BackgroundTransparency = 1,
        }, head)
        drawIcon(iconHolder, iconType or "gear", 20, C.accent)
        local label = create("TextLabel", {
            Size = UDim2.new(1, -114, 1, 0),
            Position = UDim2.new(0, 38, 0, 0),
            BackgroundTransparency = 1,
            Text = "",
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, head)
        locText(label, titleKey)
        bindColor(label, "TextColor3", "accent")
        table.insert(secIconRegs,
            { icon = iconHolder, label = label })
        local arrow = create("TextLabel", {
            Size = UDim2.fromOffset(24, 34),
            Position = UDim2.new(1, -28, 0, 0),
            BackgroundTransparency = 1,
            Text = expanded and "v" or ">",
            TextColor3 = C.idle,
            TextSize = 14,
            Font = Enum.Font.GothamBold,
        }, head)
        if sectionKey and SECTION_KEYS[sectionKey] then
            local resetBtn = create("TextButton", {
                Size = UDim2.fromOffset(26, 26),
                Position = UDim2.new(1, -58, 0.5, -13),
                BackgroundColor3 = C.row,
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
            }, head)
            round(resetBtn, 8)
            outline(resetBtn, C.warn, 1, 0.55)
            drawIcon(resetBtn, "reset", 14, C.warn)
            resetBtn.MouseButton1Click:Connect(function()
                confirmDialog(
                    L("confirmReset"),
                    function()
                        resetSection(sectionKey)
                        toast(string.format(L("fmtReset"),
                            L(titleKey)), C.warn, 1.8)
                    end, true)
            end)
        end
        local body = create("Frame", {
            LayoutOrder = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = expanded,
        }, wrap)
        create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, body)
        local sec = {
            wrap = wrap, body = body, arrow = arrow,
            expanded = expanded, items = {},
        }
        table.insert(sections, sec)
        sectionByBody[body] = sec
        head.MouseButton1Click:Connect(function()
            if searchBox.Text ~= "" then return end
            body.Visible  = not body.Visible
            sec.expanded  = body.Visible
            arrow.Text    = body.Visible and "v" or ">"
        end)
        return body
    end

    local function createToggle(parent, textKey, key)
        local row = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = C.row,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
        }, parent)
        round(row, 9)
        registerSearch(row, textKey, parent)
        local lbl = create("TextLabel", {
            Size = UDim2.new(1, -70, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = C.text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
        locText(lbl, textKey)
        local sw = create("Frame", {
            Size = UDim2.fromOffset(46, 24),
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0),
            BorderSizePixel = 0,
        }, row)
        circle(sw)
        local knob = create("Frame", {
            Size = UDim2.fromOffset(18, 18),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = C.white,
            BorderSizePixel = 0,
        }, sw)
        circle(knob)
        local function apply(state, anim)
            local gc = state and C.good or C.bar
            local gp = state
                and UDim2.new(1, -21, 0.5, 0)
                or  UDim2.new(0, 3, 0.5, 0)
            if anim then
                TweenService:Create(sw,
                    TweenInfo.new(0.15),
                    { BackgroundColor3 = gc }):Play()
                TweenService:Create(knob,
                    TweenInfo.new(0.15),
                    { Position = gp }):Play()
            else
                sw.BackgroundColor3 = gc
                knob.Position = gp
            end
        end
        apply(Settings[key], false)
        onChange(key, function(v) apply(v, true) end)
        row.MouseButton1Click:Connect(function()
            setSetting(key, not Settings[key])
        end)
    end

