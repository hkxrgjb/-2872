    local id = Settings.ChipOrder[editSlot]
    if id then
        Settings.ChipEnabled[id] = not Settings.ChipEnabled[id]
        saveDirty = true
        refreshChipEditor()
        if rebuildChips then
            rebuildChips()
        end
    end
end)

ceCreateButton(ceContent, "assign", Color3.fromRGB(45, 45, 60), function()
    local current = Settings.ChipOrder[editSlot]
    if not current then
        return
    end

    local idx = 1
    for i, id in ipairs(CHIP_IDS) do
        if id == current then
            idx = i
            break
        end
    end

    local nextId = CHIP_IDS[idx % #CHIP_IDS + 1]

    local existingSlot
    for i, id in ipairs(Settings.ChipOrder) do
        if id == nextId then
            existingSlot = i
            break
        end
    end

    if existingSlot and existingSlot ~= editSlot then
        Settings.ChipOrder[existingSlot] = current
    end

    Settings.ChipOrder[editSlot] = nextId
    saveDirty = true
    refreshChipEditor()

    if rebuildChips then
        rebuildChips()
    end
end)

ceCreateButtonRow(ceContent, {
    { "up", Color3.fromRGB(60, 90, 170), function()
        local i = math.clamp(editSlot, 1, #Settings.ChipOrder)
        local j = i - 1
        if j >= 1 then
            Settings.ChipOrder[i], Settings.ChipOrder[j] = Settings.ChipOrder[j], Settings.ChipOrder[i]
            editSlot = j
            saveDirty = true
            refreshChipEditor()
            if rebuildChips then
                rebuildChips()
            end
        end
    end },
    { "down", Color3.fromRGB(60, 90, 170), function()
        local i = math.clamp(editSlot, 1, #Settings.ChipOrder)
        local j = i + 1
        if j <= #Settings.ChipOrder then
            Settings.ChipOrder[i], Settings.ChipOrder[j] = Settings.ChipOrder[j], Settings.ChipOrder[i]
            editSlot = j
            saveDirty = true
            refreshChipEditor()
            if rebuildChips then
                rebuildChips()
            end
        end
    end },
})

ceCreateButtonRow(ceContent, {
    { "addSlot", Color3.fromRGB(0, 120, 90), function()
        if #Settings.ChipOrder >= 8 then
            return
        end

        local present = {}
        for _, id in ipairs(Settings.ChipOrder) do
            present[id] = true
        end

        for _, id in ipairs(CHIP_IDS) do
            if not present[id] then
                table.insert(Settings.ChipOrder, id)
                editSlot = #Settings.ChipOrder
                saveDirty = true
                refreshChipEditor()
                if rebuildChips then
                    rebuildChips()
                end
                return
            end
        end
    end },
    { "removeSlot", Color3.fromRGB(150, 70, 50), function()
        if #Settings.ChipOrder > 1 then
