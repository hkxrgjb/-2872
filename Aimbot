        friendCache[plr.UserId] = false
        task.spawn(function()
            local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(plr.UserId) end)
            if ok then friendCache[plr.UserId] = res end
        end)
        return false
    end
    return v
end

local whitelistMap = {}
local function rebuildWhitelist()
    whitelistMap = {}
    for _, id in ipairs(Settings.Whitelist) do whitelistMap[id] = true end
end
rebuildWhitelist()

local function isWhitelisted(plr)
    return whitelistMap[plr.UserId] == true
end

local function toggleWhitelist(plr)
    if whitelistMap[plr.UserId] then
        for i, id in ipairs(Settings.Whitelist) do
            if id == plr.UserId then table.remove(Settings.Whitelist, i) break end
        end
    else
        table.insert(Settings.Whitelist, plr.UserId)
    end
    rebuildWhitelist()
    saveDirty = true
end

local function isValidTarget(plr)
    return plr ~= nil and plr ~= LocalPlayer and plr.Parent ~= nil
        and isAlive(plr) and not isMate(plr) and not isWhitelisted(plr)
        and not (Settings.IgnoreFriends and isFriend(plr))
end

-- ============================================================
-- Network latency
-- ============================================================
local cachedPing, lastPingCheck = 0.08, 0
local function getPing()
    local now = os.clock()
    if now - lastPingCheck < 0.5 then return cachedPing end
    lastPingCheck = now
    pcall(function()
        local Stats = game:GetService("Stats")
        local item = Stats.Network and Stats.Network.ServerStatsItem
            and Stats.Network.ServerStatsItem["Data Ping"]
        if item then
            local v = item:GetValue()
            if v and v > 5 then cachedPing = math.clamp(v / 1000, 0.02, 0.4) end
        end
    end)
    return cachedPing
end

-- ============================================================
-- Line of sight
-- ============================================================
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.RespectCanCollide = true
losParams.IgnoreWater = true

local function refreshLosFilter()
    local list = {}
    if LocalPlayer.Character then table.insert(list, LocalPlayer.Character) end
    local cam = camera()
    if cam then table.insert(list, cam) end
    losParams.FilterDescendantsInstances = list
end

local function isVisible(part)
    local cam = camera()
    if not cam then return true end
    local origin = cam.CFrame.Position
    local result = Workspace:Raycast(origin, part.Position - origin, losParams)
    if not result then return true end
    local hit = result.Instance
    return hit:IsDescendantOf(part.Parent) or hit.Transparency > 0.8
end

local function hasLineOfSight(part)
    if not Settings.WallCheck then return true end
    return isVisible(part)
end

-- ============================================================
-- Bone selection
-- ============================================================
local function resolveBone(char, name)
    if name == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild(name)
end

local BONE_ORDER_NEAR = {"Head", "UpperTorso", "Torso", "HumanoidRootPart"}
local BONE_ORDER_FAR = {"UpperTorso", "Torso", "Head", "HumanoidRootPart"}

local function getBestPart(plr)
    local char = plr and plr.Character
    if not char then return nil end
    if Settings.SmartBone then
        local order = BONE_ORDER_NEAR
        local limit = Settings.AutoBoneDistance
        if limit > 0 then
            local root = char:FindFirstChild("HumanoidRootPart")
            local cam = camera()
            if root and cam and (root.Position - cam.CFrame.Position).Magnitude > limit then
                order = BONE_ORDER_FAR
            end
        end
        for _, name in ipairs(order) do
            local p = char:FindFirstChild(name)
            if p and hasLineOfSight(p) then return p end
        end
        return nil
    end
    local p = resolveBone(char, Settings.TargetPart)
    if p and hasLineOfSight(p) then return p end
    return nil
end

