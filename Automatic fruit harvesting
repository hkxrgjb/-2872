-- Logic
-- =====================

local currentDelay = 0.1

local function updateSpeedLabel()
    SpeedLabel.Text = string.format("السرعة: %.2fs", currentDelay)
    _G.HerbFarmDelay = currentDelay
end
updateSpeedLabel()

MinusBtn.MouseButton1Click:Connect(function()
    currentDelay = math.max(0.01, math.floor((currentDelay - 0.01) * 100 + 0.5) / 100)
    updateSpeedLabel()
end)
PlusBtn.MouseButton1Click:Connect(function()
    currentDelay = math.min(2.0, math.floor((currentDelay + 0.01) * 100 + 0.5) / 100)
    updateSpeedLabel()
end)

local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    ContentFrame.Visible = not isMinimized
    MainFrame.Size = isMinimized
        and UDim2.new(0, 240, 0, 32)
        or  UDim2.new(0, 240, 0, 185)
    MinimizeBtn.Text = isMinimized and "□" or "–"
end)

local function getPosition(target)
    if not target then return nil end
    if target:IsA("BasePart") then return target.Position end
    if target:IsA("Model") then return target:GetPivot().Position end
    if target:IsA("Attachment") then return target.WorldPosition end
    return nil
end

task.spawn(function()
    while true do
        local herbsFolder = Workspace:FindFirstChild("Herbs")
        if herbsFolder then
            local count = 0
            for _, item in ipairs(herbsFolder:GetDescendants()) do
                if item:IsA("ProximityPrompt") and item.Enabled then
                    count += 1
                end
            end
            StatusLabel.Text = "الأعشاب: " .. count
        else
            StatusLabel.Text = "الأعشاب: --"
        end
        task.wait(0.5)
    end
end)

local function calcFireCount(delay)
    if delay >= 0.15 then return 8
    elseif delay >= 0.10 then return 10
    elseif delay >= 0.05 then return 15
    else return 20
    end
end

local function fireWave(prompt, totalCount)
    if not fireproximityprompt then return end
    local interval = 0.05
    task.spawn(function()
        for i = 1, totalCount do
            if not (prompt and prompt.Parent and prompt.Enabled) then break end
            fireproximityprompt(prompt)
            task.wait(interval)
        end
    end)
end

local isRunning = false
local farmTask  = nil

local function stopFarm()
    isRunning = false
    if farmTask then
        task.cancel(farmTask)
        farmTask = nil
    end
    ToggleBtn.Text = "الفارم القريب: معطل ❌"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    FireLabel.Text = "طلبات/عشبة: --"
end

local function startFarm()
    if isRunning then return end
    isRunning = true
    ToggleBtn.Text = "الفارم القريب: شغال ✅"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)

    farmTask = task.spawn(function()
        while isRunning do
            local herbsFolder = Workspace:FindFirstChild("Herbs")

            if not herbsFolder or not RootPart or not RootPart.Parent then
                task.wait(0.2)
                continue
            end

            local activeItems = {}
            for _, item in ipairs(herbsFolder:GetDescendants()) do
                if item:IsA("ProximityPrompt") and item.Enabled then
                    local pos = getPosition(item.Parent)
                    if pos then
                        table.insert(activeItems, { Prompt = item, Pos = pos })
                    end
                end
            end

            if #activeItems == 0 then
                task.wait(0.1)
                continue
            end

            local currentPos = RootPart.Position
            table.sort(activeItems, function(a, b)
                return (a.Pos - currentPos).Magnitude < (b.Pos - currentPos).Magnitude
            end)

            local useWave = currentDelay <= 0.1

            if useWave then
                local fireCount = calcFireCount(currentDelay)
                FireLabel.Text = "🔥 موجة: " .. fireCount .. " طلب"
            else
                FireLabel.Text = "⚡ كلاسيك"
            end

            for i, data in ipairs(activeItems) do
                if not isRunning then break end

                local prompt    = data.Prompt
                local targetPos = data.Pos

                if not (prompt and prompt.Parent and prompt.Enabled) then continue end
                if not (RootPart and RootPart.Parent) then break end

                for j = i + 1, math.min(i + 5, #activeItems) do
                    local futurePos = activeItems[j].Pos
                    task.spawn(function()
                        pcall(function()
                            LocalPlayer:RequestStreamAroundAsync(futurePos, 2)
                        end)
                    end)
                end

                if useWave then
                    fireWave(prompt, calcFireCount(currentDelay))
                    RootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 1.5, 0))
                    prompt.HoldDuration = 0
                    if currentDelay > 0 and isRunning then
                        task.wait(currentDelay)
                    end
                else
                    RootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 1.5, 0))
                    prompt.HoldDuration = 0
                    local timer = 0
                    while isRunning and prompt and prompt.Parent and prompt.Enabled and timer < currentDelay do
                        if fireproximityprompt then
                            fireproximityprompt(prompt)
                        end
                        timer = timer + 0.03
                        task.wait(0.03)
                    end
                end
            end
        end
    end)
end

CloseBtn.MouseButton1Click:Connect(function()
    stopFarm()
    ScreenGui:Destroy()
end)

ToggleBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopFarm()
    else
        startFarm()
    end
end)

